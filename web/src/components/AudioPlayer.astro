---
interface Props {
  surah: number;
  ayah: number;
  surahTotalAyat: number;
  bnText?: string;
  enText?: string;
}

const { surah, ayah, surahTotalAyat, bnText = "", enText = "" } = Astro.props;
const sStr = String(surah).padStart(3, "0");
const aStr = String(ayah).padStart(3, "0");
const defaultAudioUrl = `https://everyayah.com/data/Alafasy_64kbps/${sStr}${aStr}.mp3`;
const englishAudioUrl = `https://everyayah.com/data/Ibrahim_Walk_192kbps/${sStr}${aStr}.mp3`;
---

<div class="audio-player-container card" style="display: flex; flex-direction: column; gap: 1rem; padding: 1.25rem; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md);">
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
    <div style="display: flex; align-items: center; gap: 1rem;">
      <button id="audio-play-btn" class="play-btn" aria-label="Play recitation">
        <span id="play-icon" aria-hidden="true">
          <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4" fill="currentColor"></polygon></svg>
        </span>
      </button>
      <div>
        <div id="playing-status" style="font-weight: 700; font-size: 0.95rem; color: var(--text-main);">
          Recitation: Mishary Rashid Alafasy
        </div>
        <div id="playing-substatus" style="font-size: 0.8rem; color: var(--text-muted);">
          EveryAyah stream · Verse {surah}:{ayah}
        </div>
      </div>
    </div>

    <!-- Reciter & Mode Controls -->
    <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
      <select id="reciter-select" class="form-select" aria-label="Select Reciter" style="padding: 0.45rem 0.65rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-main); font-size: 0.85rem; min-height: 38px;">
        <option value="Alafasy_64kbps">Mishary Alafasy</option>
        <option value="Husary_128kbps">Mahmoud Al-Husary</option>
        <option value="Husary_Muallim_128kbps">Al-Husary (Teacher)</option>
        <option value="Minshawy_Murattal_128kbps">Mohamed El-Minshawi</option>
        <option value="Abdurrahmaan_As-Sudais_192kbps">Abdur-Rahman As-Sudais</option>
      </select>

      <select id="mode-select" class="form-select" aria-label="Select Playback Mode" style="padding: 0.45rem 0.65rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-main); font-size: 0.85rem; min-height: 38px;">
        <option value="ar-only">Arabic Only</option>
        <option value="ar-en">Arabic + English</option>
        <option value="ar-bn">Arabic + Bangla</option>
      </select>

      <button id="speed-btn" class="btn-action btn-action-sm" title="Playback Speed" aria-label="Playback speed" style="min-width: 44px; font-weight: 700;">1x</button>
      <button id="loop-btn" class="btn-action btn-action-sm" title="Repeat this verse" aria-label="Repeat this verse">
        <svg class="icon-svg" viewBox="0 0 24 24"><polyline points="17 1 21 5 17 9"></polyline><path d="M3 11V9a4 4 0 0 1 4-4h14"></path><polyline points="7 23 3 19 7 15"></polyline><path d="M21 13v2a4 4 0 0 1-4 4H3"></path></svg>
        <span id="loop-btn-label">Repeat: Off</span>
      </button>
      <button id="autonext-btn" class="btn-action btn-action-sm" title="Auto-advance to next verse" aria-label="Auto-advance to next verse">
        <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="5 4 15 12 5 20 5 4" fill="currentColor"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
        <span id="autonext-btn-label">Auto-next: Off</span>
      </button>
    </div>
  </div>

  <!-- Progress bar -->
  <div style="width: 100%; height: 8px; background: var(--bg-subtle); border-radius: 9999px; overflow: hidden; cursor: pointer;" id="progress-container" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Audio playback progress">
    <div id="audio-progress" style="width: 0%; height: 100%; background: var(--accent-teal); transition: width 0.1s linear;"></div>
  </div>

  <audio id="ayah-audio" preload="none" src={defaultAudioUrl}></audio>
  <audio id="en-audio" preload="none" src={englishAudioUrl}></audio>
  <audio id="bn-audio" preload="none"></audio>
</div>

<style>
  .play-btn {
    width: 3rem;
    height: 3rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    background: var(--accent-teal);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .play-btn:hover {
    background: var(--accent-teal-hover);
    transform: scale(1.05);
  }
  .form-select {
    padding: 0.45rem 0.75rem;
    min-height: 44px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
    color: var(--text-main);
    font-size: 0.85rem;
    cursor: pointer;
    outline: none;
  }
  .form-select:focus {
    border-color: var(--accent-teal);
  }
</style>

<script is:inline define:vars={{ surah, ayah, surahTotalAyat, bnText, sStr, aStr }}>
  const audio = document.getElementById("ayah-audio");
  const enAudio = document.getElementById("en-audio");
  const bnAudio = document.getElementById("bn-audio");
  const playBtn = document.getElementById("audio-play-btn");
  const playIcon = document.getElementById("play-icon");
  const progress = document.getElementById("audio-progress");
  const progressContainer = document.getElementById("progress-container");
  const speedBtn = document.getElementById("speed-btn");
  const loopBtn = document.getElementById("loop-btn");
  const autonextBtn = document.getElementById("autonext-btn");
  const reciterSelect = document.getElementById("reciter-select");
  const modeSelect = document.getElementById("mode-select");
  const statusEl = document.getElementById("playing-status");
  const substatusEl = document.getElementById("playing-substatus");

  const PLAY_ICON_SVG = '<svg class="icon-svg" viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4" fill="currentColor"></polygon></svg>';
  const PAUSE_ICON_SVG = '<svg class="icon-svg" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor"></rect><rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor"></rect></svg>';

  function updatePlayIcon(playing) {
    if (playIcon) playIcon.innerHTML = playing ? PAUSE_ICON_SVG : PLAY_ICON_SVG;
  }

  // CDN Candidates & Mirror Resilience
  function getArabicCandidates(reciter) {
    const list = [
      `https://everyayah.com/data/${reciter}/${sStr}${aStr}.mp3`,
      `https://media.everyayah.com/data/${reciter}/${sStr}${aStr}.mp3`
    ];
    if (reciter !== "Alafasy_64kbps") {
      list.push(`https://everyayah.com/data/Alafasy_64kbps/${sStr}${aStr}.mp3`);
      list.push(`https://media.everyayah.com/data/Alafasy_64kbps/${sStr}${aStr}.mp3`);
    }
    return list;
  }

  function getEnglishCandidates() {
    return [
      `https://everyayah.com/data/Ibrahim_Walk_192kbps/${sStr}${aStr}.mp3`,
      `https://media.everyayah.com/data/Ibrahim_Walk_192kbps/${sStr}${aStr}.mp3`
    ];
  }

  let arabicCandidates = getArabicCandidates(reciterSelect ? reciterSelect.value : "Alafasy_64kbps");
  let arabicIdx = 0;
  let englishCandidates = getEnglishCandidates();
  let englishIdx = 0;

  let isPlaying = false;
  let isPlayPending = false;
  let isLooping = false;
  let isAutoNext = localStorage.getItem("qg_autonext") === "true";
  const speeds = [0.75, 1.0, 1.25, 1.5];
  let speedIdx = 1;
  let activeAudio = audio;
  let bnAlignments = null;
  let bnAlignmentsFetched = false;
  let bnTimer = null;

  async function loadBnAlignment() {
    if (bnAlignmentsFetched) return bnAlignments;
    bnAlignmentsFetched = true;
    try {
      const res = await fetch(`/audio/bn/${sStr}.json`);
      if (res.ok) {
        bnAlignments = await res.json();
      }
    } catch (e) {
      bnAlignments = null;
    }
    return bnAlignments;
  }

  // Safe Play and Pause Locking
  function safePlay(audioEl) {
    if (!audioEl) return Promise.resolve();
    isPlaying = true;
    isPlayPending = true;
    updatePlayIcon(true);

    const playPromise = audioEl.play();
    if (playPromise !== undefined) {
      return playPromise
        .then(() => {
          isPlayPending = false;
          if (!isPlaying) {
            audioEl.pause();
            updatePlayIcon(false);
          }
        })
        .catch((err) => {
          isPlayPending = false;
          if (err && err.name === "AbortError") {
            return;
          }
          console.warn("Audio playback interrupted or denied:", err);
          if (isPlaying) {
            isPlaying = false;
            updatePlayIcon(false);
          }
        });
    } else {
      isPlayPending = false;
      return Promise.resolve();
    }
  }

  function safePause() {
    isPlaying = false;
    updatePlayIcon(false);
    if (audio && !audio.paused) audio.pause();
    if (enAudio && !enAudio.paused) enAudio.pause();
    if (bnAudio && !bnAudio.paused) {
      bnAudio.pause();
      if (bnTimer) {
        clearInterval(bnTimer);
        bnTimer = null;
      }
    }
    if ('speechSynthesis' in window) window.speechSynthesis.pause();
  }

  // Restore saved reciter and mode
  const savedReciter = localStorage.getItem("qg_reciter");
  if (savedReciter && reciterSelect) {
    reciterSelect.value = savedReciter;
  }
  const savedMode = localStorage.getItem("qg_audiomode");
  if (savedMode && modeSelect) {
    modeSelect.value = savedMode;
  }

  if (autonextBtn) {
    autonextBtn.textContent = isAutoNext ? "⏭ Auto: On" : "⏭ Auto: Off";
    if (isAutoNext) autonextBtn.style.color = "var(--accent-teal)";
  }

  function updateReciter() {
    const reciter = reciterSelect ? reciterSelect.value : "Alafasy_64kbps";
    arabicCandidates = getArabicCandidates(reciter);
    arabicIdx = 0;
    const wasPlaying = isPlaying;
    audio.src = arabicCandidates[0];
    if (statusEl && reciterSelect) {
      statusEl.textContent = "Recitation: " + reciterSelect.options[reciterSelect.selectedIndex].text;
    }
    if (wasPlaying && activeAudio === audio) {
      safePlay(audio);
    }
  }

  // Set initial reciter source if customized
  if (savedReciter && savedReciter !== "Alafasy_64kbps") {
    updateReciter();
  }

  reciterSelect?.addEventListener("change", () => {
    localStorage.setItem("qg_reciter", reciterSelect.value);
    updateReciter();
  });

  modeSelect?.addEventListener("change", () => {
    localStorage.setItem("qg_audiomode", modeSelect.value);
  });

  // Arabic Audio Error Listener with Mirror Retry
  audio.addEventListener("error", () => {
    console.warn(`Arabic audio load failed on: ${audio.src}`);
    if (arabicIdx + 1 < arabicCandidates.length) {
      arabicIdx++;
      console.info(`Retrying on fallback candidate (${arabicIdx + 1}/${arabicCandidates.length}): ${arabicCandidates[arabicIdx]}`);
      audio.src = arabicCandidates[arabicIdx];
      if (isPlaying && activeAudio === audio) {
        safePlay(audio);
      }
    } else {
      console.error(`All audio mirrors failed for verse ${surah}:${ayah}`);
      safePause();
      if (progress) {
        progress.style.width = "0%";
        progressContainer?.setAttribute("aria-valuenow", "0");
      }
      if (substatusEl) substatusEl.textContent = "Audio stream unavailable";
      if (typeof window.showQgToast === "function") {
        window.showQgToast(`Audio for verse ${surah}:${ayah} is temporarily unavailable`);
      }
    }
  });

  // English Audio Error Listener with Mirror Retry
  enAudio?.addEventListener("error", () => {
    console.warn(`English audio load failed on: ${enAudio.src}`);
    if (englishIdx + 1 < englishCandidates.length) {
      englishIdx++;
      enAudio.src = englishCandidates[englishIdx];
      if (isPlaying && activeAudio === enAudio) {
        safePlay(enAudio);
      }
    } else {
      console.warn("English recitation mirrors failed, finishing ayah.");
      if (typeof window.showQgToast === "function") {
        window.showQgToast("English audio unavailable");
      }
      finishAyah();
    }
  });

  // Bangla Neural Audio Error Listener
  bnAudio?.addEventListener("error", () => {
    console.warn("Bangla neural audio failed, falling back to browser speech synthesis");
    if (activeAudio === bnAudio) {
      fallbackSpeechSynthesis(() => finishAyah());
    }
  });

  let bnStartSec = 0;
  let bnDurationSec = 0;

  async function playBanglaSpeech(onEnd) {
    const alignData = await loadBnAlignment();
    const item = alignData?.ayat?.find(a => a.ayah === ayah);

    if (item && bnAudio) {
      if (bnTimer) {
        clearInterval(bnTimer);
        bnTimer = null;
      }
      activeAudio = bnAudio;
      const targetSrc = `/audio/bn/${sStr}.mp3`;
      const needsSrcChange = !bnAudio.src.endsWith(targetSrc);
      if (needsSrcChange) {
        bnAudio.src = targetSrc;
      }
      bnAudio.playbackRate = speeds[speedIdx];
      bnStartSec = item.start_ms / 1000;
      bnDurationSec = item.duration_ms / 1000;
      const endSec = item.end_ms / 1000;

      if (substatusEl) substatusEl.textContent = "Playing Bangla: Neural Studio Voice";

      const startPlayback = () => {
        try {
          bnAudio.currentTime = bnStartSec;
        } catch (e) {
          console.warn("Error seeking bnAudio:", e);
        }
        safePlay(bnAudio).catch(e => {
          console.warn("Bn audio play error:", e);
          fallbackSpeechSynthesis(onEnd);
        });

        if (bnTimer) clearInterval(bnTimer);
        bnTimer = setInterval(() => {
          if (bnAudio.currentTime >= endSec || bnAudio.ended) {
            clearInterval(bnTimer);
            bnTimer = null;
            bnAudio.pause();
            onEnd();
          }
        }, 100);
      };

      // Safely ensure metadata is loaded before seeking
      if (bnAudio.readyState >= 1) { // HAVE_METADATA or higher
        startPlayback();
      } else {
        const onMeta = () => {
          bnAudio.removeEventListener("loadedmetadata", onMeta);
          startPlayback();
        };
        bnAudio.addEventListener("loadedmetadata", onMeta, { once: true });
        if (needsSrcChange) {
          bnAudio.load();
        }
      }
      return;
    }

    fallbackSpeechSynthesis(onEnd);
  }

  function fallbackSpeechSynthesis(onEnd) {
    if (!('speechSynthesis' in window) || !bnText) {
      onEnd();
      return;
    }
    window.speechSynthesis.cancel();
    const cleanBn = bnText.replace(/\[[০-৯0-9]+\]/g, '').replace(/[‘'"]/g, '').trim();
    const utterance = new SpeechSynthesisUtterance(cleanBn);
    utterance.lang = "bn-BD";
    utterance.rate = speeds[speedIdx];
    
    const voices = window.speechSynthesis.getVoices();
    const bnVoice = voices.find(v => v.lang.startsWith("bn") || v.lang.includes("Bengali"));
    if (bnVoice) utterance.voice = bnVoice;

    if (substatusEl) substatusEl.textContent = "Playing Bangla Translation (Browser)";
    isPlaying = true;
    updatePlayIcon(true);

    utterance.onend = () => {
      onEnd();
    };
    utterance.onerror = () => {
      onEnd();
    };
    window.speechSynthesis.speak(utterance);
  }

  function handlePlaybackEnd() {
    const mode = modeSelect ? modeSelect.value : "ar-only";

    if (mode === "ar-en" && activeAudio === audio) {
      activeAudio = enAudio;
      if (substatusEl) substatusEl.textContent = "Playing English: Ibrahim Walk";
      enAudio.currentTime = 0;
      safePlay(enAudio);
      return;
    }

    if (mode === "ar-bn" && activeAudio === audio) {
      playBanglaSpeech(() => {
        finishAyah();
      });
      return;
    }

    finishAyah();
  }

  function finishAyah() {
    activeAudio = audio;
    if (substatusEl) substatusEl.textContent = `EveryAyah stream · Verse ${surah}:${ayah}`;

    if (isLooping) {
      audio.currentTime = 0;
      safePlay(audio);
    } else if (isAutoNext && ayah < surahTotalAyat) {
      window.location.href = `/ayah/${surah}/${ayah + 1}?autoplay=1`;
    } else {
      isPlaying = false;
      updatePlayIcon(false);
      if (progress) {
        progress.style.width = "0%";
        progressContainer?.setAttribute("aria-valuenow", "0");
      }
    }
  }

  if (audio && playBtn) {
    playBtn.addEventListener("click", () => {
      const isAnyActive = (!audio.paused) || (enAudio && !enAudio.paused) || (bnAudio && !bnAudio.paused);
      if (!isAnyActive && !isPlaying) {
        safePlay(activeAudio);
      } else {
        safePause();
      }
    });

    audio.addEventListener("timeupdate", () => {
      if (activeAudio === audio && audio.duration && progress) {
        const pct = (audio.currentTime / audio.duration) * 100;
        progress.style.width = pct + "%";
        progressContainer?.setAttribute("aria-valuenow", String(Math.round(pct)));
      }
    });

    enAudio?.addEventListener("timeupdate", () => {
      if (activeAudio === enAudio && enAudio.duration && progress) {
        const pct = (enAudio.currentTime / enAudio.duration) * 100;
        progress.style.width = pct + "%";
        progressContainer?.setAttribute("aria-valuenow", String(Math.round(pct)));
      }
    });

    bnAudio?.addEventListener("timeupdate", () => {
      if (activeAudio === bnAudio && bnDurationSec > 0 && progress) {
        const elapsed = Math.max(0, bnAudio.currentTime - bnStartSec);
        const pct = Math.min(100, (elapsed / bnDurationSec) * 100);
        progress.style.width = pct + "%";
        progressContainer?.setAttribute("aria-valuenow", String(Math.round(pct)));
      }
    });

    audio.addEventListener("ended", handlePlaybackEnd);
    enAudio?.addEventListener("ended", () => {
      activeAudio = audio;
      finishAyah();
    });

    speedBtn?.addEventListener("click", () => {
      speedIdx = (speedIdx + 1) % speeds.length;
      const s = speeds[speedIdx];
      audio.playbackRate = s;
      if (enAudio) enAudio.playbackRate = s;
      if (bnAudio) bnAudio.playbackRate = s;
      speedBtn.textContent = s + "x";
    });

    const loopLabel = document.getElementById("loop-btn-label");
    loopBtn?.addEventListener("click", () => {
      isLooping = !isLooping;
      if (loopLabel) loopLabel.textContent = isLooping ? "Repeat: On" : "Repeat: Off";
      if (isLooping) {
        loopBtn.classList.add("btn-action-primary");
      } else {
        loopBtn.classList.remove("btn-action-primary");
      }
    });

    const autonextLabel = document.getElementById("autonext-btn-label");
    autonextBtn?.addEventListener("click", () => {
      isAutoNext = !isAutoNext;
      localStorage.setItem("qg_autonext", String(isAutoNext));
      if (autonextLabel) autonextLabel.textContent = isAutoNext ? "Auto-next: On" : "Auto-next: Off";
      if (isAutoNext) {
        autonextBtn.classList.add("btn-action-primary");
      } else {
        autonextBtn.classList.remove("btn-action-primary");
      }
    });

    progressContainer?.addEventListener("click", (e) => {
      if (activeAudio && activeAudio.duration) {
        const rect = progressContainer.getBoundingClientRect();
        const clickPos = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
        if (activeAudio === bnAudio && bnDurationSec > 0) {
          activeAudio.currentTime = bnStartSec + (clickPos * bnDurationSec);
        } else {
          activeAudio.currentTime = clickPos * activeAudio.duration;
        }
      }
    });

    // Check for autoplay parameter
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("autoplay") === "1") {
      setTimeout(() => {
        safePlay(audio);
      }, 250);
    }
  }
</script>
