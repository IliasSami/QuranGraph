---
import graphSummary from "../../../ingest/work/export/graph/summary.json" with { type: "json" };
import entitiesData from "../../../ingest/work/export/graph/entities.json" with { type: "json" };
---

<div class="network-graph-widget card" style="padding: 1.5rem; margin-bottom: 2.5rem; border-top: 4px solid var(--accent-teal);">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
    <div>
      <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.2rem;">Interactive Knowledge Network</h3>
      <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
        Drag nodes or tap to explore connected verses and concepts.
      </p>
    </div>
    <div style="display: flex; gap: 0.4rem; font-size: 0.75rem; flex-wrap: wrap;" id="graph-filters">
      <button class="graph-filter-btn active" data-type="all" style="background: var(--bg-surface); border: 1px solid var(--accent-teal); color: var(--accent-teal); padding: 0.25rem 0.6rem; border-radius: 9999px; cursor: pointer; font-weight: 600;">All</button>
      <button class="graph-filter-btn" data-type="name_of_allah" style="background: var(--bg-subtle); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.25rem 0.6rem; border-radius: 9999px; cursor: pointer; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background: #b45309;"></span> Divine Names</button>
      <button class="graph-filter-btn" data-type="person" style="background: var(--bg-subtle); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.25rem 0.6rem; border-radius: 9999px; cursor: pointer; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background: #0f766e;"></span> Prophets</button>
      <button class="graph-filter-btn" data-type="place" style="background: var(--bg-subtle); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.25rem 0.6rem; border-radius: 9999px; cursor: pointer; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background: #2563eb;"></span> Places</button>
      <button class="graph-filter-btn" data-type="concept" style="background: var(--bg-subtle); border: 1px solid var(--border-color); color: var(--text-main); padding: 0.25rem 0.6rem; border-radius: 9999px; cursor: pointer; font-weight: 500; display: inline-flex; align-items: center; gap: 0.3rem;"><span style="width: 8px; height: 8px; border-radius: 50%; background: #7c3aed;"></span> Concepts</button>
    </div>
  </div>

  <div style="position: relative; width: 100%; height: 480px; background: var(--bg-subtle); border-radius: var(--radius-sm); overflow: hidden; border: 1px solid var(--border-color); touch-action: none;">
    <canvas id="graph-canvas" style="width: 100%; height: 100%; display: block; cursor: grab;"></canvas>
    <div id="graph-tooltip" style="position: absolute; display: none; background: var(--bg-surface); border: 1px solid var(--border-color); padding: 0.5rem 0.75rem; border-radius: 6px; font-size: 0.85rem; pointer-events: none; box-shadow: var(--shadow-md); z-index: 10;"></div>
  </div>
</div>

<script is:inline>
  const canvas = document.getElementById("graph-canvas");
  const tooltip = document.getElementById("graph-tooltip");

  if (canvas) {
    const ctx = canvas.getContext("2d");
    let width = 0;
    let height = 0;
    let dpr = window.devicePixelRatio || 1;

    function resizeCanvas() {
      dpr = window.devicePixelRatio || 1;
      width = canvas.parentElement.clientWidth;
      height = canvas.parentElement.clientHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + "px";
      canvas.style.height = height + "px";
      ctx.resetTransform?.();
      ctx.scale(dpr, dpr);
    }
    resizeCanvas();
    window.addEventListener("resize", resizeCanvas);

    const NODES = [
      { id: "allah", label: "Allah (الله)", type: "name_of_allah", color: "#b45309", r: 24, x: width / 2, y: height / 2, vx: 0, vy: 0 },
      { id: "ar-rahman", label: "Ar-Rahman", type: "name_of_allah", color: "#b45309", r: 16, x: width / 2 - 80, y: height / 2 - 60, vx: 0, vy: 0 },
      { id: "ar-rahim", label: "Ar-Rahim", type: "name_of_allah", color: "#b45309", r: 16, x: width / 2 + 80, y: height / 2 - 60, vx: 0, vy: 0 },
      { id: "muhammad", label: "Prophet Muhammad ﷺ", type: "person", color: "#0f766e", r: 20, x: width / 2, y: height / 2 + 100, vx: 0, vy: 0 },
      { id: "ibrahim", label: "Ibrahim (Abraham)", type: "person", color: "#0f766e", r: 18, x: width / 2 - 140, y: height / 2 + 70, vx: 0, vy: 0 },
      { id: "musa", label: "Musa (Moses)", type: "person", color: "#0f766e", r: 18, x: width / 2 + 140, y: height / 2 + 70, vx: 0, vy: 0 },
      { id: "yusuf", label: "Yusuf (Joseph)", type: "person", color: "#0f766e", r: 16, x: width / 2 - 180, y: height / 2 - 40, vx: 0, vy: 0 },
      { id: "isa", label: "Isa (Jesus)", type: "person", color: "#0f766e", r: 16, x: width / 2 + 180, y: height / 2 - 40, vx: 0, vy: 0 },
      { id: "makkah", label: "Makkah", type: "place", color: "#2563eb", r: 14, x: width / 2 - 60, y: height / 2 + 170, vx: 0, vy: 0 },
      { id: "kaabah", label: "The Ka'bah", type: "place", color: "#2563eb", r: 14, x: width / 2 - 120, y: height / 2 + 160, vx: 0, vy: 0 },
      { id: "tur-sina", label: "Mount Sinai", type: "place", color: "#2563eb", r: 13, x: width / 2 + 160, y: height / 2 + 150, vx: 0, vy: 0 },
      { id: "tawhid", label: "Tawhid (Oneness)", type: "concept", color: "#7c3aed", r: 17, x: width / 2, y: height / 2 - 140, vx: 0, vy: 0 },
      { id: "sabr", label: "Sabr (Patience)", type: "concept", color: "#7c3aed", r: 15, x: width / 2 - 150, y: height / 2 - 120, vx: 0, vy: 0 },
      { id: "akhirah", label: "Akhirah (Hereafter)", type: "concept", color: "#7c3aed", r: 15, x: width / 2 + 150, y: height / 2 - 120, vx: 0, vy: 0 }
    ];

    const EDGES = [
      { u: 0, v: 1 }, { u: 0, v: 2 }, { u: 0, v: 11 }, { u: 0, v: 3 },
      { u: 3, v: 8 }, { u: 3, v: 9 }, { u: 4, v: 9 }, { u: 4, v: 6 },
      { u: 5, v: 10 }, { u: 5, v: 12 }, { u: 11, v: 12 }, { u: 11, v: 13 },
      { u: 3, v: 4 }, { u: 3, v: 5 }, { u: 5, v: 7 }
    ];

    let draggedNode = null;
    let hoveredNode = null;
    let activeType = "all";
    let touchStartTime = 0;
    let touchStartPos = { x: 0, y: 0 };

    // Filter pill interactions
    const filterButtons = document.querySelectorAll(".graph-filter-btn");
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeType = btn.getAttribute("data-type") || "all";
        filterButtons.forEach((b) => {
          const isActive = b === btn;
          b.style.borderColor = isActive ? "var(--accent-teal)" : "var(--border-color)";
          b.style.color = isActive ? "var(--accent-teal)" : "var(--text-main)";
          b.style.background = isActive ? "var(--bg-surface)" : "var(--bg-subtle)";
        });
      });
    });

    // Pointer helper
    function getPointerPos(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return {
        x: clientX - rect.left,
        y: clientY - rect.top
      };
    }

    function findNodeAt(x, y, radiusBoost = 1) {
      for (const n of NODES) {
        const dx = n.x - x;
        const dy = n.y - y;
        if (dx * dx + dy * dy < n.r * n.r * radiusBoost) {
          return n;
        }
      }
      return null;
    }

    // Mouse handlers
    canvas.addEventListener("mousedown", (e) => {
      const pos = getPointerPos(e);
      draggedNode = findNodeAt(pos.x, pos.y);
      if (draggedNode) {
        canvas.style.cursor = "grabbing";
      }
    });

    window.addEventListener("mousemove", (e) => {
      const pos = getPointerPos(e);
      if (draggedNode) {
        draggedNode.x = pos.x;
        draggedNode.y = pos.y;
      }

      hoveredNode = findNodeAt(pos.x, pos.y);
      if (hoveredNode && tooltip) {
        tooltip.style.display = "block";
        tooltip.style.left = pos.x + 15 + "px";
        tooltip.style.top = pos.y - 10 + "px";
        tooltip.innerHTML = `<strong>${hoveredNode.label}</strong><br><span style="color:var(--text-muted);font-size:0.75rem;">Click to search verses</span>`;
        canvas.style.cursor = "pointer";
      } else {
        if (tooltip) tooltip.style.display = "none";
        canvas.style.cursor = draggedNode ? "grabbing" : "grab";
      }
    });

    window.addEventListener("mouseup", () => {
      if (draggedNode) {
        draggedNode = null;
        canvas.style.cursor = "grab";
      }
    });

    canvas.addEventListener("click", () => {
      if (hoveredNode) {
        window.location.href = `/search?q=${encodeURIComponent(hoveredNode.label.split(" (")[0])}`;
      }
    });

    // Mobile Touch Handlers
    canvas.addEventListener("touchstart", (e) => {
      if (!e.touches.length) return;
      const pos = getPointerPos(e);
      touchStartTime = Date.now();
      touchStartPos = { x: pos.x, y: pos.y };
      draggedNode = findNodeAt(pos.x, pos.y, 2.5); // generous touch area
      if (draggedNode) {
        e.preventDefault();
      }
    }, { passive: false });

    window.addEventListener("touchmove", (e) => {
      if (!draggedNode || !e.touches.length) return;
      const pos = getPointerPos(e);
      draggedNode.x = pos.x;
      draggedNode.y = pos.y;
      e.preventDefault();
    }, { passive: false });

    window.addEventListener("touchend", (e) => {
      if (draggedNode) {
        const timeDiff = Date.now() - touchStartTime;
        // If it was a quick tap (< 300ms) with minimal movement, navigate!
        if (timeDiff < 300) {
          window.location.href = `/search?q=${encodeURIComponent(draggedNode.label.split(" (")[0])}`;
        }
        draggedNode = null;
      }
    });

    function step() {
      // Gentle spring simulation
      for (const e of EDGES) {
        const n1 = NODES[e.u];
        const n2 = NODES[e.v];
        const dx = n2.x - n1.x;
        const dy = n2.y - n1.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        const targetDist = 90;
        const force = (dist - targetDist) * 0.003;
        const fx = (dx / dist) * force;
        const fy = (dy / dist) * force;
        if (n1 !== draggedNode) { n1.x += fx; n1.y += fy; }
        if (n2 !== draggedNode) { n2.x -= fx; n2.y -= fy; }
      }

      // Repulsion
      for (let i = 0; i < NODES.length; i++) {
        for (let j = i + 1; j < NODES.length; j++) {
          const n1 = NODES[i];
          const n2 = NODES[j];
          const dx = n2.x - n1.x;
          const dy = n2.y - n1.y;
          const distSq = dx * dx + dy * dy || 1;
          if (distSq < 18000) {
            const force = 40 / distSq;
            const dist = Math.sqrt(distSq);
            const fx = (dx / dist) * force;
            const fy = (dy / dist) * force;
            if (n1 !== draggedNode) { n1.x -= fx; n1.y -= fy; }
            if (n2 !== draggedNode) { n2.x += fx; n2.y += fy; }
          }
        }
      }

      // Render
      ctx.clearRect(0, 0, width, height);

      // Edges
      ctx.strokeStyle = "rgba(150, 160, 175, 0.35)";
      ctx.lineWidth = 1.5;
      for (const e of EDGES) {
        const n1 = NODES[e.u];
        const n2 = NODES[e.v];
        const match1 = activeType === "all" || n1.type === activeType;
        const match2 = activeType === "all" || n2.type === activeType;
        ctx.strokeStyle = match1 && match2 ? "rgba(150, 160, 175, 0.45)" : "rgba(150, 160, 175, 0.1)";
        ctx.beginPath();
        ctx.moveTo(n1.x, n1.y);
        ctx.lineTo(n2.x, n2.y);
        ctx.stroke();
      }

      // Nodes
      for (const n of NODES) {
        const isMatch = activeType === "all" || n.type === activeType;
        ctx.save();
        if (!isMatch) {
          ctx.globalAlpha = 0.25;
        }

        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = n.color;
        ctx.fill();

        if (n === hoveredNode || (activeType !== "all" && isMatch)) {
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 3;
          ctx.stroke();
        }

        // Label
        ctx.fillStyle = "var(--text-main)";
        ctx.font = "600 11px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText(n.label, n.x, n.y + n.r + 14);
        ctx.restore();
      }

      requestAnimationFrame(step);
    }

    step();
  }
</script>
