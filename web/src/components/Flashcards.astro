---
import lemmasData from "../lib/search/lemmas_lab.json" with { type: "json" };

const cards = lemmasData;
---

<div class="flashcards-widget card" style="border-top: 4px solid var(--accent-gold); max-width: 640px; margin: 0 auto; padding: 1.5rem 1.75rem;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
    <div>
      <span class="badge badge-gold" style="font-weight: 700; font-size: 0.75rem;">Active Recall Flashcards</span>
      <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 0.2rem;">
        Spaced repetition of the 50% Quranic vocabulary
      </div>
    </div>
    <div style="display: flex; gap: 0.5rem; align-items: center;">
      <span id="fc-mastered-count" class="badge" style="background: var(--accent-teal-subtle); color: var(--accent-teal); font-size: 0.75rem; font-weight: 700;">
        Mastered: 0
      </span>
      <span id="fc-progress" style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">
        Card 1 of {cards.length}
      </span>
    </div>
  </div>

  <div id="fc-card" style="min-height: 240px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; background: var(--bg-subtle); border-radius: var(--radius-md); padding: 2rem 1.5rem; border: 1px solid var(--border-color); margin-bottom: 1.5rem; position: relative;">
    <div style="position: absolute; top: 12px; left: 16px; font-size: 0.75rem; color: var(--text-muted); font-weight: 700;" id="fc-card-rank">
      Rank #{cards[0]?.rank || 1}
    </div>
    <div style="position: absolute; top: 12px; right: 16px; font-size: 0.72rem; color: var(--text-muted);" id="fc-card-pos">
      {cards[0]?.pos_label || ""}
    </div>

    <!-- Sacred Arabic Word (Zero Overlap Guaranteed) -->
    <div
      id="fc-arabic"
      class="arabic-text arabic-display"
      lang="ar"
      dir="rtl"
      style="--arabic-font-size: 3.4rem; font-size: 3.4rem; color: var(--accent-teal); line-height: 2.1; text-align: center; margin-bottom: 0.5rem; padding-bottom: 0.35rem;"
    >
      {cards[0]?.lemma || ""}
    </div>
    <div
      id="fc-translit"
      style="font-size: 1.2rem; font-style: italic; color: var(--accent-gold); font-family: var(--font-latin); margin-top: 0.45rem; margin-bottom: 0.75rem; letter-spacing: 0.02em; line-height: 1.4;"
    >
      {cards[0]?.translit || ""}
    </div>
    <div id="fc-root" style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 0.75rem;">
      {cards[0]?.root ? `Root: ${cards[0].root}` : "Particle / Pronoun"}
    </div>
    <div id="fc-count" class="badge" style="background: var(--bg-surface); color: var(--text-muted); font-size: 0.72rem; margin-bottom: 0.5rem;">
      {cards[0]?.count?.toLocaleString() || 0} occurrences ({cards[0]?.percentage || 0}% of Quran)
    </div>

    <!-- Hidden answer area -->
    <div id="fc-answer" style="display: none; border-top: 1px dashed var(--border-color); padding-top: 1rem; width: 100%; margin-top: 0.5rem;">
      <div id="fc-meaning-en" style="font-size: 1.25rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem;">
        {cards[0]?.meaning_en || ""}
      </div>
      <div id="fc-meaning-bn" class="bangla-text" lang="bn" style="font-size: 1.05rem; color: var(--text-muted); margin-bottom: 0.5rem;">
        {cards[0]?.meaning_bn || ""}
      </div>
      <div id="fc-sample-context" style="font-size: 0.8rem; color: var(--text-muted); background: var(--bg-surface); padding: 0.4rem 0.75rem; border-radius: var(--radius-sm); display: inline-block;">
        Anchor: Ayah {cards[0]?.sample_ref || ""}
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div id="fc-reveal-container" style="display: flex; justify-content: center; gap: 0.75rem;">
    <button id="fc-prev-btn" class="btn-action btn-action-sm btn-action-ghost" style="padding: 0.75rem 1rem;" title="Previous card">
      ← Prev
    </button>
    <button id="fc-reveal-btn" class="btn-action btn-action-primary" style="flex: 1; padding: 0.75rem 1.5rem; font-size: 1rem; font-weight: 600; justify-content: center;">
      <span>Reveal Meaning (<span class="bangla-text" lang="bn">উন্মোচন</span>)</span>
      <kbd style="font-size: 0.72rem; opacity: 0.85; margin-left: 0.4rem; background: rgba(var(--bg-surface-rgb), 0.25); border: 1px solid var(--border-color); padding: 0.1rem 0.35rem; border-radius: 3px; color: inherit;">Space</kbd>
    </button>
    <button id="fc-skip-btn" class="btn-action btn-action-sm btn-action-ghost" style="padding: 0.75rem 1rem;" title="Skip to next card">
      Skip →
    </button>
  </div>

  <div id="fc-response-container" style="display: none; justify-content: center; gap: 0.75rem;">
    <button id="fc-again-btn" class="btn-action" style="flex: 1; padding: 0.75rem; background: var(--bg-subtle); color: var(--text-main); font-weight: 600; justify-content: center;">
      <span>🔄 Review Again</span>
      <kbd style="font-size: 0.72rem; opacity: 0.85; margin-left: 0.3rem; background: var(--bg-surface); border: 1px solid var(--border-color); padding: 0.1rem 0.35rem; border-radius: 3px;">1</kbd>
    </button>
    <button id="fc-know-btn" class="btn-action btn-action-primary" style="flex: 1; padding: 0.75rem; font-weight: 600; justify-content: center;">
      <span>✅ Mastered (<span class="bangla-text" lang="bn">জানা আছে</span>)</span>
      <kbd style="font-size: 0.72rem; opacity: 0.85; margin-left: 0.3rem; background: rgba(var(--bg-surface-rgb), 0.25); border: 1px solid var(--border-color); padding: 0.1rem 0.35rem; border-radius: 3px; color: inherit;">2</kbd>
    </button>
  </div>
</div>

<script is:inline define:vars={{ cards }}>
  (function () {
    let currentIdx = 0;
    const arabicEl = document.getElementById("fc-arabic");
    const translitEl = document.getElementById("fc-translit");
    const rootEl = document.getElementById("fc-root");
    const countEl = document.getElementById("fc-count");
    const rankEl = document.getElementById("fc-card-rank");
    const posEl = document.getElementById("fc-card-pos");
    const meaningEnEl = document.getElementById("fc-meaning-en");
    const meaningBnEl = document.getElementById("fc-meaning-bn");
    const sampleContextEl = document.getElementById("fc-sample-context");
    const answerEl = document.getElementById("fc-answer");
    const revealContainer = document.getElementById("fc-reveal-container");
    const responseContainer = document.getElementById("fc-response-container");
    const progressEl = document.getElementById("fc-progress");
    const masteredEl = document.getElementById("fc-mastered-count");

    let mastered = new Set();
    try {
      const saved = localStorage.getItem("qg_mastered_lemmas");
      if (saved) mastered = new Set(JSON.parse(saved));
    } catch (e) {}

    function updateMasteredCount() {
      if (masteredEl) masteredEl.textContent = `Mastered: ${mastered.size} / ${cards.length}`;
    }
    updateMasteredCount();

    function showCard(idx) {
      currentIdx = (idx + cards.length) % cards.length;
      const c = cards[currentIdx];

      if (arabicEl) arabicEl.textContent = c.lemma;
      if (translitEl) translitEl.textContent = c.translit;
      if (rootEl) rootEl.textContent = c.root ? `Root: ${c.root}` : "Particle / Pronoun";
      if (countEl) countEl.textContent = `${c.count.toLocaleString()} occurrences (${c.percentage}% of Quran)`;
      if (rankEl) rankEl.textContent = `Rank #${c.rank}`;
      if (posEl) posEl.textContent = c.pos_label;
      if (meaningEnEl) meaningEnEl.textContent = c.meaning_en;
      if (meaningBnEl) meaningBnEl.textContent = c.meaning_bn;
      if (sampleContextEl) sampleContextEl.textContent = `Anchor Verse: Ayah ${c.sample_ref}`;
      if (progressEl) progressEl.textContent = `Card ${currentIdx + 1} of ${cards.length}`;

      if (answerEl) answerEl.style.display = "none";
      if (revealContainer) revealContainer.style.display = "flex";
      if (responseContainer) responseContainer.style.display = "none";
    }

    function reveal() {
      if (answerEl) answerEl.style.display = "block";
      if (revealContainer) revealContainer.style.display = "none";
      if (responseContainer) responseContainer.style.display = "flex";
    }

    document.getElementById("fc-reveal-btn")?.addEventListener("click", reveal);
    document.getElementById("fc-prev-btn")?.addEventListener("click", () => showCard(currentIdx - 1));
    document.getElementById("fc-skip-btn")?.addEventListener("click", () => showCard(currentIdx + 1));

    document.getElementById("fc-again-btn")?.addEventListener("click", () => {
      showCard(currentIdx + 1);
    });

    document.getElementById("fc-know-btn")?.addEventListener("click", () => {
      mastered.add(cards[currentIdx].lemma);
      try {
        localStorage.setItem("qg_mastered_lemmas", JSON.stringify([...mastered]));
      } catch (e) {}
      updateMasteredCount();
      showCard(currentIdx + 1);
    });

    document.addEventListener("keydown", (e) => {
      if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;
      if (e.code === "Space") {
        e.preventDefault();
        if (answerEl?.style.display === "none") {
          reveal();
        } else {
          showCard(currentIdx + 1);
        }
      } else if (e.key === "1" && responseContainer?.style.display === "flex") {
        showCard(currentIdx + 1);
      } else if (e.key === "2" && responseContainer?.style.display === "flex") {
        mastered.add(cards[currentIdx].lemma);
        try {
          localStorage.setItem("qg_mastered_lemmas", JSON.stringify([...mastered]));
        } catch (err) {}
        updateMasteredCount();
        showCard(currentIdx + 1);
      }
    });

    showCard(0);
  })();
</script>
