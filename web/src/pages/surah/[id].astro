---
import Layout from "../../layouts/Layout.astro";
import surahsData from "../../lib/search/surahs.json" with { type: "json" };
import corpusData from "../../lib/search/corpus.json" with { type: "json" };

export function getStaticPaths() {
  return surahsData.map((s) => ({
    params: { id: String(s.id) },
    props: {
      surah: s,
      ayat: corpusData.filter((a) => a.s === s.id)
    }
  }));
}

const { surah, ayat } = Astro.props;
const prevSurahObj = surah.id > 1 ? surahsData[surah.id - 2] : null;
const nextSurahObj = surah.id < 114 ? surahsData[surah.id] : null;
---

<Layout title={`Surah ${surah.name_translit} (${surah.id}) — QuranGraph`}>
  <!-- Surah Header Banner -->
  <section style="padding: 3.5rem 0 2.5rem; background: var(--bg-surface); border-bottom: 1px solid var(--border-color); text-align: center;">
    <div class="container" style="max-width: 800px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 0.5rem;">
        {prevSurahObj ? (
          <a href={`/surah/${prevSurahObj.id}`} class="btn-icon" aria-label={`Previous Surah ${prevSurahObj.name_translit}`}>← {prevSurahObj.id}. {prevSurahObj.name_translit}</a>
        ) : <div />}
        <span class="badge badge-teal">Surah {surah.id} of 114</span>
        {nextSurahObj ? (
          <a href={`/surah/${nextSurahObj.id}`} class="btn-icon" aria-label={`Next Surah ${nextSurahObj.name_translit}`}>{nextSurahObj.id}. {nextSurahObj.name_translit} →</a>
        ) : <div />}
      </div>

      <div class="arabic-text" lang="ar" dir="rtl" style="font-size: 3rem; color: var(--accent-teal); margin-bottom: 0.5rem;">
        {surah.name_ar}
      </div>
      <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.25rem;">
        {surah.name_translit}
      </h1>
      <p style="font-size: 1.15rem; color: var(--text-muted); margin-bottom: 0.5rem;" class="bangla-text" lang="bn">
        {surah.name_bn} · {surah.name_en}
      </p>
      <div style="font-size: 0.9rem; color: var(--text-muted); display: flex; justify-content: center; gap: 0.75rem;">
        <span>{surah.ayat} verses</span>
        <span>•</span>
        <span>{surah.type} Revelation</span>
        {surah.revelation_order && (
          <>
            <span>•</span>
            <span>Order #{surah.revelation_order}</span>
          </>
        )}
      </div>

      <!-- Surah Audio Recitation Bar -->
      <div id="main-audio-bar" class="card" style="margin-top: 2rem; padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; text-align: left;">
        <div style="display: flex; align-items: center; gap: 1rem;">
          <button id="surah-play-btn" class="play-btn-sm" aria-label="Play full Surah recitation">
            <span id="surah-play-icon" aria-hidden="true">
              <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4" fill="currentColor"></polygon></svg>
            </span>
          </button>
          <div>
            <div id="surah-player-status" style="font-weight: 700; font-size: 0.95rem;">
              Play Full Surah ({surah.ayat} Ayat)
            </div>
            <div id="surah-player-verse" style="font-size: 0.8rem; color: var(--text-muted);">
              Mishary Rashid Alafasy · Continuous recitation
            </div>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
          <button id="autoscroll-toggle-btn" class="btn-action btn-action-sm" style="font-size: 0.82rem;" title="Toggle automatic scrolling as verses play" aria-label="Toggle auto scroll">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            <span>Auto-scroll: <strong id="autoscroll-label">On</strong></span>
          </button>
          <select id="surah-reciter-select" class="form-select" aria-label="Select Reciter" style="padding: 0.4rem 0.6rem; font-size: 0.85rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); background: var(--bg-surface); color: var(--text-main); min-height: 38px;">
            <option value="Alafasy_64kbps">Mishary Alafasy</option>
            <option value="Husary_128kbps">Mahmoud Al-Husary</option>
            <option value="Minshawy_Murattal_128kbps">Mohamed El-Minshawi</option>
            <option value="Abdurrahmaan_As-Sudais_192kbps">Abdur-Rahman As-Sudais</option>
          </select>
          <button id="surah-stop-btn" class="btn-action btn-action-sm" title="Stop Playback" aria-label="Stop Playback">
            <svg class="icon-svg" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2" fill="currentColor"></rect></svg>
            <span>Stop</span>
          </button>
        </div>
      </div>

      {surah.id !== 1 && surah.id !== 9 && (
        <div class="arabic-text" lang="ar" dir="rtl" style="font-size: 1.75rem; margin-top: 2rem; color: var(--text-main);">
          بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ
        </div>
      )}
    </div>
  </section>

  <!-- Verses List -->
  <section style="padding: 3rem 0;">
    <div class="container" style="max-width: 860px;">
      <div style="display: flex; flex-direction: column; gap: 2rem;" id="verses-container">
        {ayat.map((item) => (
          <article class="card verse-card" id={`ayah-${item.a}`} data-ayah={item.a} style="position: relative; scroll-margin-top: 5rem; transition: border-color 0.2s ease, box-shadow 0.2s ease;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
              <span class="badge badge-teal" style="font-size: 0.82rem; padding: 0.25rem 0.65rem;">
                {item.s}:{item.a}
              </span>
              <span style="font-size: 0.8rem; color: var(--text-muted);">
                Surah {surah.name_translit} · Ayah {item.a}
              </span>
            </div>

            <!-- Arabic Display -->
            <div class="arabic-text" lang="ar" dir="rtl" style="--arabic-font-size: 1.85rem; margin-bottom: 1rem; word-spacing: 0.15em; line-height: 2;">
              {item.ar_u || item.ar}
              <span aria-hidden="true" style="display: inline-block; font-size: 1.2rem; color: var(--accent-teal); margin-right: 0.4rem;">
                ۝
              </span>
            </div>

            <!-- English Transliteration -->
            {item.tr && (
              <div style="font-size: 0.95rem; font-style: italic; color: var(--accent-gold); margin-bottom: 0.85rem; line-height: 1.5; font-family: var(--font-latin);">
                {item.tr}
              </div>
            )}

            <!-- English Translation -->
            <div style="margin-bottom: 0.75rem; font-size: 1.05rem; line-height: 1.6; color: var(--text-main);">
              {item.en}
            </div>

            <!-- Bangla Translation -->
            <div class="bangla-text" lang="bn" style="font-size: 1rem; line-height: 1.7; color: var(--text-muted); border-top: 1px dashed var(--border-color); padding-top: 0.75rem; margin-bottom: 1.25rem;">
              {item.bn}
            </div>

            <!-- Action Bar -->
            <div class="verse-action-bar" style="border-top: 1px solid var(--border-color); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
              <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <button
                  class="verse-play-btn btn-action btn-action-sm"
                  data-ayah={item.a}
                  title={`Listen to verse ${item.a}`}
                  aria-label={`Listen to verse ${item.s}:${item.a}`}
                >
                  <span class="btn-icon-slot">
                    <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4" fill="currentColor"></polygon></svg>
                  </span>
                  <span class="btn-label-slot">Listen</span>
                </button>

                <button
                  class="verse-copy-btn btn-action btn-action-sm"
                  data-ref={`${item.s}:${item.a}`}
                  data-ar={encodeURIComponent(item.ar_u || item.ar)}
                  data-en={encodeURIComponent(item.en)}
                  data-bn={encodeURIComponent(item.bn)}
                  title="Copy verse text with citation"
                  aria-label={`Copy verse ${item.s}:${item.a}`}
                >
                  <svg class="icon-svg" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  <span>Copy</span>
                </button>

                <button
                  class="verse-bookmark-btn btn-action btn-action-sm"
                  data-surah={item.s}
                  data-ayah={item.a}
                  data-name={surah.name_translit}
                  title="Bookmark this verse as last read"
                  aria-label={`Bookmark verse ${item.s}:${item.a}`}
                >
                  <svg class="icon-svg" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                  <span>Bookmark</span>
                </button>
              </div>

              <a href={`/ayah/${item.s}/${item.a}`} class="btn-action btn-action-sm btn-action-primary" style="gap: 0.4rem;">
                <svg class="icon-svg" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                <span>Study Ayah & Tafsir</span>
                <svg class="icon-svg" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Sticky Bottom Audio Dock (Activated on scroll) -->
  <div id="surah-sticky-dock" class="sticky-dock card" style="display: none; width: calc(100% - 1.5rem); max-width: 650px; margin: 0 auto; border-radius: var(--radius-md); align-items: center; justify-content: space-between; gap: 0.75rem; box-sizing: border-box;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
      <button id="dock-play-btn" class="play-btn-sm" style="width: 2.25rem; height: 2.25rem; min-width: 38px; min-height: 38px;" aria-label="Play/Pause">
        <span id="dock-play-icon" aria-hidden="true">
          <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4" fill="currentColor"></polygon></svg>
        </span>
      </button>
      <div>
        <div id="dock-status" style="font-weight: 700; font-size: 0.85rem; color: var(--text-main);">
          Surah {surah.name_translit}
        </div>
        <div id="dock-verse" style="font-size: 0.75rem; color: var(--text-muted);">
          Ayah 1 of {surah.ayat}
        </div>
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: 0.4rem;">
      <button id="dock-prev-ayah" class="btn-action btn-action-sm btn-action-icon" title="Previous Verse" aria-label="Previous Verse">
        <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="19 20 9 12 19 4 19 20" fill="currentColor"></polygon><line x1="5" y1="19" x2="5" y2="5"></line></svg>
      </button>
      <button id="dock-next-ayah" class="btn-action btn-action-sm btn-action-icon" title="Next Verse" aria-label="Next Verse">
        <svg class="icon-svg" viewBox="0 0 24 24"><polygon points="5 4 15 12 5 20 5 4" fill="currentColor"></polygon><line x1="19" y1="5" x2="19" y2="19"></line></svg>
      </button>
      <button id="dock-stop-btn" class="btn-action btn-action-sm btn-action-icon" title="Stop Playback" aria-label="Stop Playback">
        <svg class="icon-svg" viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" rx="2" fill="currentColor"></rect></svg>
      </button>
    </div>
  </div>

  <audio id="surah-audio-player" preload="none"></audio>
</Layout>

<style>
  .play-btn-sm {
    width: 2.75rem;
    height: 2.75rem;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    background: var(--accent-teal);
    color: white;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .play-btn-sm:hover {
    background: var(--accent-teal-hover);
    transform: scale(1.05);
  }
  .verse-card.playing {
    border-color: var(--accent-teal);
  }
</style>

<script is:inline define:vars={{ sId: surah.id, totalAyat: surah.ayat, surahName: surah.name_translit }}>
  const audio = document.getElementById("surah-audio-player");
  const playBtn = document.getElementById("surah-play-btn");
  const playIcon = document.getElementById("surah-play-icon");
  const stopBtn = document.getElementById("surah-stop-btn");
  const statusEl = document.getElementById("surah-player-status");
  const verseEl = document.getElementById("surah-player-verse");
  const reciterSelect = document.getElementById("surah-reciter-select");
  const verseCards = document.querySelectorAll(".verse-card");
  const versePlayBtns = document.querySelectorAll(".verse-play-btn");

  // Sticky dock elements
  const mainBar = document.getElementById("main-audio-bar");
  const stickyDock = document.getElementById("surah-sticky-dock");
  const dockPlayBtn = document.getElementById("dock-play-btn");
  const dockPlayIcon = document.getElementById("dock-play-icon");
  const dockVerseEl = document.getElementById("dock-verse");
  const dockPrevBtn = document.getElementById("dock-prev-ayah");
  const dockNextBtn = document.getElementById("dock-next-ayah");
  const dockStopBtn = document.getElementById("dock-stop-btn");

  // Auto-scroll toggle
  const autoscrollBtn = document.getElementById("autoscroll-toggle-btn");
  const autoscrollLabel = document.getElementById("autoscroll-label");
  let autoScroll = true;

  autoscrollBtn?.addEventListener("click", () => {
    autoScroll = !autoScroll;
    if (autoscrollLabel) autoscrollLabel.textContent = autoScroll ? "On" : "Off";
    if (autoscrollBtn) autoscrollBtn.style.borderColor = autoScroll ? "var(--accent-teal)" : "var(--border-color)";
  });

  // Sticky dock observer
  if (mainBar && stickyDock && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        // Show dock when mainBar is above the viewport
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          stickyDock.style.display = "flex";
        } else {
          stickyDock.style.display = "none";
        }
      },
      { threshold: 0 }
    );
    observer.observe(mainBar);
  }

  let currentAyah = 1;
  let isPlaying = false;

  const PLAY_ICON_SVG = '<svg class="icon-svg" viewBox="0 0 24 24"><polygon points="6 4 20 12 6 20 6 4" fill="currentColor"></polygon></svg>';
  const PAUSE_ICON_SVG = '<svg class="icon-svg" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" rx="1" fill="currentColor"></rect><rect x="14" y="4" width="4" height="16" rx="1" fill="currentColor"></rect></svg>';
  const CHECK_ICON_SVG = '<svg class="icon-svg" viewBox="0 0 24 24" style="stroke: #10b981;"><polyline points="20 6 9 17 4 12"></polyline></svg>';
  const COPY_ICON_SVG = '<svg class="icon-svg" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const BOOKMARK_OUTLINE_SVG = '<svg class="icon-svg" viewBox="0 0 24 24"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>';
  const BOOKMARK_FILLED_SVG = '<svg class="icon-svg" viewBox="0 0 24 24" style="fill: var(--accent-gold); stroke: var(--accent-gold);"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>';

  function updateSyncUI() {
    const iconSvg = isPlaying ? PAUSE_ICON_SVG : PLAY_ICON_SVG;
    if (playIcon) playIcon.innerHTML = iconSvg;
    if (dockPlayIcon) dockPlayIcon.innerHTML = iconSvg;
    if (dockVerseEl) dockVerseEl.textContent = `Ayah ${currentAyah} of ${totalAyat}`;

    // Update verse play buttons
    versePlayBtns.forEach((btn) => {
      const a = parseInt(btn.getAttribute("data-ayah") || "0", 10);
      const iconSlot = btn.querySelector(".btn-icon-slot");
      const labelSlot = btn.querySelector(".btn-label-slot");
      if (a === currentAyah && isPlaying) {
        btn.classList.add("btn-action-primary");
        if (iconSlot) iconSlot.innerHTML = PAUSE_ICON_SVG;
        if (labelSlot) labelSlot.textContent = "Pause";
      } else {
        btn.classList.remove("btn-action-primary");
        if (iconSlot) iconSlot.innerHTML = PLAY_ICON_SVG;
        if (labelSlot) labelSlot.textContent = "Listen";
      }
    });
  }

  function saveLastRead(ayahNum) {
    try {
      localStorage.setItem("qg_last_read", JSON.stringify({
        surah: sId,
        ayah: ayahNum,
        name: surahName,
        timestamp: Date.now()
      }));
    } catch (e) {}
  }

  function getAudioUrl(ayahNum) {
    const reciter = reciterSelect?.value || "Alafasy_64kbps";
    const sStr = String(sId).padStart(3, "0");
    const aStr = String(ayahNum).padStart(3, "0");
    return `https://everyayah.com/data/${reciter}/${sStr}${aStr}.mp3`;
  }

  function highlightVerse(ayahNum) {
    verseCards.forEach((c) => {
      const a = parseInt(c.getAttribute("data-ayah") || "0", 10);
      if (a === ayahNum) {
        c.classList.add("playing");
        c.classList.add("active-playing");
        c.style.borderColor = "var(--accent-teal)";
        c.style.boxShadow = "0 0 0 2px rgba(15, 118, 110, 0.25)";
        if (autoScroll) {
          c.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      } else {
        c.classList.remove("playing");
        c.classList.remove("active-playing");
        c.style.borderColor = "";
        c.style.boxShadow = "";
      }
    });
  }

  function playAyah(ayahNum) {
    currentAyah = ayahNum;
    audio.src = getAudioUrl(currentAyah);
    audio.play().then(() => {
      isPlaying = true;
      updateSyncUI();
      if (statusEl) statusEl.textContent = `Playing Verse ${sId}:${currentAyah} of ${totalAyat}`;
      highlightVerse(currentAyah);
      saveLastRead(currentAyah);
    }).catch((e) => console.log("Playback blocked:", e));
  }

  function togglePlayback() {
    if (isPlaying) {
      audio.pause();
      isPlaying = false;
      updateSyncUI();
      if (statusEl) statusEl.textContent = "Paused";
    } else {
      playAyah(currentAyah);
    }
  }

  function stopPlayback() {
    audio.pause();
    audio.currentTime = 0;
    isPlaying = false;
    currentAyah = 1;
    updateSyncUI();
    if (statusEl) statusEl.textContent = `Play Full Surah (${totalAyat} Ayat)`;
    verseCards.forEach((c) => {
      c.classList.remove("playing");
      c.classList.remove("active-playing");
      c.style.borderColor = "";
      c.style.boxShadow = "";
    });
  }

  playBtn?.addEventListener("click", togglePlayback);
  dockPlayBtn?.addEventListener("click", togglePlayback);
  stopBtn?.addEventListener("click", stopPlayback);
  dockStopBtn?.addEventListener("click", stopPlayback);

  dockPrevBtn?.addEventListener("click", () => {
    if (currentAyah > 1) {
      playAyah(currentAyah - 1);
    }
  });

  dockNextBtn?.addEventListener("click", () => {
    if (currentAyah < totalAyat) {
      playAyah(currentAyah + 1);
    }
  });

  audio?.addEventListener("ended", () => {
    if (currentAyah < totalAyat) {
      playAyah(currentAyah + 1);
    } else {
      isPlaying = false;
      currentAyah = 1;
      updateSyncUI();
      if (statusEl) statusEl.textContent = `Finished Surah (${totalAyat} Ayat)`;
      verseCards.forEach((c) => {
        c.classList.remove("playing");
        c.classList.remove("active-playing");
        c.style.borderColor = "";
        c.style.boxShadow = "";
      });
    }
  });

  versePlayBtns.forEach((btn) => {
    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const aNum = parseInt(btn.getAttribute("data-ayah") || "1", 10);
      if (currentAyah === aNum && isPlaying) {
        togglePlayback();
      } else {
        playAyah(aNum);
      }
    });
  });

  // Verse Quick Copy
  document.querySelectorAll(".verse-copy-btn").forEach((btnEl) => {
    btnEl.addEventListener("click", () => {
      const ref = btnEl.getAttribute("data-ref") || "";
      const ar = decodeURIComponent(btnEl.getAttribute("data-ar") || "");
      const en = decodeURIComponent(btnEl.getAttribute("data-en") || "");
      const bn = decodeURIComponent(btnEl.getAttribute("data-bn") || "");

      const textToCopy = `Surah ${surahName} (${ref})\n\n${ar}\n\nEnglish: ${en}\n\nবাংলা: ${bn}\n\nhttps://qurangraph.com/ayah/${ref.replace(":", "/")}`;
      navigator.clipboard.writeText(textToCopy).then(() => {
        const svg = btnEl.querySelector("svg");
        const span = btnEl.querySelector("span");
        if (svg) svg.outerHTML = CHECK_ICON_SVG;
        if (span) span.textContent = "Copied!";
        (window as any).showQgToast?.(`Ayah ${ref} copied to clipboard`);
        setTimeout(() => {
          const curSvg = btnEl.querySelector("svg");
          if (curSvg) curSvg.outerHTML = COPY_ICON_SVG;
          if (span) span.textContent = "Copy";
        }, 2000);
      }).catch(console.error);
    });
  });

  // Verse Bookmark Button
  document.querySelectorAll(".verse-bookmark-btn").forEach((btnEl) => {
    btnEl.addEventListener("click", () => {
      const a = parseInt(btnEl.getAttribute("data-ayah") || "1", 10);
      saveLastRead(a);
      const svg = btnEl.querySelector("svg");
      const span = btnEl.querySelector("span");
      if (svg) svg.outerHTML = BOOKMARK_FILLED_SVG;
      if (span) span.textContent = "Bookmarked!";
      (window as any).showQgToast?.(`Bookmarked Ayah ${sId}:${a} as last read`);
      setTimeout(() => {
        const curSvg = btnEl.querySelector("svg");
        if (curSvg) curSvg.outerHTML = BOOKMARK_OUTLINE_SVG;
        if (span) span.textContent = "Bookmark";
      }, 2000);
    });
  });

  reciterSelect?.addEventListener("change", () => {
    if (isPlaying) {
      playAyah(currentAyah);
    }
  });
</script>
