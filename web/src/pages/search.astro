---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Search the Quran — Multilingual, Semantic & Transliteration Engine | QuranGraph" description="Search the Holy Quran across 6,236 verses by English translation, sacred Arabic, Bangla, Latin transliteration, verse references (e.g. 2:255), and moral concepts.">
  <div style="padding: 2.5rem 0 4rem;">
    <div class="container" style="max-width: 900px;">
      <!-- Search Header -->
      <header style="margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
          <span class="badge badge-teal" style="font-size: 0.8rem; font-weight: 700;">
            Multi-Script & Semantic Engine
          </span>
          <span style="font-size: 0.8rem; color: var(--text-muted);">
            6,236 Ayat · 114 Surahs · 884 Entities
          </span>
        </div>
        <h1 style="font-size: 2.35rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem; letter-spacing: -0.02em;">
          Search the Holy Quran
        </h1>
        <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.6;">
          Search by English meaning, sacred Arabic (simple or vocalised), Bangla translation, English transliteration (e.g. <em>"iyyaka na'budu"</em>), direct reference (<em>"2:255"</em>, <em>"surah mulk"</em>, <em><span class="bangla-text" lang="bn">"বাকারা ২৫৫"</span></em>), or moral themes.
        </p>
      </header>

      <!-- Search Input Box -->
      <section style="margin-bottom: 1.5rem;" aria-label="Search controls">
        <div class="search-box-wrapper" style="position: relative;">
          <div style="display: flex; gap: 0.5rem; background: var(--bg-surface); padding: 0.5rem 0.75rem; border-radius: var(--radius-md); border: 2px solid var(--accent-teal); box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); align-items: center;">
            <span style="font-size: 1.25rem; color: var(--text-muted); padding-left: 0.5rem;" aria-hidden="true">
              🔍
            </span>
            <input
              id="search-input"
              type="search"
              placeholder="Search verse (2:255), surah (mulk), phrase, transliteration, or topic..."
              aria-label="Search Quran"
              autocomplete="off"
              spellcheck="false"
              style="flex: 1; min-width: 0; border: none; outline: none; padding: 0.75rem 0.5rem; font-size: 1.05rem; background: transparent; color: var(--text-main);"
              autofocus
            />
            <button
              id="clear-btn"
              type="button"
              title="Clear query"
              aria-label="Clear query"
              style="display: none; background: none; border: none; font-size: 1.1rem; color: var(--text-muted); cursor: pointer; padding: 0.5rem; border-radius: 50%; min-width: 36px; min-height: 36px;"
            >
              ✕
            </button>
            <button
              id="search-btn"
              class="btn-icon"
              style="background: var(--btn-primary-bg); color: var(--btn-primary-text); border: none; padding: 0.75rem 1.5rem; border-radius: var(--radius-sm); font-weight: 700; cursor: pointer; min-height: 44px; display: flex; align-items: center; gap: 0.4rem;"
            >
              <span>Search</span>
            </button>
          </div>
        </div>

        <!-- Quick Suggestions & Shortcuts -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
          <div style="font-size: 0.85rem; color: var(--text-muted); display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
            <span style="font-weight: 600;">Popular:</span>
            <button class="quick-pill" data-query="ayatul kursi">ayatul kursi</button>
            <button class="quick-pill" data-query="2:255">2:255</button>
            <button class="quick-pill" data-query="surah mulk">surah mulk</button>
            <button class="quick-pill" data-query="patience">patience</button>
            <button class="quick-pill" data-query="with hardship comes ease">with hardship comes ease</button>
            <button class="quick-pill" data-query="বাকারা ২৫৫">বাকারা ২৫৫</button>
            <button class="quick-pill" data-query="ধৈর্য">ধৈর্য</button>
            <button class="quick-pill" data-query="iyyaka nabudu">iyyaka nabudu</button>
            <button class="quick-pill" data-query="story of yusuf">story of yusuf</button>
          </div>
          <div style="font-size: 0.75rem; color: var(--text-muted);">
            Tip: Press <kbd style="background: var(--bg-subtle); padding: 0.1rem 0.35rem; border-radius: 4px; border: 1px solid var(--border-color); font-family: monospace;">/</kbd> to search
          </div>
        </div>
      </section>

      <!-- Filter Tabs Bar (Shown when results exist) -->
      <div id="filter-bar" style="display: none; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;" role="tablist" aria-label="Result category filters">
            <button class="filter-tab active" data-filter="all" role="tab" aria-selected="true" aria-controls="results-container" id="tab-all">
              All Results (<span id="count-all">0</span>)
            </button>
            <button class="filter-tab" data-filter="surah" role="tab" aria-selected="false" aria-controls="results-container" id="tab-surah">
              Surahs (<span id="count-surah">0</span>)
            </button>
            <button class="filter-tab" data-filter="verse" role="tab" aria-selected="false" aria-controls="results-container" id="tab-verse">
              Verses (<span id="count-verse">0</span>)
            </button>
            <button class="filter-tab" data-filter="concept" role="tab" aria-selected="false" aria-controls="results-container" id="tab-concept">
              Concepts & Stories (<span id="count-concept">0</span>)
            </button>
          </div>
          <div id="search-speed" style="font-size: 0.8rem; color: var(--text-muted);" aria-live="polite"></div>
        </div>
      </div>

      <!-- Live Results Container -->
      <div id="results-meta" style="margin-bottom: 1rem; font-size: 0.9rem; color: var(--text-muted); display: none;" role="status" aria-live="polite"></div>
      
      <!-- Audio Player Instance for Previews -->
      <audio id="global-preview-player" preload="none"></audio>

      <!-- Main Results Listing -->
      <main id="results-container" style="display: flex; flex-direction: column; gap: 1.5rem;" aria-label="Search results"></main>
    </div>
  </div>

  <style>
    .quick-pill {
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      border-radius: 9999px;
      padding: 0.25rem 0.65rem;
      min-height: 30px;
      font-size: 0.78rem;
      cursor: pointer;
      color: var(--text-muted);
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .quick-pill:hover {
      border-color: var(--accent-teal);
      color: var(--accent-teal);
      background: var(--bg-surface);
    }
    .filter-tab {
      background: transparent;
      border: 1px solid transparent;
      padding: 0.4rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.15s ease;
      min-height: 36px;
    }
    .filter-tab:hover {
      color: var(--text-main);
      background: var(--bg-subtle);
    }
    .filter-tab.active {
      color: var(--accent-teal);
      background: var(--bg-surface);
      border-color: var(--accent-teal);
    }
    .search-hl {
      background: rgba(20, 184, 166, 0.2);
      color: inherit;
      padding: 0 0.2rem;
      border-radius: 2px;
      font-weight: 600;
    }
    .result-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
      position: relative;
      max-width: 100%;
      box-sizing: border-box;
    }
    @media (max-width: 640px) {
      .result-card {
        padding: 1rem 0.85rem;
      }
      #search-btn {
        padding: 0.65rem 0.85rem !important;
      }
    }
    .result-card:hover {
      border-color: var(--accent-teal);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.06);
    }
    .action-btn-sm {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--bg-subtle);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-sm);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      min-height: 38px;
      transition: all 0.15s ease;
    }
    .action-btn-sm:hover {
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      border-color: var(--btn-primary-bg);
    }
    .action-btn-primary {
      background: var(--btn-primary-bg);
      color: var(--btn-primary-text);
      border-color: var(--btn-primary-bg);
    }
    .action-btn-primary:hover {
      background: var(--btn-primary-hover);
      color: var(--btn-primary-text);
    }
  </style>

  <script>
    import { search, type SearchResult } from "../lib/search/engine.ts";
    import { getAyahAudioCandidates } from "../lib/audio/cdn.ts";

    const input = document.getElementById("search-input") as HTMLInputElement;
    const btn = document.getElementById("search-btn");
    const clearBtn = document.getElementById("clear-btn");
    const container = document.getElementById("results-container");
    const meta = document.getElementById("results-meta");
    const filterBar = document.getElementById("filter-bar");
    const speedEl = document.getElementById("search-speed");
    const audioPlayer = document.getElementById("global-preview-player") as HTMLAudioElement;

    const countAll = document.getElementById("count-all");
    const countSurah = document.getElementById("count-surah");
    const countVerse = document.getElementById("count-verse");
    const countConcept = document.getElementById("count-concept");

    let currentResults: SearchResult[] = [];
    let activeFilter = "all";
    let activePlayingRef: string | null = null;
    let currentCandidates: string[] = [];
    let currentCandidateIdx = 0;
    let isAudioPending = false;
    let audioSessionId = 0;
    let debounceTimer: any = null;

    // Toggle clear button and debounced live search
    input?.addEventListener("input", () => {
      const val = input.value.trim();
      if (clearBtn) {
        clearBtn.style.display = val ? "block" : "none";
      }

      clearTimeout(debounceTimer);
      if (val.length >= 2) {
        debounceTimer = setTimeout(() => {
          executeSearch(val);
        }, 220);
      } else if (val.length === 0) {
        if (activePlayingRef) {
          audioSessionId++;
          audioPlayer.pause();
          activePlayingRef = null;
        }
        if (container) container.innerHTML = "";
        if (filterBar) filterBar.style.display = "none";
        if (meta) meta.style.display = "none";
        window.history.replaceState({}, "", window.location.pathname);
      }
    });

    clearBtn?.addEventListener("click", () => {
      if (input) {
        if (activePlayingRef) {
          audioSessionId++;
          audioPlayer.pause();
          activePlayingRef = null;
        }
        input.value = "";
        input.focus();
        if (clearBtn) clearBtn.style.display = "none";
        if (container) container.innerHTML = "";
        if (filterBar) filterBar.style.display = "none";
        if (meta) meta.style.display = "none";
        window.history.replaceState({}, "", window.location.pathname);
      }
    });

    // Keyboard shortcut '/' to search
    window.addEventListener("keydown", (e) => {
      if (e.key === "/" && document.activeElement !== input) {
        e.preventDefault();
        input?.focus();
        input?.select();
      }
    });

    function highlightTerms(text: string, query: string): string {
      if (!text || !query) return text;
      const terms = query
        .toLowerCase()
        .replace(/[^a-z0-9\u0600-\u06FF\u0980-\u09FF\s]/g, "")
        .split(/\s+/)
        .filter((t) => /[\u0600-\u06FF]/.test(t) ? t.length >= 2 : t.length >= 3);

      if (terms.length === 0) return text;

      try {
        const pattern = new RegExp(`(${terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})`, "gi");
        return text.replace(pattern, '<mark class="search-hl">$1</mark>');
      } catch {
        return text;
      }
    }

    function renderFilteredResults() {
      if (!container) return;

      const filtered = currentResults.filter((r) => {
        if (activeFilter === "surah") return r.is_surah;
        if (activeFilter === "verse") return !r.is_surah && (r.matchType === "reference" || r.matchType === "text" || r.matchType === "phrase" || r.matchType === "arabic");
        if (activeFilter === "concept") return r.matchType === "concept" || r.matchType === "entity";
        return true;
      });

      if (meta) {
        meta.textContent = `Showing ${filtered.length} of ${currentResults.length} matches for "${input?.value.trim() || ""}"`;
        meta.style.display = "block";
      }

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="result-card" style="text-align: center; padding: 3rem 1.5rem;">
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🔍</div>
            <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">
              No results in this category
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem;">
              Try switching back to the "All Results" tab to view all matching verses.
            </p>
          </div>
        `;
        return;
      }

      container.innerHTML = filtered
        .map((r) => {
          const sPadded = String(r.s).padStart(3, "0");
          const aPadded = String(r.a).padStart(3, "0");
          const audioUrl = `https://everyayah.com/data/Alafasy_64kbps/${sPadded}${aPadded}.mp3`;
          const isPlaying = activePlayingRef === r.ref;

          // Surah Showcase Card
          if (r.is_surah) {
            return `
              <article class="result-card" style="border-top: 4px solid var(--accent-gold); background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-subtle) 100%);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
                  <div>
                    <span class="badge badge-gold" style="font-size: 0.8rem; margin-bottom: 0.35rem; display: inline-block;">
                      ⭐ Surah Match
                    </span>
                    <h2 style="font-size: 1.85rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.2rem;">
                      Surah ${r.surah_translit} (${r.s})
                    </h2>
                    <div style="font-size: 1.1rem; color: var(--text-muted);">
                      ${r.surah_name_en} · <span class="bangla-text" lang="bn">${r.surah_name_bn}</span>
                    </div>
                  </div>
                  <div
                    class="arabic-text arabic-display"
                    lang="ar"
                    dir="rtl"
                    style="--arabic-font-size: 2.5rem; font-size: 2.5rem; color: var(--accent-teal); line-height: 2.1; padding-bottom: 0.35rem;"
                  >
                    ${r.surah_name_ar}
                  </div>
                </div>

                <div style="display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap; font-size: 0.85rem; color: var(--text-muted);">
                  <span class="badge" style="background: var(--bg-surface); border: 1px solid var(--border-color);">${r.total_ayat || 0} Total Ayat</span>
                  <span class="badge" style="background: var(--bg-surface); border: 1px solid var(--border-color);">${r.surah_type || "Quranic"} Revelation</span>
                </div>

                <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
                  <a href="/surah/${r.s}" class="action-btn-sm action-btn-primary">
                    Open Full Surah View →
                  </a>
                  <a href="/ayah/${r.s}/1" class="action-btn-sm">
                    Read Ayah 1 & Tafsir
                  </a>
                </div>
              </article>
            `;
          }

          // Ayah Result Card
          return `
            <article class="result-card" id="card-${r.s}-${r.a}">
              <!-- Card Header -->
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <a href="/ayah/${r.s}/${r.a}" class="badge badge-teal" style="font-size: 0.85rem; font-weight: 700; text-decoration: none;">
                    Surah ${r.surah_translit} ${r.s}:${r.a}
                  </a>
                  <span class="bangla-text" lang="bn" style="font-size: 0.85rem; color: var(--text-muted);">
                    ${r.surah_name_bn}
                  </span>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  ${r.title ? `<span class="badge badge-gold" style="font-size: 0.75rem; font-weight: 700;">${r.title}</span>` : ""}
                  <span class="badge" style="background: var(--bg-subtle); color: var(--text-muted); font-size: 0.75rem;">
                    ${r.matchType} (Score: ${r.score})
                  </span>
                </div>
              </div>

              <!-- Sacred Arabic Text -->
              <div class="arabic-text" lang="ar" dir="rtl" style="--arabic-font-size: 1.85rem; line-height: 2.2; margin-bottom: 0.75rem; color: var(--text-arabic);">
                ${r.ar_u || r.ar}
                <span aria-hidden="true" style="display: inline-block; font-size: 1.25rem; color: var(--accent-teal); margin-right: 0.35rem;">
                  ۝
                </span>
              </div>

              <!-- English Transliteration -->
              ${
                r.tr
                  ? `
                <div style="font-size: 0.95rem; font-style: italic; color: var(--accent-gold); margin-top: 0.5rem; margin-bottom: 1.15rem; line-height: 1.5; font-family: var(--font-latin);">
                  ${r.tr}
                </div>
              `
                  : ""
              }

              <!-- Translations with Highlighting -->
              <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 1.5rem;">
                <!-- English -->
                <div>
                  <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.2rem;">
                    English Translation (Saheeh International)
                  </div>
                  <div style="font-size: 1.05rem; line-height: 1.6; color: var(--text-main);">
                    ${highlightTerms(r.en, input?.value || "")}
                  </div>
                </div>

                <!-- Bangla -->
                <div>
                  <div style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.2rem;">
                    বাংলা অনুবাদ (আবু বকর জাকারিয়া)
                  </div>
                  <div class="bangla-text" lang="bn" style="font-size: 1rem; line-height: 1.7; color: var(--text-main);">
                    ${highlightTerms(r.bn, input?.value || "")}
                  </div>
                </div>
              </div>

              <!-- Action Bar -->
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed var(--border-color); padding-top: 1rem; flex-wrap: wrap; gap: 0.75rem;">
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                  <button
                    class="btn-action btn-action-sm play-audio-btn ${isPlaying ? 'btn-action-primary' : ''}"
                    data-surah="${r.s}"
                    data-ayah="${r.a}"
                    data-ref="${r.ref}"
                    aria-label="Play recitation for verse ${r.ref}"
                  >
                    <span class="btn-icon-slot">
                      ${isPlaying ? 
                        '<svg class="icon-svg" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" fill="currentColor"></rect><rect x="14" y="4" width="4" height="16" fill="currentColor"></rect></svg>' : 
                        '<svg class="icon-svg" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon></svg>'
                      }
                    </span>
                    <span class="btn-label-slot">${isPlaying ? "Pause" : "Listen"}</span>
                  </button>
                  <button
                    class="btn-action btn-action-sm copy-btn"
                    data-ref="${r.ref}"
                    data-ar="${encodeURIComponent(r.ar_u || r.ar || '')}"
                    data-en="${encodeURIComponent(r.en || '')}"
                    data-bn="${encodeURIComponent(r.bn || '')}"
                    aria-label="Copy verse text"
                  >
                    <svg class="icon-svg" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    <span>Copy</span>
                  </button>
                  <a href="/surah/${r.s}#ayah-${r.a}" class="btn-action btn-action-sm">
                    <svg class="icon-svg" viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                    <span>Surah Context</span>
                  </a>
                </div>

                <a href="/ayah/${r.s}/${r.a}" class="btn-action btn-action-sm btn-action-primary">
                  <span>Study Ayah & Tafsir</span>
                  <svg class="icon-svg" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
              </div>
            </article>
          `;
        })
        .join("");

      attachActionHandlers();
    }

    const PLAY_ICON_HTML = '<svg class="icon-svg" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon></svg>';
    const PAUSE_ICON_HTML = '<svg class="icon-svg" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16" fill="currentColor"></rect><rect x="14" y="4" width="4" height="16" fill="currentColor"></rect></svg>';
    const CHECK_ICON_HTML = '<svg class="icon-svg" viewBox="0 0 24 24" style="stroke: var(--accent-green);"><polyline points="20 6 9 17 4 12"></polyline></svg>';
    const COPY_ICON_HTML = '<svg class="icon-svg" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';

    function updateAllPlayButtons() {
      document.querySelectorAll(".play-audio-btn").forEach((b) => {
        const r = b.getAttribute("data-ref");
        const ic = b.querySelector(".btn-icon-slot");
        const lb = b.querySelector(".btn-label-slot");
        const isThisPlaying = r === activePlayingRef;
        if (ic) ic.innerHTML = isThisPlaying ? PAUSE_ICON_HTML : PLAY_ICON_HTML;
        if (lb) lb.textContent = isThisPlaying ? "Pause" : "Listen";
        if (isThisPlaying) {
          b.classList.add("btn-action-primary");
        } else {
          b.classList.remove("btn-action-primary");
        }
      });
    }

    function safePlayPreview(sessionId: number) {
      isAudioPending = true;
      const playPromise = audioPlayer.play();
      if (playPromise !== undefined) {
        playPromise
          .then(() => {
            isAudioPending = false;
            if (sessionId !== audioSessionId || !activePlayingRef) {
              audioPlayer.pause();
              updateAllPlayButtons();
            } else {
              updateAllPlayButtons();
            }
          })
          .catch((err) => {
            isAudioPending = false;
            if (err && err.name === "AbortError") {
              return;
            }
            console.warn("Search preview play error:", err);
            if (sessionId === audioSessionId && activePlayingRef) {
              handleSearchAudioError();
            }
          });
      } else {
        isAudioPending = false;
      }
    }

    function handleSearchAudioError() {
      if (currentCandidateIdx + 1 < currentCandidates.length) {
        currentCandidateIdx++;
        console.info(`Retrying search preview on fallback mirror: ${currentCandidates[currentCandidateIdx]}`);
        audioPlayer.src = currentCandidates[currentCandidateIdx];
        safePlayPreview(audioSessionId);
      } else {
        console.warn("All audio mirrors failed for search preview", activePlayingRef);
        const failedRef = activePlayingRef;
        activePlayingRef = null;
        audioPlayer.pause();
        updateAllPlayButtons();
        if (typeof (window as any).showQgToast === "function") {
          (window as any).showQgToast(`Audio preview unavailable for verse ${failedRef}`);
        }
      }
    }

    audioPlayer?.addEventListener("error", () => {
      if (activePlayingRef) {
        handleSearchAudioError();
      }
    });

    audioPlayer?.addEventListener("ended", () => {
      activePlayingRef = null;
      updateAllPlayButtons();
    });

    function attachActionHandlers() {
      // Audio play buttons
      document.querySelectorAll(".play-audio-btn").forEach((btnEl) => {
        btnEl.addEventListener("click", () => {
          const ref = btnEl.getAttribute("data-ref");
          const s = parseInt(btnEl.getAttribute("data-surah") || "0", 10);
          const a = parseInt(btnEl.getAttribute("data-ayah") || "0", 10);
          if (!ref || !s || !a) return;

          if (activePlayingRef === ref && !audioPlayer.paused) {
            audioSessionId++;
            audioPlayer.pause();
            activePlayingRef = null;
            updateAllPlayButtons();
          } else {
            audioSessionId++;
            const thisSession = audioSessionId;
            activePlayingRef = ref;
            currentCandidates = getAyahAudioCandidates(s, a, "Alafasy_64kbps");
            currentCandidateIdx = 0;
            audioPlayer.src = currentCandidates[0];
            updateAllPlayButtons();
            safePlayPreview(thisSession);
          }
        });
      });

      // Copy buttons
      document.querySelectorAll(".copy-btn").forEach((btnEl) => {
        btnEl.addEventListener("click", () => {
          const ref = btnEl.getAttribute("data-ref") || "";
          const ar = decodeURIComponent(btnEl.getAttribute("data-ar") || "");
          const en = decodeURIComponent(btnEl.getAttribute("data-en") || "");
          const bn = decodeURIComponent(btnEl.getAttribute("data-bn") || "");

          const origin = window.location.origin || "https://qurangraph.iliassami57.workers.dev";
          const textToCopy = `Quran (${ref})\n\n${ar}\n\nEnglish: ${en}\n\nবাংলা: ${bn}\n\n${origin}/ayah/${ref.replace(":", "/")}`;
          navigator.clipboard.writeText(textToCopy).then(() => {
            const originalSvg = btnEl.querySelector("svg");
            const spanText = btnEl.querySelector("span");
            if (spanText) spanText.textContent = "Copied!";
            if (originalSvg) originalSvg.outerHTML = CHECK_ICON_HTML;
            (window as any).showQgToast?.(`Ayah ${ref} copied to clipboard`);
            setTimeout(() => {
              const currentSvg = btnEl.querySelector("svg");
              if (spanText) spanText.textContent = "Copy";
              if (currentSvg) currentSvg.outerHTML = COPY_ICON_HTML;
            }, 2000);
          }).catch(console.error);
        });
      });
    }

    // Filter tab clicks and Arrow navigation
    const allFilterTabs = Array.from(document.querySelectorAll(".filter-tab")) as HTMLButtonElement[];
    allFilterTabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => {
        allFilterTabs.forEach((t) => {
          t.classList.remove("active");
          t.setAttribute("aria-selected", "false");
        });
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        activeFilter = tab.getAttribute("data-filter") || "all";
        renderFilteredResults();
      });

      tab.addEventListener("keydown", (e) => {
        let targetIdx = -1;
        if (e.key === "ArrowRight") {
          targetIdx = (idx + 1) % allFilterTabs.length;
        } else if (e.key === "ArrowLeft") {
          targetIdx = (idx - 1 + allFilterTabs.length) % allFilterTabs.length;
        }
        if (targetIdx !== -1) {
          e.preventDefault();
          allFilterTabs[targetIdx].focus();
          allFilterTabs[targetIdx].click();
        }
      });
    });

    function executeSearch(rawQ: string) {
      const q = rawQ.trim();
      if (!q || !container) return;

      // Stop any existing playing audio preview cleanly
      if (activePlayingRef) {
        audioSessionId++;
        audioPlayer.pause();
        activePlayingRef = null;
      }

      if (clearBtn) clearBtn.style.display = "block";

      const t0 = performance.now();
      const results = search(q, 20);
      const t1 = performance.now();
      const durationMs = t1 - t0;

      currentResults = results;

      // Update URL query string without reloading
      const url = new URL(window.location.href);
      url.searchParams.set("q", q);
      window.history.replaceState({}, "", url.toString());

      if (results.length === 0) {
        if (filterBar) filterBar.style.display = "none";
        if (meta) meta.style.display = "none";

        container.innerHTML = `
          <div class="result-card" style="text-align: center; padding: 3.5rem 1.5rem;">
            <div style="font-size: 3rem; margin-bottom: 1rem;">📖</div>
            <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">
              No exact matches found for "${q}"
            </h2>
            <p style="color: var(--text-muted); font-size: 1rem; max-width: 500px; margin: 0 auto 1.75rem; line-height: 1.6;">
              Check your spelling or try searching with simpler words, English translations, Arabic root, or direct verse numbers (e.g. <em>"2:255"</em>).
            </p>

            <div style="text-align: left; background: var(--bg-subtle); padding: 1.25rem; border-radius: var(--radius-sm); max-width: 520px; margin: 0 auto;">
              <div style="font-size: 0.85rem; font-weight: 700; color: var(--accent-teal); margin-bottom: 0.5rem;">
                Suggested Searches:
              </div>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <button class="quick-pill" data-query="ayatul kursi">ayatul kursi</button>
                <button class="quick-pill" data-query="surah yasin">surah yasin</button>
                <button class="quick-pill" data-query="2:255">2:255</button>
                <button class="quick-pill" data-query="patience">patience</button>
                <button class="quick-pill" data-query="forgiveness">forgiveness</button>
                <button class="quick-pill" data-query="surah mulk">surah mulk</button>
              </div>
            </div>
          </div>
        `;

        // Re-attach suggestion pills
        container.querySelectorAll(".quick-pill").forEach((pill) => {
          pill.addEventListener("click", () => {
            const query = (pill as HTMLElement).dataset.query || "";
            if (input) input.value = query;
            executeSearch(query);
          });
        });
        return;
      }

      // Counts for filter tabs
      const surahCount = results.filter((r) => r.is_surah).length;
      const verseCount = results.filter((r) => !r.is_surah && (r.matchType === "reference" || r.matchType === "text" || r.matchType === "phrase" || r.matchType === "arabic")).length;
      const conceptCount = results.filter((r) => r.matchType === "concept" || r.matchType === "entity").length;

      if (countAll) countAll.textContent = String(results.length);
      if (countSurah) countSurah.textContent = String(surahCount);
      if (countVerse) countVerse.textContent = String(verseCount);
      if (countConcept) countConcept.textContent = String(conceptCount);

      if (filterBar) filterBar.style.display = "block";
      if (speedEl) speedEl.textContent = `Found ${results.length} results in ${durationMs.toFixed(1)} ms`;

      renderFilteredResults();
    }

    // Event listeners
    btn?.addEventListener("click", () => {
      if (input) executeSearch(input.value);
    });

    input?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        executeSearch(input.value);
      }
    });

    // Quick pills
    document.querySelectorAll(".quick-pill").forEach((pill) => {
      pill.addEventListener("click", () => {
        const q = (pill as HTMLElement).dataset.query || "";
        if (input) {
          input.value = q;
          executeSearch(q);
        }
      });
    });

    // Initial search on page load from ?q= parameter
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q");
    if (initialQuery && input) {
      input.value = initialQuery;
      executeSearch(initialQuery);
    }
  </script>
</Layout>
