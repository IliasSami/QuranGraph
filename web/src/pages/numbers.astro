---
import Layout from "../layouts/Layout.astro";
import numbersData from "../../../ingest/work/numbers_lab.json" with { type: "json" };

const { baseline, vocabulary_coverage, audited_claims } = numbersData;
---

<Layout title="Numbers Lab — Transparent, Honest Quranic Statistics">
  <div style="padding: 3.5rem 0 2rem; background: var(--bg-surface); border-bottom: 1px solid var(--border-color);">
    <div class="container" style="max-width: 900px;">
      <div class="badge badge-gold" style="margin-bottom: 0.75rem;">Reproducible Data · No Mysticism</div>
      <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem;">Quran Numbers Lab</h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.6;">
        Every count in the Quran depends on clear rules: script edition, morphology vs whitespace words, and whether prefixes or plurals are included. Here, every number is verifiable, reproducible, and documented with its exact counting methodology.
      </p>
    </div>
  </div>

  <div style="padding: 3rem 0;">
    <div class="container" style="max-width: 900px;">
      <!-- Baseline Cards -->
      <div style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.25rem;">1. Core Baseline Facts</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem;">
          <div class="card">
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Surahs</div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--accent-teal);">{baseline.surahs}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">86 Meccan, 28 Medinan</div>
          </div>

          <div class="card">
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Ayat (Verses)</div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--accent-teal);">{baseline.ayat.toLocaleString()}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Standard Kufan count</div>
          </div>

          <div class="card">
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Words (Morphology)</div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--accent-teal);">{baseline.words_morphology.toLocaleString()}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">77,800 whitespace words</div>
          </div>

          <div class="card">
            <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;">Letters (Simple Text)</div>
            <div style="font-size: 2rem; font-weight: 800; color: var(--accent-teal);">{baseline.letters_total.toLocaleString()}</div>
            <div style="font-size: 0.75rem; color: var(--text-muted);">Excluding whitespace</div>
          </div>
        </div>
      </div>

      <!-- Vocabulary Coverage Curve -->
      <div style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">2. The Vocabulary Coverage Curve (Zipf's Law)</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
          How many words must a beginner learn to understand the majority of the Quran? Because language follows Zipf's distribution, a tiny fraction of core roots and lemmas makes up the majority of text recited.
        </p>

        <div class="card">
          <!-- Visual Milestone Bar -->
          <div style="background: var(--bg-subtle); padding: 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; border: 1px solid var(--border-color);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-size: 0.85rem; font-weight: 700;">
              <span>Zipf Learning Milestone: 50% Recitation Comprehension</span>
              <span style="color: var(--accent-gold);">58 Core Lemmas</span>
            </div>
            <div style="height: 12px; width: 100%; background: var(--border-color); border-radius: 9999px; overflow: hidden; position: relative;">
              <div style="height: 100%; width: 50%; background: linear-gradient(90deg, var(--accent-teal), var(--accent-gold)); border-radius: 9999px;"></div>
            </div>
            <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.4rem;">
              <span>0% (0 words)</span>
              <span>50% (58 words)</span>
              <span>70% (250 words)</span>
              <span>100% (77,429 words)</span>
            </div>
          </div>

          <div style="overflow-x: auto;">
            <table style="width: 100%; min-width: 500px; border-collapse: collapse; text-align: left; font-size: 0.95rem;">
              <thead>
                <tr style="border-bottom: 2px solid var(--border-color); color: var(--text-muted);">
                  <th style="padding: 0.75rem;">Recitation Coverage</th>
                  <th style="padding: 0.75rem;">Unique Lemmas Needed</th>
                  <th style="padding: 0.75rem;">Unique Roots Needed</th>
                  <th style="padding: 0.75rem;">Word Forms Needed</th>
                </tr>
              </thead>
              <tbody>
                {vocabulary_coverage.curve.map((step: any) => (
                  <tr style="border-bottom: 1px solid var(--border-color);">
                    <td style="padding: 0.85rem; font-weight: 700; color: var(--accent-teal);">
                      {step.target_coverage_pct}% of the Quran
                    </td>
                    <td style="padding: 0.85rem; font-weight: 600;">
                      {step.lemmas_needed} lemmas
                    </td>
                    <td style="padding: 0.85rem;">
                      {step.roots_needed} roots
                    </td>
                    <td style="padding: 0.85rem; color: var(--text-muted);">
                      {step.word_forms_needed?.toLocaleString()}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div style="margin-top: 1rem; font-size: 0.85rem; color: var(--text-muted); font-style: italic;">
            Data computed directly from the Quranic Arabic Corpus morphological segmentation of all 77,429 words.
          </div>
        </div>
      </div>

      <!-- Audited Numerical Claims -->
      <div style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem;">3. Audited Popular Numerical Claims</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
          Popular internet claims evaluated rigorously against reproducible SQL queries. We label every claim objectively with its exact mathematical condition and scholarly assessment.
        </p>

        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          {audited_claims.map((claim: any) => (
            <article class="card">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--text-main);">
                  {claim.title_en}
                </h3>
                <span
                  class="badge"
                  style={{
                    background:
                      claim.status === "Verified"
                        ? "var(--accent-teal-subtle)"
                        : claim.status.includes("Depends")
                        ? "var(--accent-gold-subtle)"
                        : "#fee2e2",
                    color:
                      claim.status === "Verified"
                        ? "var(--accent-teal)"
                        : claim.status.includes("Depends")
                        ? "var(--accent-gold)"
                        : "var(--danger)"
                  }}
                >
                  {claim.status}
                </span>
              </div>

              <div class="bangla-text" style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0.75rem;">
                {claim.title_bn}
              </div>

              <div style="background: var(--bg-subtle); padding: 0.85rem 1rem; border-radius: var(--radius-sm); margin-bottom: 0.75rem; font-size: 0.9rem;">
                <strong style="color: var(--text-main);">Exact Counting Rule:</strong> {claim.rule}
              </div>

              <p style="font-size: 0.95rem; color: var(--text-muted); line-height: 1.6;">
                {claim.scholar_note}
              </p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
