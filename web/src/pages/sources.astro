---
import Layout from "../layouts/Layout.astro";
import sourcesManifest from "../lib/search/sources_manifest.json" with { type: "json" };
---

<Layout title="Sources, Licences & Methodology — QuranGraph">
  <div style="padding: 3.5rem 0 2rem; background: var(--bg-surface); border-bottom: 1px solid var(--border-color);">
    <div class="container" style="max-width: 860px;">
      <div class="badge badge-teal" style="margin-bottom: 0.75rem;">Integrity & Transparency</div>
      <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem;">Sources & Methodology</h1>
      <p style="font-size: 1.1rem; color: var(--text-muted); line-height: 1.6;">
        QuranGraph operates with non-negotiable rules of scholarly integrity, license adherence, and byte-level verification.
      </p>
    </div>
  </div>

  <div style="padding: 3rem 0;">
    <div class="container" style="max-width: 860px;">
      <!-- Core Principles -->
      <div class="card" style="margin-bottom: 3rem; border-left: 4px solid var(--accent-teal);">
        <h2 style="font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;">Core Editorial Rules</h2>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.95rem; line-height: 1.6;">
          <li>
            <strong>1. Verbatim Quran Text:</strong> Displayed Arabic is drawn strictly from Tanzil (Uthmani script) and is never edited, modified, or generated by AI.
          </li>
          <li>
            <strong>2. Verbatim Display Translations:</strong> English (Saheeh International) and Bangla (Dr. Abu Bakr Muhammad Zakaria) translations and displayed tafsirs (Al-Mukhtasar, Al-Muyassar) are shown verbatim from QuranEnc at pinned SHA-256 releases.
          </li>
          <li>
            <strong>3. Grounding Integrity:</strong> Historical commentaries used for AI fact-checking (Ibn Kathir, Ma'ariful Quran, Jalalayn) serve solely as grounding context and are never shipped in website files.
          </li>
          <li>
            <strong>4. Zero Invented Rulings:</strong> Explanations teach meanings without issuing legal (fiqh) edicts. Scholarly differences of opinion are explicitly stated and attributed.
          </li>
        </ul>
      </div>

      <!-- Published Display Sources Manifest -->
      <div style="margin-bottom: 3rem;">
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.25rem;">Published Sources & Licences</h2>
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {sourcesManifest.map((s: any) => (
            <div class="card">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                <div>
                  <span class="badge badge-teal" style="font-size: 0.75rem; margin-bottom: 0.25rem;">{s.id}</span>
                  <h3 style="font-size: 1.15rem; font-weight: 700;">{s.title}</h3>
                </div>
                <span class="badge" style="background: var(--bg-subtle); color: var(--text-muted); font-size: 0.75rem;">
                  Licence: {s.licence}
                </span>
              </div>
              <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                Publisher: {s.publisher} {s.lang ? `· Language: ${s.lang.toUpperCase()}` : ""}
              </p>
              <div style="font-size: 0.85rem; color: var(--text-main); background: var(--bg-subtle); padding: 0.5rem 0.75rem; border-radius: var(--radius-sm);">
                <strong>Attribution:</strong> {s.attribution}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
