---
import Layout from "../../../layouts/Layout.astro";
import surahsData from "../../../lib/search/surahs.json" with { type: "json" };
import corpusData from "../../../lib/search/corpus.json" with { type: "json" };
import similarData from "../../../../../ingest/work/export/graph/similar_ayat.json" with { type: "json" };
import fs from "node:fs";
import path from "node:path";

export function getStaticPaths() {
  const explainDir = path.resolve("../ingest/content/explain");
  const paths: any[] = [];

  // Generate paths for all explained ayat
  if (fs.existsSync(explainDir)) {
    const surahFolders = fs.readdirSync(explainDir);
    for (const sFolder of surahFolders) {
      const sNum = parseInt(sFolder, 10);
      const sDirPath = path.join(explainDir, sFolder);
      if (fs.statSync(sDirPath).isDirectory()) {
        const aFiles = fs.readdirSync(sDirPath).filter((f) => f.endsWith(".json"));
        for (const aFile of aFiles) {
          const aNum = parseInt(aFile.replace(".json", ""), 10);
          paths.push({
            params: { surah: String(sNum), ayah: String(aNum) }
          });
        }
      }
    }
  }

  // Also ensure 2:255 (Ayat al-Kursi) is generated
  if (!paths.some((p) => p.params.surah === "2" && p.params.ayah === "255")) {
    paths.push({ params: { surah: "2", ayah: "255" } });
  }

  return paths;
}

const { surah: sParam, ayah: aParam } = Astro.params;
const sId = parseInt(sParam!, 10);
const aNum = parseInt(aParam!, 10);

const surah = surahsData.find((s) => s.id === sId)!;
const ayahRecord = corpusData.find((c) => c.s === sId && c.a === aNum)!;

// Load explanation JSON if available
let explanation: any = null;
const explainFile = path.resolve(
  `../ingest/content/explain/${String(sId).padStart(3, "0")}/${String(aNum).padStart(3, "0")}.json`
);
if (fs.existsSync(explainFile)) {
  explanation = JSON.parse(fs.readFileSync(explainFile, "utf-8"));
}

const refKey = `${sId}:${aNum}`;
const similarVerses = (similarData as Record<string, any[]>)[refKey] || [];

const prevAyah = aNum > 1 ? aNum - 1 : null;
const nextAyah = aNum < surah.ayat ? aNum + 1 : null;
---

<Layout title={`${surah.name_translit} ${sId}:${aNum} — Deep Ayah Study & Explanation`}>
  <div style="padding: 2.5rem 0;">
    <div class="container" style="max-width: 860px;">
      <!-- Breadcrumb & Nav -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; font-size: 0.9rem; color: var(--text-muted);">
        <div>
          <a href="/surahs">Surahs</a> / <a href={`/surah/${sId}`}>{surah.name_translit}</a> / <span>Ayah {aNum}</span>
        </div>
        <div style="display: flex; gap: 0.5rem;">
          {prevAyah && <a href={`/ayah/${sId}/${prevAyah}`} class="btn-icon">← Prev ({prevAyah})</a>}
          {nextAyah && <a href={`/ayah/${sId}/${nextAyah}`} class="btn-icon">Next ({nextAyah}) →</a>}
        </div>
      </div>

      <!-- Ayah Main Card -->
      <div class="card" style="margin-bottom: 2rem; border-top: 4px solid var(--accent-teal);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <span class="badge badge-teal" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">
            Surah {surah.name_translit} ({sId}:{aNum})
          </span>
          <div class="bangla-text" style="color: var(--text-muted); font-size: 0.9rem;">
            {surah.name_bn}
          </div>
        </div>

        <!-- Arabic Text -->
        <div class="arabic-text" style="font-size: 2.5rem; line-height: 2.3; margin-bottom: 2rem; color: var(--text-arabic);">
          {ayahRecord.ar}
          <span style="display: inline-block; font-size: 1.5rem; color: var(--accent-teal); margin-right: 0.5rem;">
            ۝
          </span>
        </div>

        <!-- Translations -->
        <div style="display: flex; flex-direction: column; gap: 1.25rem; border-top: 1px solid var(--border-color); padding-top: 1.5rem;">
          <div>
            <div style="font-size: 0.8rem; font-weight: 700; color: var(--accent-teal); text-transform: uppercase; margin-bottom: 0.25rem;">
              English Translation (Saheeh International)
            </div>
            <div style="font-size: 1.15rem; line-height: 1.6; color: var(--text-main);">
              {ayahRecord.en}
            </div>
          </div>

          <div>
            <div style="font-size: 0.8rem; font-weight: 700; color: var(--accent-teal); text-transform: uppercase; margin-bottom: 0.25rem;">
              Bangla Translation (মুহিউদ্দীন খান / আবু বকর জাকারিয়া)
            </div>
            <div class="bangla-text" style="font-size: 1.05rem; line-height: 1.7; color: var(--text-main);">
              {ayahRecord.bn}
            </div>
          </div>
        </div>
      </div>

      {explanation ? (
        <div style="display: flex; flex-direction: column; gap: 2rem;">
          <!-- Simplified Teaching Explanation -->
          <div class="card">
            <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
              <span>💡</span> Simplified Explanation
            </h2>

            <div style="margin-bottom: 1.5rem;">
              <h3 style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.4rem;">
                Plain English Explanation
              </h3>
              <p style="font-size: 1.05rem; line-height: 1.65; color: var(--text-main);">
                {explanation.simple_en}
              </p>
            </div>

            <div style="border-top: 1px dashed var(--border-color); padding-top: 1.25rem;">
              <h3 style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 0.4rem;">
                সহজ বাংলা ব্যাখ্যা
              </h3>
              <p class="bangla-text" style="font-size: 1.05rem; line-height: 1.75; color: var(--text-main);">
                {explanation.simple_bn}
              </p>
            </div>
          </div>

          <!-- Lesson & Real Life Application -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
            <div class="card" style="border-left: 4px solid var(--accent-teal);">
              <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem;">
                🌱 Practical Lesson
              </h3>
              <p style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem;">
                {explanation.lesson_en}
              </p>
              <p class="bangla-text" style="font-size: 0.95rem; line-height: 1.7; color: var(--text-muted); border-top: 1px dashed var(--border-color); padding-top: 0.75rem;">
                {explanation.lesson_bn}
              </p>
            </div>

            <div class="card" style="border-left: 4px solid var(--accent-gold);">
              <h3 style="font-size: 1.1rem; font-weight: 700; margin-bottom: 0.75rem;">
                🧭 Real-Life Application
              </h3>
              <p style="font-size: 0.95rem; line-height: 1.6; margin-bottom: 1rem;">
                {explanation.real_life_en}
              </p>
              <p class="bangla-text" style="font-size: 0.95rem; line-height: 1.7; color: var(--text-muted); border-top: 1px dashed var(--border-color); padding-top: 0.75rem;">
                {explanation.real_life_bn}
              </p>
            </div>
          </div>

          <!-- Key Words Breakdown -->
          {explanation.key_words && explanation.key_words.length > 0 && (
            <div class="card">
              <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1rem;">
                🔍 Key Words & Linguistic Insight
              </h3>
              <div style="display: flex; flex-direction: column; gap: 1rem;">
                {explanation.key_words.map((kw: any) => (
                  <div style="background: var(--bg-subtle); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                      <div>
                        <span class="arabic-text" style="font-size: 1.4rem; font-weight: 700; color: var(--accent-teal);">
                          {kw.lemma}
                        </span>
                        {kw.root && (
                          <span style="font-size: 0.85rem; margin-left: 0.5rem; color: var(--text-muted);">
                            (Root: <span class="arabic-text">{kw.root}</span>)
                          </span>
                        )}
                      </div>
                      <div style="font-weight: 600; font-size: 0.95rem;">
                        {kw.meaning_en} <span class="bangla-text">({kw.meaning_bn})</span>
                      </div>
                    </div>
                    <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5;">
                      {kw.why_en}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Scholarly Grounding & Claims -->
          {explanation.claims && explanation.claims.length > 0 && (
            <div class="card">
              <h3 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.75rem;">
                📚 Scholarly Grounding & Citations
              </h3>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
                Every statement in our explanation is backed by authoritative classical tafsir.
              </p>
              <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.75rem;">
                {explanation.claims.map((claim: any) => (
                  <li style="padding-left: 1rem; border-left: 2px solid var(--accent-teal); font-size: 0.9rem; line-height: 1.5;">
                    <div style="color: var(--text-main); margin-bottom: 0.25rem;">
                      "{claim.text}"
                    </div>
                    <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                      {claim.sources.map((src: string) => (
                        <span class="badge" style="background: var(--bg-subtle); color: var(--text-muted); font-size: 0.7rem;">
                          {src}
                        </span>
                      ))}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Themes & Graph Links -->
          {explanation.themes && (
            <div class="card">
              <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.75rem;">
                🕸️ Connected Themes & Knowledge Graph
              </h3>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                {explanation.themes.map((t: string) => (
                  <a href={`/search?q=${encodeURIComponent(t)}`} class="badge badge-teal" style="text-decoration: none; font-size: 0.8rem; padding: 0.3rem 0.6rem;">
                    #{t}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Similar Verses -->
          {similarVerses.length > 0 && (
            <div class="card">
              <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.75rem;">
                🔗 Related & Similar Verses (Same Rare Vocabulary)
              </h3>
              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                {similarVerses.map((sim: any) => (
                  <a href={`/ayah/${sim.ayah.replace(':', '/')}`} style="display: flex; justify-content: space-between; padding: 0.6rem; background: var(--bg-subtle); border-radius: var(--radius-sm); text-decoration: none; color: inherit;">
                    <span style="font-weight: 600; color: var(--accent-teal);">Ayah {sim.ayah}</span>
                    <span style="font-size: 0.85rem; color: var(--text-muted);">
                      Shared lemmas: {sim.shared_lemmas?.join(", ")}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="card" style="text-align: center; padding: 3rem;">
          <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 1rem;">
            Detailed multi-layer explanation for this verse is scheduled for Phase 3 generation.
          </p>
          <a href="/surahs" class="btn-icon">← Browse Other Surahs</a>
        </div>
      )}
    </div>
  </div>
</Layout>
