---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "QuranGraph — The Connected Quran Knowledge System",
  description = "A connected, beginner-first Quran explorer joining concepts, stories, words, and statistics in English and Bangla."
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0f766e" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Inter:wght@400;500;600;700&family=Noto+Serif+Bengali:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const savedTheme = localStorage.getItem("qg_theme") || "light";
      document.documentElement.setAttribute("data-theme", savedTheme);

      const savedScale = localStorage.getItem("qg_arabic_scale") || "1";
      document.documentElement.style.setProperty("--arabic-scale", savedScale);

      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-container">
        <a href="/" class="logo">
          <span class="logo-symbol" aria-hidden="true">۞</span>
          <span>QuranGraph</span>
        </a>

        <nav aria-label="Main Navigation">
          <ul class="nav-links" id="main-nav-links">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/surahs" class="nav-link">Surahs</a></li>
            <li><a href="/search" class="nav-link">Search</a></li>
            <li><a href="/graph" class="nav-link">Graph</a></li>
            <li><a href="/numbers" class="nav-link">Numbers Lab</a></li>
            <li><a href="/learn" class="nav-link">Learn</a></li>
            <li><a href="/sources" class="nav-link">Sources</a></li>
          </ul>
        </nav>

        <div class="header-controls">
          <a id="last-read-nav" href="#" class="btn-icon" style="display: none;" title="Resume last read verse" aria-label="Resume last read verse">
            <span aria-hidden="true">📖</span>
            <span class="last-read-label" style="font-size: 0.8rem; margin-left: 0.25rem; font-weight: 600;">Last Read</span>
          </a>
          <div class="font-scale-control" role="group" aria-label="Arabic font size controls">
            <button id="font-scale-dec" class="btn-icon font-btn" aria-label="Decrease Arabic font size" title="Smaller Arabic text">A−</button>
            <button id="font-scale-inc" class="btn-icon font-btn" aria-label="Increase Arabic font size" title="Larger Arabic text">A+</button>
          </div>
          <button id="theme-toggle" class="btn-icon" aria-label="Toggle visual theme">
            🌓 Theme
          </button>
          <button id="mobile-nav-toggle" class="mobile-menu-btn" aria-label="Toggle navigation menu" aria-expanded="false">
            ☰
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <h3 style="font-weight: 700; margin-bottom: 0.5rem; color: var(--text-main);">QuranGraph</h3>
          <p style="margin-bottom: 1rem; max-width: 420px;">
            A transparent, connected exploration of the Holy Quran. Displayed Arabic text verbatim from Tanzil; translations and tafsir verbatim from QuranEnc.
          </p>
          <p style="font-size: 0.8rem; color: var(--text-muted);">
            Open scholarly references · No ads · Free & open knowledge
          </p>
        </div>

        <div>
          <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-main);">Study & Explore</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.4rem;">
            <li><a href="/surahs">Browse Surahs</a></li>
            <li><a href="/ayah/1/1">Al-Fatihah Study View</a></li>
            <li><a href="/ayah/2/255">Ayat al-Kursi</a></li>
            <li><a href="/graph">Knowledge Graph Explorer</a></li>
            <li><a href="/numbers">Numbers Lab</a></li>
          </ul>
        </div>

        <div>
          <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.75rem; color: var(--text-main);">Methodology & Integrity</h4>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.4rem;">
            <li><a href="/sources">Sources & Licences</a></li>
            <li><a href="/learn">Learning Paths</a></li>
            <li><a href="https://github.com" target="_blank" rel="noopener">Open Source Code</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script is:inline>
      const themes = ["light", "dark", "sepia"];
      const btn = document.getElementById("theme-toggle");
      btn?.addEventListener("click", () => {
        const current = document.documentElement.getAttribute("data-theme") || "light";
        const nextIdx = (themes.indexOf(current) + 1) % themes.length;
        const next = themes[nextIdx];
        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("qg_theme", next);
      });

      // Mobile Menu Management
      const navToggle = document.getElementById("mobile-nav-toggle");
      const navLinks = document.getElementById("main-nav-links");
      function setMobileMenu(open) {
        if (!navLinks || !navToggle) return;
        const willOpen = open !== undefined ? open : !navLinks.classList.contains("open");
        navLinks.classList.toggle("open", willOpen);
        navToggle.setAttribute("aria-expanded", willOpen ? "true" : "false");
        navToggle.textContent = willOpen ? "✕" : "☰";
      }
      navToggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        setMobileMenu();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && navLinks?.classList.contains("open")) {
          setMobileMenu(false);
        }
      });
      document.addEventListener("click", (e) => {
        if (navLinks?.classList.contains("open") && !navLinks.contains(e.target) && !navToggle?.contains(e.target)) {
          setMobileMenu(false);
        }
      });

      // Font Size Scaler
      const scaleDec = document.getElementById("font-scale-dec");
      const scaleInc = document.getElementById("font-scale-inc");
      function adjustScale(delta) {
        let cur = parseFloat(localStorage.getItem("qg_arabic_scale") || "1");
        cur = Math.min(Math.max(cur + delta, 0.8), 1.8);
        cur = Math.round(cur * 100) / 100;
        document.documentElement.style.setProperty("--arabic-scale", cur.toString());
        localStorage.setItem("qg_arabic_scale", cur.toString());
      }
      scaleDec?.addEventListener("click", () => adjustScale(-0.15));
      scaleInc?.addEventListener("click", () => adjustScale(0.15));

      // Last Read Resumption
      try {
        const savedLastRead = localStorage.getItem("qg_last_read");
        if (savedLastRead) {
          const lr = JSON.parse(savedLastRead);
          const lrEl = document.getElementById("last-read-nav");
          if (lrEl && lr.surah && lr.ayah) {
            lrEl.href = `/ayah/${lr.surah}/${lr.ayah}`;
            const label = lrEl.querySelector(".last-read-label");
            if (label) {
              label.textContent = `${lr.surah}:${lr.ayah}`;
            }
            lrEl.style.display = "inline-flex";
          }
        }
      } catch (err) {}

      // Global Toast Notification Helper
      window.showQgToast = function(msg, duration = 2200) {
        const toast = document.getElementById("qg-toast");
        const msgEl = document.getElementById("qg-toast-msg");
        if (!toast || !msgEl) return;
        msgEl.textContent = msg || "Copied to clipboard";
        toast.style.display = "flex";
        requestAnimationFrame(() => toast.classList.add("visible"));
        clearTimeout(toast._timer);
        toast._timer = setTimeout(() => {
          toast.classList.remove("visible");
          setTimeout(() => { toast.style.display = "none"; }, 220);
        }, duration);
      };
    </script>

    <!-- Global Floating Toast Notification -->
    <div id="qg-toast" role="status" aria-live="polite" class="qg-toast" style="display: none;">
      <svg class="icon-svg" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
      <span id="qg-toast-msg">Copied to clipboard</span>
    </div>
  </body>
</html>
