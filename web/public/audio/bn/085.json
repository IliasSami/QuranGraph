{
  "surah": 85,
  "name_translit": "Al-Burooj",
  "name_bn": "আল-বুরূজ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 77389,
  "total_ayat": 22,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1976,
      "duration_ms": 1976,
      "text": "শপথ বুরূজবিশিষ্ট আসমানের,"
    },
    {
      "ayah": 2,
      "start_ms": 1976,
      "end_ms": 3557,
      "duration_ms": 1581,
      "text": "আর প্রতিশ্রুত দিনের।"
    },
    {
      "ayah": 3,
      "start_ms": 3557,
      "end_ms": 5296,
      "duration_ms": 1739,
      "text": "এবং দ্রষ্টা ও দৃষ্টের।"
    },
    {
      "ayah": 4,
      "start_ms": 5296,
      "end_ms": 7904,
      "duration_ms": 2608,
      "text": "অভিশপ্ত হয়েছিল কুণ্ডের অধিপতিরা।"
    },
    {
      "ayah": 5,
      "start_ms": 7904,
      "end_ms": 10275,
      "duration_ms": 2371,
      "text": "যে কুণ্ডে ছিল ইন্ধনপূর্ণ আগুন,"
    },
    {
      "ayah": 6,
      "start_ms": 10275,
      "end_ms": 12567,
      "duration_ms": 2292,
      "text": "যখন তারা এর পাশে উপবিষ্ট ছিল।"
    },
    {
      "ayah": 7,
      "start_ms": 12567,
      "end_ms": 16599,
      "duration_ms": 4032,
      "text": "এবং তারা মুমিনদের সাথে যা করছিল তা প্রত্যক্ষ করছিল।"
    },
    {
      "ayah": 8,
      "start_ms": 16599,
      "end_ms": 25058,
      "duration_ms": 8459,
      "text": "আর তারা তাদেরকে নির্যাতন করেছিল শুধু এ কারণে যে, তারা ঈমান এনেছিল পরাক্রমশালী ও প্রশংসার যোগ্য আল্লাহর উপর।"
    },
    {
      "ayah": 9,
      "start_ms": 25058,
      "end_ms": 30829,
      "duration_ms": 5771,
      "text": "আসমানমূহ ও যমীনের সর্বময় কর্তৃত্ব যাঁর; আর আল্লাহ সবকিছুর প্রত্যক্ষদর্শী।"
    },
    {
      "ayah": 10,
      "start_ms": 30829,
      "end_ms": 41027,
      "duration_ms": 10198,
      "text": "নিশ্চয় যারা মুমিন নর নারীকে বিপদাপন্ন করেছে তারপর তাওবা করেনি তাদের জন্য আছে জাহান্নামের শাস্তি, আর তাদের জন্য আছে দহন যন্ত্রণা।"
    },
    {
      "ayah": 11,
      "start_ms": 41027,
      "end_ms": 49486,
      "duration_ms": 8459,
      "text": "নিশ্চয় যারা ঈমান এনেছে এবং সৎকাজ করেছে তাদের জন্য রয়েছে জান্নাত, যার পাদদেশে নদী প্রবাহিত; এটাই মহাসাফল্য।"
    },
    {
      "ayah": 12,
      "start_ms": 49486,
      "end_ms": 52411,
      "duration_ms": 2925,
      "text": "নিশ্চয় আপনার রবের পাকড়াও বড়ই কঠিন।"
    },
    {
      "ayah": 13,
      "start_ms": 52411,
      "end_ms": 55731,
      "duration_ms": 3320,
      "text": "তিনিই অস্তিত্ব দান করেন ও পুনরাবর্তন ঘটান।"
    },
    {
      "ayah": 14,
      "start_ms": 55731,
      "end_ms": 58181,
      "duration_ms": 2450,
      "text": "এবং তিনি ক্ষমাশীল, অতিস্নেহময়,"
    },
    {
      "ayah": 15,
      "start_ms": 58181,
      "end_ms": 60157,
      "duration_ms": 1976,
      "text": "আরশের অধিকারী ও সম্মানিত।"
    },
    {
      "ayah": 16,
      "start_ms": 60157,
      "end_ms": 62054,
      "duration_ms": 1897,
      "text": "তিনি যা ইচ্ছে তা ই করেন।"
    },
    {
      "ayah": 17,
      "start_ms": 62054,
      "end_ms": 65611,
      "duration_ms": 3557,
      "text": "আপনার কাছে কি পৌঁছেছে সৈন্যবাহিনীর বৃত্তান্ত।"
    },
    {
      "ayah": 18,
      "start_ms": 65611,
      "end_ms": 66955,
      "duration_ms": 1344,
      "text": "ফিরআউন ও সামূদের?"
    },
    {
      "ayah": 19,
      "start_ms": 66955,
      "end_ms": 69484,
      "duration_ms": 2529,
      "text": "তবু কাফিররা মিথ্যারোপ করায় রত;।"
    },
    {
      "ayah": 20,
      "start_ms": 69484,
      "end_ms": 73516,
      "duration_ms": 4032,
      "text": "আর আল্লাহ সবদিক থেকে তাদেরকে পরিবেষ্টন করে রয়েছেন।"
    },
    {
      "ayah": 21,
      "start_ms": 73516,
      "end_ms": 75571,
      "duration_ms": 2055,
      "text": "বস্তুত এটা সম্মানিত কুরআন,"
    },
    {
      "ayah": 22,
      "start_ms": 75571,
      "end_ms": 77389,
      "duration_ms": 1818,
      "text": "সংরক্ষিত ফলকে লিপিবদ্ধ।"
    }
  ]
}