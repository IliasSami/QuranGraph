{
  "surah": 93,
  "name_translit": "Ad-Dhuhaa",
  "name_bn": "আদ-দুহা",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 42575,
  "total_ayat": 11,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 100,
      "end_ms": 3900,
      "duration_ms": 3800,
      "text": "শপথ পূর্বাহ্নের,"
    },
    {
      "ayah": 2,
      "start_ms": 3850,
      "end_ms": 7987,
      "duration_ms": 4137,
      "text": "শপথ রাতের যখন তা হয় নিঝুম –।"
    },
    {
      "ayah": 3,
      "start_ms": 7987,
      "end_ms": 12499,
      "duration_ms": 4512,
      "text": "আপনার রব আপনাকে পরিত্যাগ করেন নি এবং শক্রতাও করেন নি।"
    },
    {
      "ayah": 4,
      "start_ms": 12500,
      "end_ms": 17725,
      "duration_ms": 5225,
      "text": "আর অবশ্যই আপনার জন্য পরবর্তী সময় পূর্ববতী সময়ের চেয়ে শ্রেয়।"
    },
    {
      "ayah": 5,
      "start_ms": 17725,
      "end_ms": 20712,
      "duration_ms": 2987,
      "text": "আর অচিরেই আপনার রব আপনাকে অনুগ্রহ দান করবেন, ফলে আপনি সন্তুষ্ট হবেন।"
    },
    {
      "ayah": 6,
      "start_ms": 20712,
      "end_ms": 23237,
      "duration_ms": 2525,
      "text": "তিনি কি আপনাকে ইয়াতীম অবস্থায় পান নি? অতঃপর তিনি আশ্রয় দিয়েছেন ;।"
    },
    {
      "ayah": 7,
      "start_ms": 23237,
      "end_ms": 28562,
      "duration_ms": 5325,
      "text": "আর তিনি আপনাকে পেলেন পথ সম্পর্কে অনবহিত, অতঃপর তিনি পথের নির্দেশ দিলেন।"
    },
    {
      "ayah": 8,
      "start_ms": 28562,
      "end_ms": 33112,
      "duration_ms": 4550,
      "text": "আর তিনি আপনাকে পেলেন নিঃস্ব অবস্থায়, অতঃপর অভাব মুক্ত করলেন।"
    },
    {
      "ayah": 9,
      "start_ms": 33112,
      "end_ms": 36312,
      "duration_ms": 3200,
      "text": "কাজেই আপনি ইয়াতীমের প্রতি কঠোর হবেন না।"
    },
    {
      "ayah": 10,
      "start_ms": 36312,
      "end_ms": 39074,
      "duration_ms": 2762,
      "text": "আর প্রার্থীকে ভর্ৎসনা করবেন না।"
    },
    {
      "ayah": 11,
      "start_ms": 39075,
      "end_ms": 42575,
      "duration_ms": 3500,
      "text": "আর আপনি আপনার রবের অনুগ্রহের কথা জানিয়ে দিন।"
    }
  ]
}