{
  "surah": 78,
  "name_translit": "An-Naba",
  "name_bn": "আন-নাবা",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 139159,
  "total_ayat": 40,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 3694,
      "duration_ms": 3694,
      "text": "তারা একে অন্যের কাছে কী বিষয়ে জিজ্ঞাসাবাদ করছে?"
    },
    {
      "ayah": 2,
      "start_ms": 3694,
      "end_ms": 5156,
      "duration_ms": 1462,
      "text": "মহাসংবাদটির বিষয়ে,"
    },
    {
      "ayah": 3,
      "start_ms": 5156,
      "end_ms": 7388,
      "duration_ms": 2232,
      "text": "যে বিষয়ে তারা মতানৈক্য করছে,"
    },
    {
      "ayah": 4,
      "start_ms": 7388,
      "end_ms": 10005,
      "duration_ms": 2617,
      "text": "কখনো না, তারা অচিরেই জানতে পারবে;।"
    },
    {
      "ayah": 5,
      "start_ms": 10005,
      "end_ms": 13315,
      "duration_ms": 3310,
      "text": "তারপর বলি কখনো না, তারা অচিরেই জানতে পারবে।"
    },
    {
      "ayah": 6,
      "start_ms": 13315,
      "end_ms": 15393,
      "duration_ms": 2078,
      "text": "আমরা কি করিনি যমীনকে শয্যা।"
    },
    {
      "ayah": 7,
      "start_ms": 15393,
      "end_ms": 17009,
      "duration_ms": 1616,
      "text": "আর পর্বতসমূহকে পেরেক?"
    },
    {
      "ayah": 8,
      "start_ms": 17009,
      "end_ms": 20319,
      "duration_ms": 3310,
      "text": "আর আমরা সৃষ্টি করেছি তোমাদেরকে জোড়ায় জোড়ায়,"
    },
    {
      "ayah": 9,
      "start_ms": 20319,
      "end_ms": 22705,
      "duration_ms": 2386,
      "text": "আর তোমাদের ঘুমকে করেছি বিশ্রাম,"
    },
    {
      "ayah": 10,
      "start_ms": 22705,
      "end_ms": 24244,
      "duration_ms": 1539,
      "text": "আর করেছি রাতকে আবরণ,"
    },
    {
      "ayah": 11,
      "start_ms": 24244,
      "end_ms": 26861,
      "duration_ms": 2617,
      "text": "আর করেছি দিনকে জীবিকা আহরণের সময়,"
    },
    {
      "ayah": 12,
      "start_ms": 26861,
      "end_ms": 30786,
      "duration_ms": 3925,
      "text": "আর আমরা নির্মাণ করেছি তোমাদের উপরে সুদৃঢ় সাত আকাশ।"
    },
    {
      "ayah": 13,
      "start_ms": 30786,
      "end_ms": 33557,
      "duration_ms": 2771,
      "text": "আর আমরা সৃষ্টি করেছি প্রোজ্জ্বল দীপ।"
    },
    {
      "ayah": 14,
      "start_ms": 33557,
      "end_ms": 36944,
      "duration_ms": 3387,
      "text": "আর আমরা বর্ষণ করেছি মেঘমালা হতে প্রচুর বারি,"
    },
    {
      "ayah": 15,
      "start_ms": 36944,
      "end_ms": 40331,
      "duration_ms": 3387,
      "text": "যাতে তা দ্বারা আমরা উৎপন্ন করি শস্য, উদ্ভিদ।"
    },
    {
      "ayah": 16,
      "start_ms": 40331,
      "end_ms": 42101,
      "duration_ms": 1770,
      "text": "ও ঘন সন্নিবিষ্ট উদ্যান।"
    },
    {
      "ayah": 17,
      "start_ms": 42101,
      "end_ms": 44718,
      "duration_ms": 2617,
      "text": "নিশ্চয় নির্ধারিত আছে বিচার দিন ;।"
    },
    {
      "ayah": 18,
      "start_ms": 44718,
      "end_ms": 48720,
      "duration_ms": 4002,
      "text": "সেদিন শিংগায় ফুঁক দেয়া হবে তখন তোমরা দলে দলে আসবে,"
    },
    {
      "ayah": 19,
      "start_ms": 48720,
      "end_ms": 52876,
      "duration_ms": 4156,
      "text": "আর আকাশ উন্মুক্ত করা হবে, ফলে তা হবে বহু দ্বারবিশিষ্ট।"
    },
    {
      "ayah": 20,
      "start_ms": 52876,
      "end_ms": 57417,
      "duration_ms": 4541,
      "text": "আর চলমান করা হবে পর্বতসমূহকে, ফলে সেগুলো হয়ে যাবে মরীচিকা,"
    },
    {
      "ayah": 21,
      "start_ms": 57417,
      "end_ms": 60265,
      "duration_ms": 2848,
      "text": "নিশ্চয় জাহান্নাম ওৎ পেতে অপেক্ষমান;।"
    },
    {
      "ayah": 22,
      "start_ms": 60265,
      "end_ms": 63267,
      "duration_ms": 3002,
      "text": "সীমালঙ্ঘনকারীদের জন্য প্রত্যাবর্তনস্থল।"
    },
    {
      "ayah": 23,
      "start_ms": 63267,
      "end_ms": 66115,
      "duration_ms": 2848,
      "text": "সেখানে তারা যুগ যুগ ধরে অবস্থান করবে।"
    },
    {
      "ayah": 24,
      "start_ms": 66115,
      "end_ms": 70040,
      "duration_ms": 3925,
      "text": "সেখানে তারা আস্বাদন করবে না শীতলতা, না কোনো পানীয়।"
    },
    {
      "ayah": 25,
      "start_ms": 70040,
      "end_ms": 72118,
      "duration_ms": 2078,
      "text": "ফুটন্ত পানি ও পুঁজ ছাড়া ;।"
    },
    {
      "ayah": 26,
      "start_ms": 72118,
      "end_ms": 73734,
      "duration_ms": 1616,
      "text": "এটাই উপযুক্ত প্রতিফল।"
    },
    {
      "ayah": 27,
      "start_ms": 73734,
      "end_ms": 76582,
      "duration_ms": 2848,
      "text": "নিশ্চয় তারা কখনো হিসেবের আশা করত না,"
    },
    {
      "ayah": 28,
      "start_ms": 76582,
      "end_ms": 80815,
      "duration_ms": 4233,
      "text": "আর তারা আমাদের নিদর্শনাবলীতে কঠোরভাবে মিথ্যারোপ করেছিল।"
    },
    {
      "ayah": 29,
      "start_ms": 80815,
      "end_ms": 83894,
      "duration_ms": 3079,
      "text": "আর সবকিছুই আমরা সংরক্ষণ করেছি লিখিতভাবে।"
    },
    {
      "ayah": 30,
      "start_ms": 83894,
      "end_ms": 89205,
      "duration_ms": 5311,
      "text": "অতঃপর তোমরা আস্বাদ গ্রহণ কর, আমরা তো তোমাদের শাস্তিই শুধু বৃদ্ধি করব।"
    },
    {
      "ayah": 31,
      "start_ms": 89205,
      "end_ms": 91976,
      "duration_ms": 2771,
      "text": "নিশ্চয় মুত্তাকীদের জন্য আছে সাফল্য,"
    },
    {
      "ayah": 32,
      "start_ms": 91976,
      "end_ms": 93746,
      "duration_ms": 1770,
      "text": "উদ্যানসমূহ, আঙ্গুরসমূহ,"
    },
    {
      "ayah": 33,
      "start_ms": 93746,
      "end_ms": 96363,
      "duration_ms": 2617,
      "text": "আর সমবয়স্কা উদ্ভিন্ন যৌবনা তরুণী।"
    },
    {
      "ayah": 34,
      "start_ms": 96363,
      "end_ms": 98133,
      "duration_ms": 1770,
      "text": "এবং পরিপূর্ণ পানিপাত্র।"
    },
    {
      "ayah": 35,
      "start_ms": 98133,
      "end_ms": 101827,
      "duration_ms": 3694,
      "text": "সেখানে তারা শুনবে না কোনো অসার ও মিথ্যা বাক্য ;।"
    },
    {
      "ayah": 36,
      "start_ms": 101827,
      "end_ms": 105521,
      "duration_ms": 3694,
      "text": "আপনার রবের পক্ষ থেকে পুরস্কার, যথোচিত দানস্বরূপ,"
    },
    {
      "ayah": 37,
      "start_ms": 105521,
      "end_ms": 114219,
      "duration_ms": 8698,
      "text": "যিনি আসমানসমূহ, যমীন ও এ দুয়ের মধ্যবর্তী সমস্ত কিছুর রব, দয়াময়; তাঁর কাছে আবেদন নিবেদনের শক্তি তাদের থাকবে না।"
    },
    {
      "ayah": 38,
      "start_ms": 114219,
      "end_ms": 123918,
      "duration_ms": 9699,
      "text": "সেদিন রূহ ও ফেরেশতাগণ সারিবদ্ধভাবে দাঁরাবে ; সেদিন কেউ কথা বলবে না, তবে রহমান যাকে অনুমতি দেবেন সে ছাড়া এবং সে সঠিক কথা বলবে।"
    },
    {
      "ayah": 39,
      "start_ms": 123918,
      "end_ms": 128921,
      "duration_ms": 5003,
      "text": "এ দিনটি সত্য; অতএব, যার ইচ্ছে সে তার রবের নিকট আশ্রয় গ্রহণ করুক।"
    },
    {
      "ayah": 40,
      "start_ms": 128921,
      "end_ms": 139159,
      "duration_ms": 10238,
      "text": "নিশ্চয় আমরা তোমাদেরকে আসন্ন শাস্তি সম্পর্কে সতর্ক করলাম; যেদিন মানুষ তার কৃতকর্ম দেখতে পাবে এবং কাফির বলবে, হায়! আমি যদি মাটি হতাম!"
    }
  ]
}