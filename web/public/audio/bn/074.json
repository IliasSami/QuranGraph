{
  "surah": 74,
  "name_translit": "Al-Muddaththir",
  "name_bn": "আল-মুদ্দাসসির",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 212952,
  "total_ayat": 56,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1374,
      "duration_ms": 1374,
      "text": "হে বস্ত্রাচ্ছাদিত!"
    },
    {
      "ayah": 2,
      "start_ms": 1374,
      "end_ms": 3129,
      "duration_ms": 1755,
      "text": "উঠুন, অতঃপর সতর্ক করুন,"
    },
    {
      "ayah": 3,
      "start_ms": 3129,
      "end_ms": 5877,
      "duration_ms": 2748,
      "text": "আর আপনার রবের শ্রেষ্ঠত্ব ঘোষণা করুন।"
    },
    {
      "ayah": 4,
      "start_ms": 5877,
      "end_ms": 8090,
      "duration_ms": 2213,
      "text": "আর আপনার পরিচ্ছদ পবিত্র করুন,"
    },
    {
      "ayah": 5,
      "start_ms": 8090,
      "end_ms": 9998,
      "duration_ms": 1908,
      "text": "আর শির্ক পরিহার করে চলুন,"
    },
    {
      "ayah": 6,
      "start_ms": 9998,
      "end_ms": 13127,
      "duration_ms": 3129,
      "text": "আর বেশী পাওয়ার প্রত্যাশায় দান করবেন না।"
    },
    {
      "ayah": 7,
      "start_ms": 13127,
      "end_ms": 15951,
      "duration_ms": 2824,
      "text": "আর আপনার রবের জন্যেই ধৈর্য ধারণ করুন।"
    },
    {
      "ayah": 8,
      "start_ms": 15951,
      "end_ms": 18470,
      "duration_ms": 2519,
      "text": "অতঃপর যখন শিংগায় ফুঁক দেয়া হবে।"
    },
    {
      "ayah": 9,
      "start_ms": 18470,
      "end_ms": 20302,
      "duration_ms": 1832,
      "text": "সেদিন হবে এক সংকটের দিন।"
    },
    {
      "ayah": 10,
      "start_ms": 20302,
      "end_ms": 22210,
      "duration_ms": 1908,
      "text": "যা কাফিরদের জন্য সহজ নয়।"
    },
    {
      "ayah": 11,
      "start_ms": 22210,
      "end_ms": 25721,
      "duration_ms": 3511,
      "text": "ছেড়ে দিন আমাকে ও যাকে আমি সৃষ্টি করেছি একাকী।"
    },
    {
      "ayah": 12,
      "start_ms": 25721,
      "end_ms": 28392,
      "duration_ms": 2671,
      "text": "আর আমি তাকে দিয়েছি বিপুল ধন সম্পদ।"
    },
    {
      "ayah": 13,
      "start_ms": 28392,
      "end_ms": 30147,
      "duration_ms": 1755,
      "text": "এবং নিত্যসঙ্গী পুত্রগণ,"
    },
    {
      "ayah": 14,
      "start_ms": 30147,
      "end_ms": 33734,
      "duration_ms": 3587,
      "text": "আর তাকে দিয়েছি স্বাচ্ছন্দ জীবনের প্রচুর উপকরণ।"
    },
    {
      "ayah": 15,
      "start_ms": 33734,
      "end_ms": 37245,
      "duration_ms": 3511,
      "text": "এর পরও সে কামনা করে যে, আমি তাকে আরও বেশী দেই!"
    },
    {
      "ayah": 16,
      "start_ms": 37245,
      "end_ms": 40985,
      "duration_ms": 3740,
      "text": "কখনো নয়, সে তো আমাদের নিদর্শনসমূহের বিরুদ্ধাচারী।"
    },
    {
      "ayah": 17,
      "start_ms": 40985,
      "end_ms": 44954,
      "duration_ms": 3969,
      "text": "অচিরেই আমি তাকে চড়ার শাস্তি দিয়ে কষ্ট ক্লান্ত করব।"
    },
    {
      "ayah": 18,
      "start_ms": 44954,
      "end_ms": 48083,
      "duration_ms": 3129,
      "text": "সে তো চিন্তা করল এবং সিদ্ধান্ত গ্রহণ করল।"
    },
    {
      "ayah": 19,
      "start_ms": 48083,
      "end_ms": 52281,
      "duration_ms": 4198,
      "text": "সুতরাং ধ্বংস হোক সে! কেমন করে সে এ সিদ্ধান্ত গ্রহণ করল!"
    },
    {
      "ayah": 20,
      "start_ms": 52281,
      "end_ms": 56479,
      "duration_ms": 4198,
      "text": "তারপরও ধ্বংস হোক সে! কেমন করে সে এ সিদ্ধান্তে উপনীত হল!"
    },
    {
      "ayah": 21,
      "start_ms": 56479,
      "end_ms": 57624,
      "duration_ms": 1145,
      "text": "তারপর সে তাকাল।"
    },
    {
      "ayah": 22,
      "start_ms": 57624,
      "end_ms": 60677,
      "duration_ms": 3053,
      "text": "তারপর সে ভ্রকুঞ্চিত করল ও মুখ বিকৃত করল।"
    },
    {
      "ayah": 23,
      "start_ms": 60677,
      "end_ms": 63272,
      "duration_ms": 2595,
      "text": "তারপর সে পিছন ফিরল এবং অহংকার করল।"
    },
    {
      "ayah": 24,
      "start_ms": 63272,
      "end_ms": 68081,
      "duration_ms": 4809,
      "text": "অতঃপর সে বলল, এ তো লোক পরম্পরায় প্রাপ্ত জাদু ভিন্ন আর কিছু নয়,"
    },
    {
      "ayah": 25,
      "start_ms": 68081,
      "end_ms": 69455,
      "duration_ms": 1374,
      "text": "এ তো মানুষেরই কথা।"
    },
    {
      "ayah": 26,
      "start_ms": 69455,
      "end_ms": 71974,
      "duration_ms": 2519,
      "text": "অচিরেই আমি তাকে দগ্ধ করব সাকার এ।"
    },
    {
      "ayah": 27,
      "start_ms": 71974,
      "end_ms": 74340,
      "duration_ms": 2366,
      "text": "আর আপনাকে কিসে জানাবে সাকার কী?"
    },
    {
      "ayah": 28,
      "start_ms": 74340,
      "end_ms": 77393,
      "duration_ms": 3053,
      "text": "এটা অবশিষ্ট রাখবে না এবং ছেড়েও দেবে না।"
    },
    {
      "ayah": 29,
      "start_ms": 77393,
      "end_ms": 80751,
      "duration_ms": 3358,
      "text": "এটা তো শরীরের চামড়া পুড়িয়ে কালো করে দেবে,"
    },
    {
      "ayah": 30,
      "start_ms": 80751,
      "end_ms": 84033,
      "duration_ms": 3282,
      "text": "সাকার এর তত্ত্বাবধানে রয়েছে ঊনিশজন প্রহরী।"
    },
    {
      "ayah": 31,
      "start_ms": 84033,
      "end_ms": 125406,
      "duration_ms": 41373,
      "text": "আর আমরা তো জাহান্নামের প্রহরী কেবল ফেরেশতাদেরকেই করেছি ; কাফিরদের পরীক্ষাস্বরূপই আমরা তাদের এ সংখ্যা উল্লেখ করেছি যাতে কিতাবপ্রাপ্তদের দৃঢ় প্রত্যয় জন্মে, আর যারা ঈমান এনেছে তাদের ঈমান বেড়ে যায়। আর কিতাবপ্রাপ্তরা ও মুমিনরা সন্দেহ পোষণ না করে। আর যেন এর ফলে যাদের অন্তরে ব্যাধি আছে তারা ও কাফিররা বলে, আল্লাহ এ (সংখ্যার) উপমা (উল্লেখ করা) দ্বারা কি ইচ্ছা করেছেন? এভাবে আল্লাহ যাকে ইচ্ছে পথভ্রষ্ট করেন এবং যাকে ইচ্ছে হেদায়াত করেন। আর আপনার রবের বাহিনী সম্পর্কে তিনি ছাড়া কেউ জানে না। আর জাহান্নামের এ বর্ণনা তো মানুষের জন্য এক উপদেশ মাত্র।"
    },
    {
      "ayah": 32,
      "start_ms": 125406,
      "end_ms": 127009,
      "duration_ms": 1603,
      "text": "কখনোই না, চাঁদের শপথ,"
    },
    {
      "ayah": 33,
      "start_ms": 127009,
      "end_ms": 129222,
      "duration_ms": 2213,
      "text": "শপথ রাতের, যখন তার অবসান ঘটে,"
    },
    {
      "ayah": 34,
      "start_ms": 129222,
      "end_ms": 132275,
      "duration_ms": 3053,
      "text": "শপথ প্রভাতকালের, যখন তা আলোকোজ্জ্বল হয়।"
    },
    {
      "ayah": 35,
      "start_ms": 132275,
      "end_ms": 135557,
      "duration_ms": 3282,
      "text": "নিশ্চয় জাহান্নাম ভয়াবহ বিপদসমূহের অন্যতম,"
    },
    {
      "ayah": 36,
      "start_ms": 135557,
      "end_ms": 137770,
      "duration_ms": 2213,
      "text": "মানুষের জন্য সতর্ককারীস্বরূপ।"
    },
    {
      "ayah": 37,
      "start_ms": 137770,
      "end_ms": 143113,
      "duration_ms": 5343,
      "text": "তোমাদের মধ্যে যে অগ্রসর হতে চায় কিংবা যে পিছিয়ে পড়তে চায় তার জন্য।"
    },
    {
      "ayah": 38,
      "start_ms": 143113,
      "end_ms": 146395,
      "duration_ms": 3282,
      "text": "প্রত্যেক ব্যক্তি নিজ কৃতকর্মের দায়ে আবদ্ধ,"
    },
    {
      "ayah": 39,
      "start_ms": 146395,
      "end_ms": 147845,
      "duration_ms": 1450,
      "text": "তবে ডানপন্থীরা নয়,"
    },
    {
      "ayah": 40,
      "start_ms": 147845,
      "end_ms": 151356,
      "duration_ms": 3511,
      "text": "বাগ বাগিচার মধ্যে তারা একে অপরকে জিজ্ঞেস করবে।"
    },
    {
      "ayah": 41,
      "start_ms": 151356,
      "end_ms": 152806,
      "duration_ms": 1450,
      "text": "অপরাধীদের সম্পর্কে,"
    },
    {
      "ayah": 42,
      "start_ms": 152806,
      "end_ms": 155630,
      "duration_ms": 2824,
      "text": "তোমাদেরকে কিসে সাকার এ নিক্ষেপ করেছে?"
    },
    {
      "ayah": 43,
      "start_ms": 155630,
      "end_ms": 159904,
      "duration_ms": 4274,
      "text": "তারা বলবে, আমরা সালাত আদায়কারীদের অন্তর্ভুক্ত ছিলাম না,"
    },
    {
      "ayah": 44,
      "start_ms": 159904,
      "end_ms": 162957,
      "duration_ms": 3053,
      "text": "আর আমরা অভাবগ্রস্তকে খাদ্য দান করতাম না,"
    },
    {
      "ayah": 45,
      "start_ms": 162957,
      "end_ms": 167384,
      "duration_ms": 4427,
      "text": "এবং আমরা অনর্থক আলাপকারীদের সাথে বেহুদা আলাপে মগ্ন থাকতাম।"
    },
    {
      "ayah": 46,
      "start_ms": 167384,
      "end_ms": 170361,
      "duration_ms": 2977,
      "text": "আর আমরা প্রতিদান দিবসে মিথ্যারোপ করতাম,"
    },
    {
      "ayah": 47,
      "start_ms": 170361,
      "end_ms": 173032,
      "duration_ms": 2671,
      "text": "অবশেষে আমাদের কাছে মৃত্যু আগমন করে।"
    },
    {
      "ayah": 48,
      "start_ms": 173032,
      "end_ms": 177001,
      "duration_ms": 3969,
      "text": "ফলে সুপারিশকারীদের সুপারিশ তাদের কোনো উপকার করবে না।"
    },
    {
      "ayah": 49,
      "start_ms": 177001,
      "end_ms": 181428,
      "duration_ms": 4427,
      "text": "অতঃপর তাদের কী হয়েছে যে, তারা মুখ ফিরিয়ে নেয় উপদেশ হতে?"
    },
    {
      "ayah": 50,
      "start_ms": 181428,
      "end_ms": 184863,
      "duration_ms": 3435,
      "text": "তারা যেন ভীত ত্রস্ত হয়ে পলায়নরত একপাল গাধা।"
    },
    {
      "ayah": 51,
      "start_ms": 184863,
      "end_ms": 187153,
      "duration_ms": 2290,
      "text": "যারা সিংহের ভয়ে পলায়ন করেছে।"
    },
    {
      "ayah": 52,
      "start_ms": 187153,
      "end_ms": 193183,
      "duration_ms": 6030,
      "text": "বরং তাদের মধ্যকার প্রত্যেকেই কামনা করে যে, তাকে একটি উন্মুক্ত গ্রন্থ দেয়া হোক।"
    },
    {
      "ayah": 53,
      "start_ms": 193183,
      "end_ms": 196236,
      "duration_ms": 3053,
      "text": "কখনো নয় ; বরং তারা আখেরাতকে ভয় করে না।"
    },
    {
      "ayah": 54,
      "start_ms": 196236,
      "end_ms": 199289,
      "duration_ms": 3053,
      "text": "নিশ্চয় এ কুরআন তো সকলের জন্য উপদেশবাণী।"
    },
    {
      "ayah": 55,
      "start_ms": 199289,
      "end_ms": 202571,
      "duration_ms": 3282,
      "text": "অতএব যার ইচ্ছে সে তা থেকে উপদেশ গ্রহণ করুক।"
    },
    {
      "ayah": 56,
      "start_ms": 202571,
      "end_ms": 212952,
      "duration_ms": 10381,
      "text": "আর আল্লাহর ইচ্ছে ছাড়া কেউ উপদেশ গ্রহণ করতে পারে না; তিনিই যোগ্য যে, একমাত্র তাঁরই তাকওয়া অবলম্বন করা হবে, আর তিনিই ক্ষমা করার অধিকারী।"
    }
  ]
}