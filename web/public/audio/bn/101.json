{
  "surah": 101,
  "name_translit": "Al-Qaari'a",
  "name_bn": "আল-কারি'আহ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 29821,
  "total_ayat": 11,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1641,
      "duration_ms": 1641,
      "text": "ভীতিপ্রদ মহা বিপদ।"
    },
    {
      "ayah": 2,
      "start_ms": 1641,
      "end_ms": 3556,
      "duration_ms": 1915,
      "text": "ভীতিপ্রদ মহা বিপদ কী?"
    },
    {
      "ayah": 3,
      "start_ms": 3556,
      "end_ms": 8025,
      "duration_ms": 4469,
      "text": "আর ভীতিপ্রদ মহা বিপদ সম্পর্কে আপনাকে কিসে জানাবে?"
    },
    {
      "ayah": 4,
      "start_ms": 8025,
      "end_ms": 11399,
      "duration_ms": 3374,
      "text": "সেদিন মানুষ হবে বিক্ষিপ্ত পতঙ্গের মত।"
    },
    {
      "ayah": 5,
      "start_ms": 11399,
      "end_ms": 14956,
      "duration_ms": 3557,
      "text": "আর পর্বতসমূহ হবে ধুনিত রঙ্গিন পশমের মত।"
    },
    {
      "ayah": 6,
      "start_ms": 14956,
      "end_ms": 17692,
      "duration_ms": 2736,
      "text": "অতঃপর যার পাল্লাসমূহ ভারী হবে,"
    },
    {
      "ayah": 7,
      "start_ms": 17692,
      "end_ms": 20245,
      "duration_ms": 2553,
      "text": "সে তো থাকবে সন্তোষজনক জীবনে।"
    },
    {
      "ayah": 8,
      "start_ms": 20245,
      "end_ms": 22890,
      "duration_ms": 2645,
      "text": "আর যার পাল্লাসমূহ হাল্কা হবে।"
    },
    {
      "ayah": 9,
      "start_ms": 22890,
      "end_ms": 25170,
      "duration_ms": 2280,
      "text": "তার স্থান হবে হাওয়িয়াহ।"
    },
    {
      "ayah": 10,
      "start_ms": 25170,
      "end_ms": 27906,
      "duration_ms": 2736,
      "text": "আর আপনাকে কিসে জানাবে সেটা কী?"
    },
    {
      "ayah": 11,
      "start_ms": 27906,
      "end_ms": 29821,
      "duration_ms": 1915,
      "text": "অত্যন্ত উত্তপ্ত আগুন।"
    }
  ]
}