{
  "surah": 96,
  "name_translit": "Al-Alaq",
  "name_bn": "আল-'আলাক",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 71203,
  "total_ayat": 19,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 3601,
      "duration_ms": 3601,
      "text": "পড়ুন আপনার রবের নামে, যিনি সৃষ্টি করেছেন –।"
    },
    {
      "ayah": 2,
      "start_ms": 3601,
      "end_ms": 6138,
      "duration_ms": 2537,
      "text": "সৃষ্টি করেছেন মানুষকে আলাক হতে।"
    },
    {
      "ayah": 3,
      "start_ms": 6138,
      "end_ms": 8839,
      "duration_ms": 2701,
      "text": "পড়ুন, আর আপনার রব মহামহিমান্বিত।"
    },
    {
      "ayah": 4,
      "start_ms": 8839,
      "end_ms": 11949,
      "duration_ms": 3110,
      "text": "যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন –।"
    },
    {
      "ayah": 5,
      "start_ms": 11949,
      "end_ms": 15059,
      "duration_ms": 3110,
      "text": "শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।"
    },
    {
      "ayah": 6,
      "start_ms": 15059,
      "end_ms": 18005,
      "duration_ms": 2946,
      "text": "বাস্তবেই, মানুষ সীমালঙ্ঘনই করে থাকে,"
    },
    {
      "ayah": 7,
      "start_ms": 18005,
      "end_ms": 20787,
      "duration_ms": 2782,
      "text": "কারণ সে নিজকে অমুখাপেক্ষী মনে করে।"
    },
    {
      "ayah": 8,
      "start_ms": 20787,
      "end_ms": 23733,
      "duration_ms": 2946,
      "text": "নিশ্চয় আপনার রবের কাছেই ফিরে যাওয়া।"
    },
    {
      "ayah": 9,
      "start_ms": 23733,
      "end_ms": 28316,
      "duration_ms": 4583,
      "text": "আমাকে জানাও (এবং আশ্চর্য হও) তার সম্পর্কে, যে বাধা দেয়।"
    },
    {
      "ayah": 10,
      "start_ms": 28316,
      "end_ms": 31426,
      "duration_ms": 3110,
      "text": "এক বান্দাকে যখন তিনি সালাত আদায় করেন।"
    },
    {
      "ayah": 11,
      "start_ms": 31426,
      "end_ms": 34700,
      "duration_ms": 3274,
      "text": "আমাকে বল! যদি তিনি হিদায়াতের উপর থাকেন।"
    },
    {
      "ayah": 12,
      "start_ms": 34700,
      "end_ms": 39529,
      "duration_ms": 4829,
      "text": "অথবা তাক্ওয়ার নির্দেশ দেন; (তারপরও সে কিভাবে বাধা দেয়?!)।"
    },
    {
      "ayah": 13,
      "start_ms": 39529,
      "end_ms": 44767,
      "duration_ms": 5238,
      "text": "আমাকে বল! যদি সে (নিষেধকারী) মিথ্যারোপ করে এবং মুখ ফিরিয়ে নেয়,"
    },
    {
      "ayah": 14,
      "start_ms": 44767,
      "end_ms": 48041,
      "duration_ms": 3274,
      "text": "সে কি জানে না যে, নিশ্চয় আল্লাহ দেখেন?!"
    },
    {
      "ayah": 15,
      "start_ms": 48041,
      "end_ms": 56471,
      "duration_ms": 8430,
      "text": "কখনো নয়, সে যদি বিরত না হয় তবে আমরা তাকে অবশ্যই হেঁচড়ে নিয়ে যাব, মাথার সামনের চুলের গুচ্ছ ধরে -----।"
    },
    {
      "ayah": 16,
      "start_ms": 56471,
      "end_ms": 59663,
      "duration_ms": 3192,
      "text": "মিথ্যাচারী, পাপিষ্ঠ সম্মুখ-চুলের-গুচ্ছ।"
    },
    {
      "ayah": 17,
      "start_ms": 59663,
      "end_ms": 62200,
      "duration_ms": 2537,
      "text": "অতএব সে তার পারিষদকে ডেকে আনুক!"
    },
    {
      "ayah": 18,
      "start_ms": 62200,
      "end_ms": 65146,
      "duration_ms": 2946,
      "text": "শীঘ্রই আমরা ডেকে আনব যাবানিয়াদেরকে।"
    },
    {
      "ayah": 19,
      "start_ms": 65146,
      "end_ms": 71203,
      "duration_ms": 6057,
      "text": "কখনো নয়! আপনি তার অনুসরণ করবেন না। আর আপনি সাজ্দা করুন এবং নিকটবর্তী হোন।"
    }
  ]
}