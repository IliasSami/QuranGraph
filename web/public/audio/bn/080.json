{
  "surah": 80,
  "name_translit": "Abasa",
  "name_bn": "'আবাসা",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 114574,
  "total_ayat": 42,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 3467,
      "duration_ms": 3467,
      "text": "তিনি ভ্রকুঞ্চিত করলেন এবং মুখ ফিরিয়ে নিলেন,"
    },
    {
      "ayah": 2,
      "start_ms": 3467,
      "end_ms": 5831,
      "duration_ms": 2364,
      "text": "কারণ তাঁর কাছে অন্ধ লোকটি আসল।"
    },
    {
      "ayah": 3,
      "start_ms": 5831,
      "end_ms": 9456,
      "duration_ms": 3625,
      "text": "আর কিসে আপনাকে জানাবে যে, সে হয়ত পরিশুদ্ধ হত।"
    },
    {
      "ayah": 4,
      "start_ms": 9456,
      "end_ms": 13396,
      "duration_ms": 3940,
      "text": "অথবা উপদেশ গ্রহণ করত, ফলে সে উপদেশ তার উপকারে আসত।"
    },
    {
      "ayah": 5,
      "start_ms": 13396,
      "end_ms": 14972,
      "duration_ms": 1576,
      "text": "আর যে পরোয়া করে না।"
    },
    {
      "ayah": 6,
      "start_ms": 14972,
      "end_ms": 17415,
      "duration_ms": 2443,
      "text": "আপনি তার প্রতি মনোযোগ দিয়েছেন।"
    },
    {
      "ayah": 7,
      "start_ms": 17415,
      "end_ms": 21513,
      "duration_ms": 4098,
      "text": "অথচ সে নিজে পরিশুদ্ধ না হলে আপনার কোনো দায়িত্ব নেই,"
    },
    {
      "ayah": 8,
      "start_ms": 21513,
      "end_ms": 23956,
      "duration_ms": 2443,
      "text": "অপরদিকে যে আপনার কাছে ছুটে এলো,"
    },
    {
      "ayah": 9,
      "start_ms": 23956,
      "end_ms": 25295,
      "duration_ms": 1339,
      "text": "আর সে সশঙ্কচিত্ত,"
    },
    {
      "ayah": 10,
      "start_ms": 25295,
      "end_ms": 27423,
      "duration_ms": 2128,
      "text": "আপনি তার থেকে উদাসীন হলেন;।"
    },
    {
      "ayah": 11,
      "start_ms": 27423,
      "end_ms": 29629,
      "duration_ms": 2206,
      "text": "কখনো নয়, এটা তো উপদেশ বাণী,"
    },
    {
      "ayah": 12,
      "start_ms": 29629,
      "end_ms": 32702,
      "duration_ms": 3073,
      "text": "কাজেই যে ইচ্ছে করবে সে এটা স্মরণ রাখবে,"
    },
    {
      "ayah": 13,
      "start_ms": 32702,
      "end_ms": 35381,
      "duration_ms": 2679,
      "text": "এটা আছে মর্যাদা সম্পন্ন লিপিসমূহে।"
    },
    {
      "ayah": 14,
      "start_ms": 35381,
      "end_ms": 36720,
      "duration_ms": 1339,
      "text": "যা উন্নত, পবিত্র,"
    },
    {
      "ayah": 15,
      "start_ms": 36720,
      "end_ms": 38296,
      "duration_ms": 1576,
      "text": "লেখক বা দূতদের হাতে।"
    },
    {
      "ayah": 16,
      "start_ms": 38296,
      "end_ms": 40502,
      "duration_ms": 2206,
      "text": "(যারা) মহাসম্মানিত ও নেককার।"
    },
    {
      "ayah": 17,
      "start_ms": 40502,
      "end_ms": 42945,
      "duration_ms": 2443,
      "text": "মানুষ ধ্বংস হোক! সে কত অকৃতজ্ঞ!"
    },
    {
      "ayah": 18,
      "start_ms": 42945,
      "end_ms": 46018,
      "duration_ms": 3073,
      "text": "তিনি তাকে কোন বস্তু থেকে সৃষ্টি করেছেন?"
    },
    {
      "ayah": 19,
      "start_ms": 46018,
      "end_ms": 51692,
      "duration_ms": 5674,
      "text": "শুক্রবিন্দু থেকে, তিনি তাকে সৃষ্টি করেন, পরে তার পরিমিত বিকাশ সাধন করেন,"
    },
    {
      "ayah": 20,
      "start_ms": 51692,
      "end_ms": 54214,
      "duration_ms": 2522,
      "text": "তারপর তার জন্য পথ সহজ করে দেন ;।"
    },
    {
      "ayah": 21,
      "start_ms": 54214,
      "end_ms": 57524,
      "duration_ms": 3310,
      "text": "এরপর তার মৃত্যু ঘটান এবং তাকে কবরস্থ করেন।"
    },
    {
      "ayah": 22,
      "start_ms": 57524,
      "end_ms": 60834,
      "duration_ms": 3310,
      "text": "এরপর যখন ইচ্ছে তিনি তাকে পুনর্জীবিত করবেন।"
    },
    {
      "ayah": 23,
      "start_ms": 60834,
      "end_ms": 65484,
      "duration_ms": 4650,
      "text": "কখনো নয়, তিনি তাকে যা আদেশ করেছেন, সে এখনো তা পূর্ণ করেনি।"
    },
    {
      "ayah": 24,
      "start_ms": 65484,
      "end_ms": 69030,
      "duration_ms": 3546,
      "text": "অতঃপর মানুষ যেন তার খাদ্যের প্রতি লক্ষ্য করে!"
    },
    {
      "ayah": 25,
      "start_ms": 69030,
      "end_ms": 71788,
      "duration_ms": 2758,
      "text": "নিশ্চয় আমরা প্রচুর বারি বর্ষণ করি,"
    },
    {
      "ayah": 26,
      "start_ms": 71788,
      "end_ms": 75019,
      "duration_ms": 3231,
      "text": "তারপর আমরা যমীনকে যথাযথভাবে বিদীর্ণ করি;।"
    },
    {
      "ayah": 27,
      "start_ms": 75019,
      "end_ms": 77619,
      "duration_ms": 2600,
      "text": "অতঃপর তাতে আমরা উৎপন্ন করি শস্য;।"
    },
    {
      "ayah": 28,
      "start_ms": 77619,
      "end_ms": 79037,
      "duration_ms": 1418,
      "text": "আঙ্গুর, শাক সব্জি,"
    },
    {
      "ayah": 29,
      "start_ms": 79037,
      "end_ms": 80455,
      "duration_ms": 1418,
      "text": "যায়তূন, খেজুরগাছ,"
    },
    {
      "ayah": 30,
      "start_ms": 80455,
      "end_ms": 82267,
      "duration_ms": 1812,
      "text": "অনেক গাছবিশিষ্ট উদ্যান,"
    },
    {
      "ayah": 31,
      "start_ms": 82267,
      "end_ms": 83764,
      "duration_ms": 1497,
      "text": "ফল এবং গবাদি খাদ্য,"
    },
    {
      "ayah": 32,
      "start_ms": 83764,
      "end_ms": 87862,
      "duration_ms": 4098,
      "text": "এগুলো তোমাদের ও তোমাদের চতুস্পদ জন্তুদের ভোগের জন্য।"
    },
    {
      "ayah": 33,
      "start_ms": 87862,
      "end_ms": 90226,
      "duration_ms": 2364,
      "text": "অতঃপর যখন তীক্ষ্ন আওয়াজ আসবে,"
    },
    {
      "ayah": 34,
      "start_ms": 90226,
      "end_ms": 93851,
      "duration_ms": 3625,
      "text": "সেদিন মানুষ পালিয়ে যাবে তার ভাইয়ের কাছ থেকে।"
    },
    {
      "ayah": 35,
      "start_ms": 93851,
      "end_ms": 95663,
      "duration_ms": 1812,
      "text": "এবং তার মাতা, তার পিতা,"
    },
    {
      "ayah": 36,
      "start_ms": 95663,
      "end_ms": 97869,
      "duration_ms": 2206,
      "text": "তার পত্নী ও তার সন্তান থেকে,"
    },
    {
      "ayah": 37,
      "start_ms": 97869,
      "end_ms": 104095,
      "duration_ms": 6226,
      "text": "সেদিন তাদের প্রত্যেকের হবে এমন গুরুতর অবস্থা যা তাকে সম্পূর্ণরূপে ব্যস্ত রাখবে।"
    },
    {
      "ayah": 38,
      "start_ms": 104095,
      "end_ms": 106459,
      "duration_ms": 2364,
      "text": "অনেক চেহারা সেদিন হবে উজ্জ্বল,"
    },
    {
      "ayah": 39,
      "start_ms": 106459,
      "end_ms": 107877,
      "duration_ms": 1418,
      "text": "সহাস্য ও প্রফুল্ল,"
    },
    {
      "ayah": 40,
      "start_ms": 107877,
      "end_ms": 110556,
      "duration_ms": 2679,
      "text": "আর অনেক চেহারা সেদিন হবে ধূলিধূসর।"
    },
    {
      "ayah": 41,
      "start_ms": 110556,
      "end_ms": 112841,
      "duration_ms": 2285,
      "text": "সেগুলোকে আচ্ছন্ন করবে কালিমা।"
    },
    {
      "ayah": 42,
      "start_ms": 112841,
      "end_ms": 114574,
      "duration_ms": 1733,
      "text": "এরাই কাফির ও পাপাচারী।"
    }
  ]
}