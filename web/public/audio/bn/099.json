{
  "surah": 99,
  "name_translit": "Az-Zalzala",
  "name_bn": "আয-যালযালাহ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 23096,
  "total_ayat": 8,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2878,
      "duration_ms": 2878,
      "text": "যখন প্রবল কম্পনে যমীন প্রকম্পিত করা হবে,"
    },
    {
      "ayah": 2,
      "start_ms": 2878,
      "end_ms": 4964,
      "duration_ms": 2086,
      "text": "আর যমীন তার ভার বের করে দেবে,"
    },
    {
      "ayah": 3,
      "start_ms": 4964,
      "end_ms": 6691,
      "duration_ms": 1727,
      "text": "আর মানুষ বলবে, এর কী হল?"
    },
    {
      "ayah": 4,
      "start_ms": 6691,
      "end_ms": 9353,
      "duration_ms": 2662,
      "text": "সেদিন যমীন তার বৃত্তান্ত বর্ণনা করবে,"
    },
    {
      "ayah": 5,
      "start_ms": 9353,
      "end_ms": 11943,
      "duration_ms": 2590,
      "text": "কারণ আপনার রব তাকে নির্দেশ দিয়েছেন,"
    },
    {
      "ayah": 6,
      "start_ms": 11943,
      "end_ms": 17268,
      "duration_ms": 5325,
      "text": "সেদিন মানুষ ভিন্ন ভিন্ন দলে বের হবে, যাতে তাদেরকে তাদের কৃতকর্ম দেখান যায়,"
    },
    {
      "ayah": 7,
      "start_ms": 17268,
      "end_ms": 20002,
      "duration_ms": 2734,
      "text": "কেউ অণু পরিমাণ সৎকাজ করলে সে তা দেখবে।"
    },
    {
      "ayah": 8,
      "start_ms": 20002,
      "end_ms": 23096,
      "duration_ms": 3094,
      "text": "আর কেউ অণু পরিমাণ অসৎকাজ করলে সে তাও দেখবে।"
    }
  ]
}