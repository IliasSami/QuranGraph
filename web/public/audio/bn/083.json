{
  "surah": 83,
  "name_translit": "Al-Mutaffifin",
  "name_bn": "আল-মুতাফফিফীন",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 123638,
  "total_ayat": 36,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2784,
      "duration_ms": 2784,
      "text": "দুর্ভোগ তাদের জন্য যারা মাপে কম দেয়,"
    },
    {
      "ayah": 2,
      "start_ms": 2784,
      "end_ms": 7450,
      "duration_ms": 4666,
      "text": "যারা লোকদের কাছ থেকে মেপে নেয়ার সময় পূর্ণমাত্রায় গ্রহণ করে,"
    },
    {
      "ayah": 3,
      "start_ms": 7450,
      "end_ms": 11664,
      "duration_ms": 4214,
      "text": "আর যখন তাদেরকে মেপে দেয় অথবা ওজন করে দেয়, তখন কম দেয়।"
    },
    {
      "ayah": 4,
      "start_ms": 11664,
      "end_ms": 15050,
      "duration_ms": 3386,
      "text": "তারা কি বিশ্বাস করে না যে, তারা পুনরুথিত হবে।"
    },
    {
      "ayah": 5,
      "start_ms": 15050,
      "end_ms": 15652,
      "duration_ms": 602,
      "text": "মহাদিনে?"
    },
    {
      "ayah": 6,
      "start_ms": 15652,
      "end_ms": 19415,
      "duration_ms": 3763,
      "text": "যেদিন দাঁড়াবে সমস্ত মানুষ সৃষ্টিকুলের রবের সামনে!"
    },
    {
      "ayah": 7,
      "start_ms": 19415,
      "end_ms": 22801,
      "duration_ms": 3386,
      "text": "কখনো না, পাপাচারীদের আমলনামা তো সিজ্জীনে আছে।"
    },
    {
      "ayah": 8,
      "start_ms": 22801,
      "end_ms": 25284,
      "duration_ms": 2483,
      "text": "আর কিসে আপনাকে জানাবে সিজ্জীন কী?"
    },
    {
      "ayah": 9,
      "start_ms": 25284,
      "end_ms": 26488,
      "duration_ms": 1204,
      "text": "চিহ্নিত আমলনামা।"
    },
    {
      "ayah": 10,
      "start_ms": 26488,
      "end_ms": 29122,
      "duration_ms": 2634,
      "text": "সেদিন দুর্ভোগ হবে মিথ্যারোপকারীদের,"
    },
    {
      "ayah": 11,
      "start_ms": 29122,
      "end_ms": 31680,
      "duration_ms": 2558,
      "text": "যারা প্রতিদান দিবসে মিথ্যারোপ করে,"
    },
    {
      "ayah": 12,
      "start_ms": 31680,
      "end_ms": 36045,
      "duration_ms": 4365,
      "text": "আর শুধু প্রত্যেক পাপিষ্ঠ সীমালংঘনকারীই এতে মিথ্যারোপ করে;।"
    },
    {
      "ayah": 13,
      "start_ms": 36045,
      "end_ms": 42592,
      "duration_ms": 6547,
      "text": "যখন তার কাছে আমাদের আয়াতসমূহ তেলাওয়াত করা হয় তখন সে বলে, (এ তো) পূর্ববর্তীদের উপকথা।"
    },
    {
      "ayah": 14,
      "start_ms": 42592,
      "end_ms": 47408,
      "duration_ms": 4816,
      "text": "কখনো নয়; বরং তারা যা অর্জন করেছে তা ই তাদের হৃদয়ে জঙ ধরিয়েছে।"
    },
    {
      "ayah": 15,
      "start_ms": 47408,
      "end_ms": 51773,
      "duration_ms": 4365,
      "text": "কখনো নয়; নিশ্চয় সেদিন তারা তাদের রব হতে অন্তরিত থাকবে ;।"
    },
    {
      "ayah": 16,
      "start_ms": 51773,
      "end_ms": 54783,
      "duration_ms": 3010,
      "text": "তারপর নিশ্চয় তারা জাহান্নামে দগ্ধ হবে;।"
    },
    {
      "ayah": 17,
      "start_ms": 54783,
      "end_ms": 58470,
      "duration_ms": 3687,
      "text": "তারপর বলা হবে, এটাই তা যাতে তোমরা মিথ্যারোপ করতে।"
    },
    {
      "ayah": 18,
      "start_ms": 58470,
      "end_ms": 62458,
      "duration_ms": 3988,
      "text": "কখনো নয়, নিশ্চয় পূণ্যবানদের আমলনামা ইল্লিয়ইয়্যীনে,"
    },
    {
      "ayah": 19,
      "start_ms": 62458,
      "end_ms": 65242,
      "duration_ms": 2784,
      "text": "আর কিসে আপনাকে জানাবে ইল্লিয়্যীন কী?"
    },
    {
      "ayah": 20,
      "start_ms": 65242,
      "end_ms": 66446,
      "duration_ms": 1204,
      "text": "চিহ্নিত আমলনামা।"
    },
    {
      "ayah": 21,
      "start_ms": 66446,
      "end_ms": 69757,
      "duration_ms": 3311,
      "text": "(আল্লাহর) সান্নিধ্যপ্রাপ্তরাই তা অবলোকন করে।"
    },
    {
      "ayah": 22,
      "start_ms": 69757,
      "end_ms": 72993,
      "duration_ms": 3236,
      "text": "নিশ্চয় পুণ্যবানগণ থাকবে পরম স্বাচ্ছন্দ্যে,"
    },
    {
      "ayah": 23,
      "start_ms": 72993,
      "end_ms": 75627,
      "duration_ms": 2634,
      "text": "সুসজ্জিত আসনে বসে তারা দেখতে থাকবে।"
    },
    {
      "ayah": 24,
      "start_ms": 75627,
      "end_ms": 79766,
      "duration_ms": 4139,
      "text": "আপনি তাদের মুখমণ্ডলে স্বাচ্ছন্দ্যের দীপ্তি দেখতে পাবেন,"
    },
    {
      "ayah": 25,
      "start_ms": 79766,
      "end_ms": 83529,
      "duration_ms": 3763,
      "text": "তাদেরকে মোহর করা বিশুদ্ধ পানীয় হতে পান করান হবে;।"
    },
    {
      "ayah": 26,
      "start_ms": 83529,
      "end_ms": 88270,
      "duration_ms": 4741,
      "text": "যার মোহর হবে মিসকে্র, আর এ বিষয়ে প্রতিযোগীরা প্রতিযোগিতা করুক।"
    },
    {
      "ayah": 27,
      "start_ms": 88270,
      "end_ms": 90377,
      "duration_ms": 2107,
      "text": "আর তার মিশ্রণ হবে তাস্নীমের,"
    },
    {
      "ayah": 28,
      "start_ms": 90377,
      "end_ms": 94290,
      "duration_ms": 3913,
      "text": "এটা এক প্রস্রবণ, যা থেকে সান্নিধ্যপ্রাপ্তরা পান করে।"
    },
    {
      "ayah": 29,
      "start_ms": 94290,
      "end_ms": 98053,
      "duration_ms": 3763,
      "text": "নিশ্চয় যারা অপরাধ করেছে তারা মুমিনদেরকে উপহাস করত।"
    },
    {
      "ayah": 30,
      "start_ms": 98053,
      "end_ms": 103020,
      "duration_ms": 4967,
      "text": "আর যখন তারা মুমিনদের কাছ দিয়ে যেত তখন তারা চোখ টিপে বিদ্ররূপ করত।"
    },
    {
      "ayah": 31,
      "start_ms": 103020,
      "end_ms": 107686,
      "duration_ms": 4666,
      "text": "আর যখন তাদের আপনজনের কাছে ফিরে আসত তখন তারা ফিরত উৎফুল্ল হয়ে,"
    },
    {
      "ayah": 32,
      "start_ms": 107686,
      "end_ms": 111674,
      "duration_ms": 3988,
      "text": "আর যখন মুমিনদেরকে দেখত তখন বলত, নিশ্চয় এরা পথভ্রষ্ট।"
    },
    {
      "ayah": 33,
      "start_ms": 111674,
      "end_ms": 115587,
      "duration_ms": 3913,
      "text": "অথচ তাদেরকে মুমিনদের তত্ত্বাবধায়ক করে পাঠানো হয়নি।"
    },
    {
      "ayah": 34,
      "start_ms": 115587,
      "end_ms": 118446,
      "duration_ms": 2859,
      "text": "অতএব আজ মুমিনগণ উপহাস করবে কাফিরদেরকে,"
    },
    {
      "ayah": 35,
      "start_ms": 118446,
      "end_ms": 121080,
      "duration_ms": 2634,
      "text": "সুসজ্জিত আসনে বসে তারা দেখতে থাকবে।"
    },
    {
      "ayah": 36,
      "start_ms": 121080,
      "end_ms": 123638,
      "duration_ms": 2558,
      "text": "কাফিররা তাদের কৃতকর্মের ফল পেল তো?"
    }
  ]
}