{
  "surah": 91,
  "name_translit": "Ash-Shams",
  "name_bn": "আশ-শামস",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 57644,
  "total_ayat": 15,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1995,
      "duration_ms": 1995,
      "text": "শপথ সূর্যের এবং তার কিরণের,"
    },
    {
      "ayah": 2,
      "start_ms": 1995,
      "end_ms": 5173,
      "duration_ms": 3178,
      "text": "শপথ চাঁদের, যখন তা সূর্যের পর আবির্ভূত হয়,"
    },
    {
      "ayah": 3,
      "start_ms": 5173,
      "end_ms": 7907,
      "duration_ms": 2734,
      "text": "শপথ দিনের, যখন সে সূর্যকে প্রকাশ করে,"
    },
    {
      "ayah": 4,
      "start_ms": 7907,
      "end_ms": 10789,
      "duration_ms": 2882,
      "text": "শপথ রাতের, যখন সে সূর্যকে আচ্ছাদিত করে,"
    },
    {
      "ayah": 5,
      "start_ms": 10789,
      "end_ms": 14041,
      "duration_ms": 3252,
      "text": "শপথ আসমানের এবং যিনি তা নির্মাণ করেছেন তাঁর,"
    },
    {
      "ayah": 6,
      "start_ms": 14041,
      "end_ms": 17219,
      "duration_ms": 3178,
      "text": "শপথ জমিনের এবং যিনি তা বিস্তৃত করেছেন তাঁর,"
    },
    {
      "ayah": 7,
      "start_ms": 17219,
      "end_ms": 20618,
      "duration_ms": 3399,
      "text": "শপথ নফ্সের এবং যিনি তা সুবিন্যস্ত করেছেন তাঁর,"
    },
    {
      "ayah": 8,
      "start_ms": 20618,
      "end_ms": 25052,
      "duration_ms": 4434,
      "text": "তারপর তাকে তার সৎকাজের এবং তার অসৎ-কাজের জ্ঞান দান করেছেন –।"
    },
    {
      "ayah": 9,
      "start_ms": 25052,
      "end_ms": 28230,
      "duration_ms": 3178,
      "text": "সে-ই সফলকাম হয়েছে, যে নিজেকে পবিত্র করেছে।"
    },
    {
      "ayah": 10,
      "start_ms": 28230,
      "end_ms": 31629,
      "duration_ms": 3399,
      "text": "আর সে-ই ব্যর্থ হয়েছে, যে নিজেকে কলুষিত করেছে।"
    },
    {
      "ayah": 11,
      "start_ms": 31629,
      "end_ms": 35028,
      "duration_ms": 3399,
      "text": "সামূদ সম্প্রদায় অবাধ্যতাবশত মিথ্যারোপ করেছিল।"
    },
    {
      "ayah": 12,
      "start_ms": 35028,
      "end_ms": 39019,
      "duration_ms": 3991,
      "text": "তাদের মধ্যে যে সর্বাধিক হতভাগ্য, সে যখন তৎপর হয়ে উঠল,"
    },
    {
      "ayah": 13,
      "start_ms": 39019,
      "end_ms": 45597,
      "duration_ms": 6578,
      "text": "তখন আল্লাহর রাসূল তাদেরকে বললেন, আল্লাহর উষ্ট্রী ও তাকে পানি পান করানোর বিষয়ে সাবধান হও।"
    },
    {
      "ayah": 14,
      "start_ms": 45597,
      "end_ms": 55279,
      "duration_ms": 9682,
      "text": "কিন্তু তারা তার প্রতি মিথ্যারোপ করল এবং উষ্ট্রীকে জবাই করল। ফলে তাদের পাপের জন্য তাদের রব তাদেরকে সমূলে ধ্বংস করে একাকার করে দিলেন।"
    },
    {
      "ayah": 15,
      "start_ms": 55279,
      "end_ms": 57644,
      "duration_ms": 2365,
      "text": "আর তিনি এর পরিণামকে ভয় করেন না।"
    }
  ]
}