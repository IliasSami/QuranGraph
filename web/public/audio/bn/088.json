{
  "surah": 88,
  "name_translit": "Al-Ghaashiya",
  "name_bn": "আল-গাশিয়াহ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 73662,
  "total_ayat": 26,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 3873,
      "duration_ms": 3873,
      "text": "আপনার কাছে কি আচ্ছন্নকারীর (কিয়ামতের) সংবাদ এসেছে?"
    },
    {
      "ayah": 2,
      "start_ms": 3873,
      "end_ms": 5923,
      "duration_ms": 2050,
      "text": "সেদিন অনেক চেহারা হবে অবনত,"
    },
    {
      "ayah": 3,
      "start_ms": 5923,
      "end_ms": 7214,
      "duration_ms": 1291,
      "text": "ক্লিষ্ট, ক্লান্ত,"
    },
    {
      "ayah": 4,
      "start_ms": 7214,
      "end_ms": 9720,
      "duration_ms": 2506,
      "text": "তারা প্রবেশ করবে জ্বলন্ত আগুনে ;।"
    },
    {
      "ayah": 5,
      "start_ms": 9720,
      "end_ms": 13517,
      "duration_ms": 3797,
      "text": "তাদেরকে অত্যন্ত উষ্ণ প্রস্রবণ থেকে পান করানো হবে;।"
    },
    {
      "ayah": 6,
      "start_ms": 13517,
      "end_ms": 17162,
      "duration_ms": 3645,
      "text": "তাদের জন্য খাদ্য থাকবে না কাঁটাযুক্ত গুল্ম ছাড়া,"
    },
    {
      "ayah": 7,
      "start_ms": 17162,
      "end_ms": 21567,
      "duration_ms": 4405,
      "text": "যা তাদেরকে পুষ্ট করবে না এবং তাদের ক্ষুধা নিবৃত্ত করবে না।"
    },
    {
      "ayah": 8,
      "start_ms": 21567,
      "end_ms": 24377,
      "duration_ms": 2810,
      "text": "অনেক মুখমণ্ডল সেদিন হবে আনন্দোজ্জ্বল,"
    },
    {
      "ayah": 9,
      "start_ms": 24377,
      "end_ms": 26731,
      "duration_ms": 2354,
      "text": "নিজেদের কাজের সাফল্যে পরিতৃপ্ত,"
    },
    {
      "ayah": 10,
      "start_ms": 26731,
      "end_ms": 28174,
      "duration_ms": 1443,
      "text": "সুউচ্চ জান্নাতে---।"
    },
    {
      "ayah": 11,
      "start_ms": 28174,
      "end_ms": 30604,
      "duration_ms": 2430,
      "text": "সেখানে তারা অসার বাক্য শুনবে না,"
    },
    {
      "ayah": 12,
      "start_ms": 30604,
      "end_ms": 32730,
      "duration_ms": 2126,
      "text": "সেখানে থাকবে বহমান প্রস্রবণ,"
    },
    {
      "ayah": 13,
      "start_ms": 32730,
      "end_ms": 34932,
      "duration_ms": 2202,
      "text": "সেখানে থাকবে উন্নত শয্যাসমূহ,"
    },
    {
      "ayah": 14,
      "start_ms": 34932,
      "end_ms": 36982,
      "duration_ms": 2050,
      "text": "আর প্রস্তুত থাকবে পানপাত্র,"
    },
    {
      "ayah": 15,
      "start_ms": 36982,
      "end_ms": 38273,
      "duration_ms": 1291,
      "text": "সারি সারি উপাধান।"
    },
    {
      "ayah": 16,
      "start_ms": 38273,
      "end_ms": 39716,
      "duration_ms": 1443,
      "text": "এবং বিছানা গালিচা;।"
    },
    {
      "ayah": 17,
      "start_ms": 39716,
      "end_ms": 44804,
      "duration_ms": 5088,
      "text": "তবে কি তারা তাকিয়ে দেখে না উটের দিকে, কিভাবে তা সৃষ্টি করা হয়েছে?"
    },
    {
      "ayah": 18,
      "start_ms": 44804,
      "end_ms": 48905,
      "duration_ms": 4101,
      "text": "এবং আসমানের দিকে, কিভাবে তা উর্ধ্বে স্থাপন করা হয়েছে?"
    },
    {
      "ayah": 19,
      "start_ms": 48905,
      "end_ms": 52930,
      "duration_ms": 4025,
      "text": "এবং পর্বতমালার দিকে, কিভাবে তা প্রতিষ্ঠিত করা হয়েছে?"
    },
    {
      "ayah": 20,
      "start_ms": 52930,
      "end_ms": 56423,
      "duration_ms": 3493,
      "text": "এবং ভূতলের দিকে, কিভাবে তা বিস্তৃত করা হয়েছে?"
    },
    {
      "ayah": 21,
      "start_ms": 56423,
      "end_ms": 60220,
      "duration_ms": 3797,
      "text": "অতএব আপনি উপদেশ দিন; আপনি তো কেবল একজন উপদেশ দাতা,"
    },
    {
      "ayah": 22,
      "start_ms": 60220,
      "end_ms": 62954,
      "duration_ms": 2734,
      "text": "আপনি তাদের উপর শক্তি প্রয়োগকারী নন।"
    },
    {
      "ayah": 23,
      "start_ms": 62954,
      "end_ms": 65840,
      "duration_ms": 2886,
      "text": "তবে কেউ মুখ ফিরিয়ে নিলে ও কুফরী করলে।"
    },
    {
      "ayah": 24,
      "start_ms": 65840,
      "end_ms": 68194,
      "duration_ms": 2354,
      "text": "আল্লাহ তাদেরকে দেবেন মহাশাস্তি।"
    },
    {
      "ayah": 25,
      "start_ms": 68194,
      "end_ms": 70928,
      "duration_ms": 2734,
      "text": "নিশ্চয় তাদের ফিরে আসা আমাদেরই কাছে;।"
    },
    {
      "ayah": 26,
      "start_ms": 70928,
      "end_ms": 73662,
      "duration_ms": 2734,
      "text": "তারপর তাদের হিসেব-নিকেশ আমাদেরই কাজ।"
    }
  ]
}