{
  "surah": 94,
  "name_translit": "Ash-Sharh",
  "name_bn": "আশ-শারহ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 25920,
  "total_ayat": 8,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 4018,
      "duration_ms": 4018,
      "text": "আমরা কি আপনার বক্ষ আপনার কল্যাণে প্রশস্ত করে দেইনি?"
    },
    {
      "ayah": 2,
      "start_ms": 4018,
      "end_ms": 6460,
      "duration_ms": 2442,
      "text": "আর আমরা অপসারণ করেছি আপনার ভার,"
    },
    {
      "ayah": 3,
      "start_ms": 6460,
      "end_ms": 8666,
      "duration_ms": 2206,
      "text": "যা আপনার পিঠ ভেঙ্গে দিচ্ছিল।"
    },
    {
      "ayah": 4,
      "start_ms": 8666,
      "end_ms": 13787,
      "duration_ms": 5121,
      "text": "আর আমরা আপনার (মর্যাদা বৃদ্ধির) জন্য আপনার স্মরণকে সমুন্নত করেছি।"
    },
    {
      "ayah": 5,
      "start_ms": 13787,
      "end_ms": 16544,
      "duration_ms": 2757,
      "text": "সুতরাং কষ্টের সাথেই তো স্বস্তি আছে,"
    },
    {
      "ayah": 6,
      "start_ms": 16544,
      "end_ms": 19144,
      "duration_ms": 2600,
      "text": "নিশ্চয় কষ্টের সাথেই স্বস্তি আছে।"
    },
    {
      "ayah": 7,
      "start_ms": 19144,
      "end_ms": 23005,
      "duration_ms": 3861,
      "text": "অতএব আপনি যখনই অবসর পান তখনই কঠোর ইবাদাতে রত হোন।"
    },
    {
      "ayah": 8,
      "start_ms": 23005,
      "end_ms": 25920,
      "duration_ms": 2915,
      "text": "আর আপনার রবের প্রতি গভীর মনোযোগী হোন।"
    }
  ]
}