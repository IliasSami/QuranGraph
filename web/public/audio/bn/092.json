{
  "surah": 92,
  "name_translit": "Al-Lail",
  "name_bn": "আল-লায়ল",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 65226,
  "total_ayat": 21,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2262,
      "duration_ms": 2262,
      "text": "শপথ রাতের, যখন সে আচ্ছন্ন করে,"
    },
    {
      "ayah": 2,
      "start_ms": 2262,
      "end_ms": 4599,
      "duration_ms": 2337,
      "text": "শপথ দিনের, যখন তা উদ্ভাসিত হয়।"
    },
    {
      "ayah": 3,
      "start_ms": 4599,
      "end_ms": 7615,
      "duration_ms": 3016,
      "text": "শপথ তাঁর, যিনি নর ও নারী সৃষ্টি করেছেন-।"
    },
    {
      "ayah": 4,
      "start_ms": 7615,
      "end_ms": 11084,
      "duration_ms": 3469,
      "text": "নিশ্চয় তোমাদের কর্মপ্রচেষ্টা বিভিন্ন প্রকৃতির।"
    },
    {
      "ayah": 5,
      "start_ms": 11084,
      "end_ms": 14176,
      "duration_ms": 3092,
      "text": "কাজেই কেউ দান করলে, তাকওয়া অবলম্বন করলে।"
    },
    {
      "ayah": 6,
      "start_ms": 14176,
      "end_ms": 16891,
      "duration_ms": 2715,
      "text": "এবং যা উত্তম তা সত্য বলে গ্রহণ করলে,"
    },
    {
      "ayah": 7,
      "start_ms": 16891,
      "end_ms": 19455,
      "duration_ms": 2564,
      "text": "আমরা তার জন্য সুগম করে দেব সহজ পথ।"
    },
    {
      "ayah": 8,
      "start_ms": 19455,
      "end_ms": 23376,
      "duration_ms": 3921,
      "text": "আর কেউ কার্পণ্য করলে এবং নিজকে অমুখাপেক্ষী মনে করলে,"
    },
    {
      "ayah": 9,
      "start_ms": 23376,
      "end_ms": 25789,
      "duration_ms": 2413,
      "text": "আর যা উত্তম তাতে মিথ্যারোপ করলে,"
    },
    {
      "ayah": 10,
      "start_ms": 25789,
      "end_ms": 28428,
      "duration_ms": 2639,
      "text": "তার জন্য আমরা সুগম করে দেব কঠোর পথ।"
    },
    {
      "ayah": 11,
      "start_ms": 28428,
      "end_ms": 32425,
      "duration_ms": 3997,
      "text": "আর তার সম্পদ তার কোনো কাজে আসবে না, যখন সে ধ্বংস হবে।"
    },
    {
      "ayah": 12,
      "start_ms": 32425,
      "end_ms": 35290,
      "duration_ms": 2865,
      "text": "নিশ্চয় আমাদের কাজ শুধু পথনির্দেশ করা,"
    },
    {
      "ayah": 13,
      "start_ms": 35290,
      "end_ms": 38985,
      "duration_ms": 3695,
      "text": "আর আমরাই তো মালিক আখেরাতের ও প্রথমটির (দুনিয়ার)।"
    },
    {
      "ayah": 14,
      "start_ms": 38985,
      "end_ms": 43510,
      "duration_ms": 4525,
      "text": "অতঃপর আমি তোমাদেরকে লেলিহান আগুন সম্পর্কে সতর্ক করে দিয়েছি।"
    },
    {
      "ayah": 15,
      "start_ms": 43510,
      "end_ms": 46677,
      "duration_ms": 3167,
      "text": "তাতে প্রবেশ করবে সে-ই, যে নিতান্ত হতভাগ্য,"
    },
    {
      "ayah": 16,
      "start_ms": 46677,
      "end_ms": 49392,
      "duration_ms": 2715,
      "text": "যে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।"
    },
    {
      "ayah": 17,
      "start_ms": 49392,
      "end_ms": 52408,
      "duration_ms": 3016,
      "text": "আর তা থেকে দূরে রাখা হবে পরম মুত্তাকীকে,"
    },
    {
      "ayah": 18,
      "start_ms": 52408,
      "end_ms": 55349,
      "duration_ms": 2941,
      "text": "যে স্বীয় সম্পদ দান করে আতশুদ্ধির জন্য।"
    },
    {
      "ayah": 19,
      "start_ms": 55349,
      "end_ms": 60024,
      "duration_ms": 4675,
      "text": "এবং তার প্রতি কারও এমন কোনো অনুগ্রহ নেই যার প্রতিদান দিতে হবে,"
    },
    {
      "ayah": 20,
      "start_ms": 60024,
      "end_ms": 63266,
      "duration_ms": 3242,
      "text": "শুধু তার মহান রবের সস্তুষ্টির প্রত্যাশায়;।"
    },
    {
      "ayah": 21,
      "start_ms": 63266,
      "end_ms": 65226,
      "duration_ms": 1960,
      "text": "আর অচিরেই সে সস্তুষ্ট হবে।"
    }
  ]
}