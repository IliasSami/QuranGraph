{
  "surah": 104,
  "name_translit": "Al-Humaza",
  "name_bn": "আল-হুমাযাহ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 28212,
  "total_ayat": 9,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 100,
      "end_ms": 4262,
      "duration_ms": 4162,
      "text": "দুর্ভোগ প্রত্যেকের, যে পিছনে ও সামনে লোকের নিন্দা করে,"
    },
    {
      "ayah": 2,
      "start_ms": 4212,
      "end_ms": 7562,
      "duration_ms": 3350,
      "text": "যে সম্পদ জমায় ও তা বার বার গণনা করে ;।"
    },
    {
      "ayah": 3,
      "start_ms": 7562,
      "end_ms": 11362,
      "duration_ms": 3800,
      "text": "সে ধারণা করে যে, তার অর্থ তাকে অমর করে রাখবে ;।"
    },
    {
      "ayah": 4,
      "start_ms": 11362,
      "end_ms": 14849,
      "duration_ms": 3487,
      "text": "কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে হুতামায় ;।"
    },
    {
      "ayah": 5,
      "start_ms": 14850,
      "end_ms": 17712,
      "duration_ms": 2862,
      "text": "আর আপনাকে কিসে জানাবে হুতামা কী?"
    },
    {
      "ayah": 6,
      "start_ms": 17712,
      "end_ms": 20262,
      "duration_ms": 2550,
      "text": "এটা আল্লাহর প্রজ্বলিত আগুন,"
    },
    {
      "ayah": 7,
      "start_ms": 20262,
      "end_ms": 22637,
      "duration_ms": 2375,
      "text": "যা হৃদয়কে গ্রাস করবে ;।"
    },
    {
      "ayah": 8,
      "start_ms": 22637,
      "end_ms": 25849,
      "duration_ms": 3212,
      "text": "নিশ্চয় এটা তাদেরকে পরিবেষ্টন করে রাখবে।"
    },
    {
      "ayah": 9,
      "start_ms": 25850,
      "end_ms": 28212,
      "duration_ms": 2362,
      "text": "দীর্ঘায়িত স্তম্ভসমূহে।"
    }
  ]
}