{
  "surah": 95,
  "name_translit": "At-Tin",
  "name_bn": "আত-তীন",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 28336,
  "total_ayat": 8,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1771,
      "duration_ms": 1771,
      "text": "শপথ তীন ও যায়তুন – এর,"
    },
    {
      "ayah": 2,
      "start_ms": 1771,
      "end_ms": 3234,
      "duration_ms": 1463,
      "text": "শপথ তুরে সীনীন -এর,"
    },
    {
      "ayah": 3,
      "start_ms": 3234,
      "end_ms": 4928,
      "duration_ms": 1694,
      "text": "শপথ এই নিরাপদ নগরীর -।"
    },
    {
      "ayah": 4,
      "start_ms": 4928,
      "end_ms": 8547,
      "duration_ms": 3619,
      "text": "অবশ্যই আমরা সৃষ্টি করেছি মানুষকে সুন্দরতম গঠনে,"
    },
    {
      "ayah": 5,
      "start_ms": 8547,
      "end_ms": 12397,
      "duration_ms": 3850,
      "text": "তারপর আমরা তাকে হীনতাগ্রস্তদের হীনতমে পরিণত করি –।"
    },
    {
      "ayah": 6,
      "start_ms": 12397,
      "end_ms": 19327,
      "duration_ms": 6930,
      "text": "কিন্তু তাদেরকে নয় যারা ঈমান এনেছে এবং সৎকর্ম করেছে; এদের জন্য তো আছে নিরবচ্ছিন্ন পুরস্কার।"
    },
    {
      "ayah": 7,
      "start_ms": 19327,
      "end_ms": 24640,
      "duration_ms": 5313,
      "text": "কাজেই (হে মানুষ!) এরপর কিসে তোমাকে কর্মফল দিন সম্পর্কে অবিশ্বাসী করে?"
    },
    {
      "ayah": 8,
      "start_ms": 24640,
      "end_ms": 28336,
      "duration_ms": 3696,
      "text": "আল্লাহ কি বিচারকদের মধ্যে সর্বশ্রেষ্ঠ বিচারক নন?"
    }
  ]
}