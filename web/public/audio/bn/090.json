{
  "surah": 90,
  "name_translit": "Al-Balad",
  "name_bn": "আল-বালাদ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 63077,
  "total_ayat": 20,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1718,
      "duration_ms": 1718,
      "text": "আমি শপথ করছি এ নগরের।"
    },
    {
      "ayah": 2,
      "start_ms": 1718,
      "end_ms": 3681,
      "duration_ms": 1963,
      "text": "আর আপনি এ নগরের অধিবাসী,"
    },
    {
      "ayah": 3,
      "start_ms": 3681,
      "end_ms": 6544,
      "duration_ms": 2863,
      "text": "শপথ জন্মদাতার ও যা সে জন্ম দিয়েছে।"
    },
    {
      "ayah": 4,
      "start_ms": 6544,
      "end_ms": 11126,
      "duration_ms": 4582,
      "text": "নিঃসন্দেহে আমরা মানুষকে সৃষ্টি করেছি কষ্ট-ক্লেশের মধ্যে।"
    },
    {
      "ayah": 5,
      "start_ms": 11126,
      "end_ms": 15380,
      "duration_ms": 4254,
      "text": "সে কি মনে করে যে, কখনো তার উপর কেউ ক্ষমতাবান হবে না?"
    },
    {
      "ayah": 6,
      "start_ms": 15380,
      "end_ms": 18407,
      "duration_ms": 3027,
      "text": "সে বলে, আমি প্রচুর অর্থ নিঃশেষ করেছি।"
    },
    {
      "ayah": 7,
      "start_ms": 18407,
      "end_ms": 21189,
      "duration_ms": 2782,
      "text": "সে কি মনে করে যে, তাকে কেউ দেখেনি?"
    },
    {
      "ayah": 8,
      "start_ms": 21189,
      "end_ms": 24134,
      "duration_ms": 2945,
      "text": "আমরা কি তার জন্য সৃষ্টি করিনি দুচোখ?"
    },
    {
      "ayah": 9,
      "start_ms": 24134,
      "end_ms": 25852,
      "duration_ms": 1718,
      "text": "আর জিহ্বা ও দুই ঠোঁট?"
    },
    {
      "ayah": 10,
      "start_ms": 25852,
      "end_ms": 28388,
      "duration_ms": 2536,
      "text": "আর আমরা তাকে দেখিয়েছি দুটি পথ।"
    },
    {
      "ayah": 11,
      "start_ms": 28388,
      "end_ms": 31497,
      "duration_ms": 3109,
      "text": "তবে সে তো বন্ধুর গিরিপথে প্রবেশ করেনি।"
    },
    {
      "ayah": 12,
      "start_ms": 31497,
      "end_ms": 34851,
      "duration_ms": 3354,
      "text": "আর কিসে আপনাকে জানাবে-- বন্ধুর গিরিপথ কী?"
    },
    {
      "ayah": 13,
      "start_ms": 34851,
      "end_ms": 36569,
      "duration_ms": 1718,
      "text": "এটা হচ্ছে: দাসমুক্তি।"
    },
    {
      "ayah": 14,
      "start_ms": 36569,
      "end_ms": 39269,
      "duration_ms": 2700,
      "text": "অথবা দুর্ভিক্ষের দিনে খাদ্যদান —।"
    },
    {
      "ayah": 15,
      "start_ms": 39269,
      "end_ms": 40741,
      "duration_ms": 1472,
      "text": "ইয়াতীম আত্মীয়কে,"
    },
    {
      "ayah": 16,
      "start_ms": 40741,
      "end_ms": 43359,
      "duration_ms": 2618,
      "text": "অথবা দারিদ্র-নিষ্পেষিত নিঃস্বকে,"
    },
    {
      "ayah": 17,
      "start_ms": 43359,
      "end_ms": 54487,
      "duration_ms": 11128,
      "text": "তদুপরি সে তাদের অন্তর্ভুক্ত হয়ে যায় যারা ঈমান এনেছে এবং পরস্পরকে উপদেশ দিয়েছে ধৈর্য ধারণের, আর পরস্পর উপদেশ দিয়েছে দয়া অনুগ্রহের ;।"
    },
    {
      "ayah": 18,
      "start_ms": 54487,
      "end_ms": 55959,
      "duration_ms": 1472,
      "text": "তারাই সৌভাগ্যশালী।"
    },
    {
      "ayah": 19,
      "start_ms": 55959,
      "end_ms": 60295,
      "duration_ms": 4336,
      "text": "আর যারা আমাদের আয়াতসমূহে কুফরী করেছে, তারাই হতভাগ্য।"
    },
    {
      "ayah": 20,
      "start_ms": 60295,
      "end_ms": 63077,
      "duration_ms": 2782,
      "text": "তারা পরিবেষ্টিত হবে অবরুদ্ধ আগুনে।"
    }
  ]
}