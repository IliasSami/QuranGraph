{
  "surah": 100,
  "name_translit": "Al-Aadiyaat",
  "name_bn": "আল-'আদিয়াত",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 32856,
  "total_ayat": 11,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2466,
      "duration_ms": 2466,
      "text": "শপথ ঊর্ধ্বশ্বাসে ধাবমান অশ্বরাজির,"
    },
    {
      "ayah": 2,
      "start_ms": 2466,
      "end_ms": 6455,
      "duration_ms": 3989,
      "text": "অতঃপর যারা ক্ষুরের আঘাতে অগ্নি-স্ফুলিঙ্গ বিচ্ছুরিত করে,"
    },
    {
      "ayah": 3,
      "start_ms": 6455,
      "end_ms": 8848,
      "duration_ms": 2393,
      "text": "অতঃপর যারা অভিযান করে প্রভাতকালে,"
    },
    {
      "ayah": 4,
      "start_ms": 8848,
      "end_ms": 11749,
      "duration_ms": 2901,
      "text": "ফলে তারা তা দ্বারা ধূলি উৎক্ষিপ্ত করে ;।"
    },
    {
      "ayah": 5,
      "start_ms": 11749,
      "end_ms": 15085,
      "duration_ms": 3336,
      "text": "অতঃপর তা দ্বারা শত্রু দলের অভ্যন্তরে ঢুকে পরে।"
    },
    {
      "ayah": 6,
      "start_ms": 15085,
      "end_ms": 18131,
      "duration_ms": 3046,
      "text": "নিশ্চয় মানুষ তার রবের প্রতি বড়ই অকৃতজ্ঞ।"
    },
    {
      "ayah": 7,
      "start_ms": 18131,
      "end_ms": 20307,
      "duration_ms": 2176,
      "text": "আর নিশ্চয় সে এ বিষয়ে সাক্ষী,"
    },
    {
      "ayah": 8,
      "start_ms": 20307,
      "end_ms": 23208,
      "duration_ms": 2901,
      "text": "আর নিশ্চয় সে ধন-সম্পদের আসক্তিতে প্রবল।"
    },
    {
      "ayah": 9,
      "start_ms": 23208,
      "end_ms": 26690,
      "duration_ms": 3482,
      "text": "তবে কি সে জানে না যখন কবরে যা আছে তা উত্থিত হবে,"
    },
    {
      "ayah": 10,
      "start_ms": 26690,
      "end_ms": 29229,
      "duration_ms": 2539,
      "text": "আর অন্তরে যা আছে তা প্রকাশ করা হবে?"
    },
    {
      "ayah": 11,
      "start_ms": 29229,
      "end_ms": 32856,
      "duration_ms": 3627,
      "text": "নিশ্চয় তাদের রব সেদিন তাদের ব্যাপারে সবিশেষ অবহিত।"
    }
  ]
}