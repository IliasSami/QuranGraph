  "ayat": [
    {
      "ayah": 1,
      "start_ms": 100,
      "end_ms": 3625,
      "duration_ms": 3525,
      "text": "আপনি কি দেখেছেন তাকে, যে দীনকে অস্বীকার করে?"
    },
    {
      "ayah": 2,
      "start_ms": 3575,
      "end_ms": 7050,
      "duration_ms": 3475,
      "text": "সে তো সে-ই, যে ইয়াতীমকে রূঢ়ভাবে তাড়িয়ে দেয়।"
    },
    {
      "ayah": 3,
      "start_ms": 7050,
      "end_ms": 10450,
      "duration_ms": 3400,
      "text": "আর সে উদ্ধুদ্ধ করে না মিসকীনদের খাদ্য দানে।"
    },
    {
      "ayah": 4,
      "start_ms": 10450,
      "end_ms": 13412,
      "duration_ms": 2962,
      "text": "কাজেই দুর্ভোগ সে সালাত আদায়কারীদের,"
    },
    {
      "ayah": 5,
      "start_ms": 13412,
      "end_ms": 16249,
      "duration_ms": 2837,
      "text": "যারা তাদের সালাত সম্বন্ধে উদাসীন,"
    },
    {
      "ayah": 6,
      "start_ms": 16250,
      "end_ms": 18912,
      "duration_ms": 2662,
      "text": "যারা লোক দেখানোর জন্য তা করে।"
    },
    {
      "ayah": 7,
      "start_ms": 18912,
      "end_ms": 21724,
      "duration_ms": 2812,
      "text": "এবং মাউন প্ৰদান করতে বিরত থাকে।"
    }
  ]
}