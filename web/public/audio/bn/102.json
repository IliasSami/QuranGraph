{
  "surah": 102,
  "name_translit": "At-Takaathur",
  "name_bn": "আত-তাকাসুর",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 27512,
  "total_ayat": 8,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 100,
      "end_ms": 3787,
      "duration_ms": 3687,
      "text": "তোমাদেরকে মোহাচ্ছন্ন রাখে প্রাচুর্যের প্রতিযোগিতা।"
    },
    {
      "ayah": 2,
      "start_ms": 3737,
      "end_ms": 6687,
      "duration_ms": 2950,
      "text": "যতক্ষণ না তোমরা কবরে উপনীত হও।"
    },
    {
      "ayah": 3,
      "start_ms": 6687,
      "end_ms": 9699,
      "duration_ms": 3012,
      "text": "কখনো নয়, তোমরা শীঘ্রই জানতে পারবে ;।"
    },
    {
      "ayah": 4,
      "start_ms": 9700,
      "end_ms": 13262,
      "duration_ms": 3562,
      "text": "তারপর, কখনো নয়, তোমরা শীঘ্রই জানতে পারবে:।"
    },
    {
      "ayah": 5,
      "start_ms": 13262,
      "end_ms": 14887,
      "duration_ms": 1625,
      "text": "কখনো নয়! যদি তোমরা নিশ্চিত জ্ঞানে জ্ঞানী হতে--।"
    },
    {
      "ayah": 6,
      "start_ms": 14887,
      "end_ms": 17812,
      "duration_ms": 2925,
      "text": "অবশ্যই তোমরা জাহান্নাম দেখবে;।"
    },
    {
      "ayah": 7,
      "start_ms": 17812,
      "end_ms": 20437,
      "duration_ms": 2625,
      "text": "তারপর অবশ্যই তোমরা তা দেখবে চাক্ষুষ প্রত্যয়ে,"
    },
    {
      "ayah": 8,
      "start_ms": 20437,
      "end_ms": 27512,
      "duration_ms": 7075,
      "text": "তারপর অবশ্যই সেদিন তোমাদেরকে নেয়ামত সম্পর্কে প্রশ্ন করা হবে।"
    }
  ]
}