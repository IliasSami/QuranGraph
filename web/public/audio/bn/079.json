{
  "surah": 79,
  "name_translit": "An-Naazi'aat",
  "name_bn": "আন-নাযি'আত",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 152250,
  "total_ayat": 46,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2273,
      "duration_ms": 2273,
      "text": "শপথ নির্মমভাবে উৎপাটনকারীদের,"
    },
    {
      "ayah": 2,
      "start_ms": 2273,
      "end_ms": 4625,
      "duration_ms": 2352,
      "text": "আর মৃদুভাবে বন্ধনমুক্তকারীদের।"
    },
    {
      "ayah": 3,
      "start_ms": 4625,
      "end_ms": 6898,
      "duration_ms": 2273,
      "text": "আর তীব্র গতিতে সন্তরণকারীদের,"
    },
    {
      "ayah": 4,
      "start_ms": 6898,
      "end_ms": 8936,
      "duration_ms": 2038,
      "text": "আর দ্রুতবেগে অগ্রসরমানদের,"
    },
    {
      "ayah": 5,
      "start_ms": 8936,
      "end_ms": 11131,
      "duration_ms": 2195,
      "text": "অতঃপর সব কাজ নির্বাহকারীদের।"
    },
    {
      "ayah": 6,
      "start_ms": 11131,
      "end_ms": 13875,
      "duration_ms": 2744,
      "text": "সেদিন প্রকম্পিতকারী প্রকম্পিত করবে,"
    },
    {
      "ayah": 7,
      "start_ms": 13875,
      "end_ms": 16619,
      "duration_ms": 2744,
      "text": "তাকে অনুসরণ করবে পরবর্তী কম্পনকারী,"
    },
    {
      "ayah": 8,
      "start_ms": 16619,
      "end_ms": 19049,
      "duration_ms": 2430,
      "text": "অনেক হৃদয় সেদিন সন্ত্রস্ত হবে,"
    },
    {
      "ayah": 9,
      "start_ms": 19049,
      "end_ms": 22185,
      "duration_ms": 3136,
      "text": "তাদের দৃষ্টিসমূহ ভীতি বিহ্বলতায় নত হবে।"
    },
    {
      "ayah": 10,
      "start_ms": 22185,
      "end_ms": 25478,
      "duration_ms": 3293,
      "text": "তারা বলে, আমরা কি আগের অবস্থায় ফিরে যাবই।"
    },
    {
      "ayah": 11,
      "start_ms": 25478,
      "end_ms": 28457,
      "duration_ms": 2979,
      "text": "চূর্ণবিচূর্ণ অস্থিতে পরিণত হওয়ার পরও?"
    },
    {
      "ayah": 12,
      "start_ms": 28457,
      "end_ms": 33004,
      "duration_ms": 4547,
      "text": "তারা বলে, তাই যদি হয় তবে তো এটা এক সর্বনাশা প্রত্যাবর্তন।"
    },
    {
      "ayah": 13,
      "start_ms": 33004,
      "end_ms": 34964,
      "duration_ms": 1960,
      "text": "এ তো শুধু এক বিকট আওয়াজ,"
    },
    {
      "ayah": 14,
      "start_ms": 34964,
      "end_ms": 37473,
      "duration_ms": 2509,
      "text": "তখনই ময়দানে তাদের আবির্ভাব হবে।"
    },
    {
      "ayah": 15,
      "start_ms": 37473,
      "end_ms": 40452,
      "duration_ms": 2979,
      "text": "আপনার কাছে মূসার বৃত্তান্ত পৌঁছেছে কি?"
    },
    {
      "ayah": 16,
      "start_ms": 40452,
      "end_ms": 44842,
      "duration_ms": 4390,
      "text": "যখন তাঁর রব পবিত্র উপত্যকা তুওয়ায় তাঁকে ডেকে বলেছিলেন,"
    },
    {
      "ayah": 17,
      "start_ms": 44842,
      "end_ms": 48056,
      "duration_ms": 3214,
      "text": "ফিরআউনের কাছে যান, সে তো সীমালঙ্ঘন করেছে,"
    },
    {
      "ayah": 18,
      "start_ms": 48056,
      "end_ms": 51976,
      "duration_ms": 3920,
      "text": "অতঃপর বলুন, তোমার কি আগ্রহ আছে যে, তুমি পবিত্র হও।"
    },
    {
      "ayah": 19,
      "start_ms": 51976,
      "end_ms": 57386,
      "duration_ms": 5410,
      "text": "আর আমি তোমাকে তোমার রবের দিকে পথপ্রদর্শন করি, যাতে তুমি তাঁকে ভয় কর?"
    },
    {
      "ayah": 20,
      "start_ms": 57386,
      "end_ms": 60130,
      "duration_ms": 2744,
      "text": "অতঃপর তিনি তাকে মহানিদর্শন দেখালেন।"
    },
    {
      "ayah": 21,
      "start_ms": 60130,
      "end_ms": 63109,
      "duration_ms": 2979,
      "text": "কিন্তু সে মিথ্যারোপ করল এবং অবাধ্য হল।"
    },
    {
      "ayah": 22,
      "start_ms": 63109,
      "end_ms": 66402,
      "duration_ms": 3293,
      "text": "তারপর সে পিছনে ফিরে প্রতিবিধানে সচেষ্ট হল।"
    },
    {
      "ayah": 23,
      "start_ms": 66402,
      "end_ms": 69146,
      "duration_ms": 2744,
      "text": "অতঃপর সে সকলকে সমবেত করে ঘোষণা দিল,"
    },
    {
      "ayah": 24,
      "start_ms": 69146,
      "end_ms": 71968,
      "duration_ms": 2822,
      "text": "অতঃপর বলল, আমিই তোমাদের সর্বোচ্চ রব।"
    },
    {
      "ayah": 25,
      "start_ms": 71968,
      "end_ms": 77143,
      "duration_ms": 5175,
      "text": "অতঃপর আল্লাহ তাকে আখেরাতে ও দুনিয়ায় কঠিন শাস্তিতে পাকড়াও করলেন।"
    },
    {
      "ayah": 26,
      "start_ms": 77143,
      "end_ms": 80985,
      "duration_ms": 3842,
      "text": "নিশ্চয় যে ভয় করে তার জন্য তো এতে শিক্ষা রয়েছে।"
    },
    {
      "ayah": 27,
      "start_ms": 80985,
      "end_ms": 86473,
      "duration_ms": 5488,
      "text": "তোমাদেরকে সৃষ্টি করা কঠিন, না আসমান সৃষ্টি? তিনিই তা নির্মাণ করেছেন ;।"
    },
    {
      "ayah": 28,
      "start_ms": 86473,
      "end_ms": 90236,
      "duration_ms": 3763,
      "text": "তিনি এর ছাদকে সুউচ্চ করেছেন ও সুবিন্যস্ত করেছেন।"
    },
    {
      "ayah": 29,
      "start_ms": 90236,
      "end_ms": 95803,
      "duration_ms": 5567,
      "text": "আর তিনি এর রাতকে করেছেন অন্ধকারাচ্ছন্ন এবং প্রকাশ করেছেন এর সূর্যালোক;।"
    },
    {
      "ayah": 30,
      "start_ms": 95803,
      "end_ms": 98233,
      "duration_ms": 2430,
      "text": "আর যমীনকে এর পর বিস্তৃত করেছেন।"
    },
    {
      "ayah": 31,
      "start_ms": 98233,
      "end_ms": 101604,
      "duration_ms": 3371,
      "text": "তিনি তা থেকে বের করেছেন তার পানি ও তৃণভূমি,"
    },
    {
      "ayah": 32,
      "start_ms": 101604,
      "end_ms": 104818,
      "duration_ms": 3214,
      "text": "আর পর্বতকে তিনি দৃঢ়ভাবে প্রোথিত করেছেন;।"
    },
    {
      "ayah": 33,
      "start_ms": 104818,
      "end_ms": 108895,
      "duration_ms": 4077,
      "text": "এসব তোমাদের ও তোমাদের চতুষ্পদ জন্তুগুলোর ভোগের জন্য।"
    },
    {
      "ayah": 34,
      "start_ms": 108895,
      "end_ms": 111247,
      "duration_ms": 2352,
      "text": "অতঃপর যখন মহাসংকট উপস্থিত হবে।"
    },
    {
      "ayah": 35,
      "start_ms": 111247,
      "end_ms": 114226,
      "duration_ms": 2979,
      "text": "মানুষ যা করেছে তা সে সেদিন স্মরণ করবে,"
    },
    {
      "ayah": 36,
      "start_ms": 114226,
      "end_ms": 117519,
      "duration_ms": 3293,
      "text": "আর প্রকাশ করা হবে জাহান্নাম দর্শকদের জন্য,"
    },
    {
      "ayah": 37,
      "start_ms": 117519,
      "end_ms": 119400,
      "duration_ms": 1881,
      "text": "সুতরাং যে সীমালঙ্ঘন করে।"
    },
    {
      "ayah": 38,
      "start_ms": 119400,
      "end_ms": 122222,
      "duration_ms": 2822,
      "text": "এবং দুনিয়ার জীবনকে অগ্রাধিকার দেয়।"
    },
    {
      "ayah": 39,
      "start_ms": 122222,
      "end_ms": 124103,
      "duration_ms": 1881,
      "text": "জাহান্নামই হবে তার আবাস।"
    },
    {
      "ayah": 40,
      "start_ms": 124103,
      "end_ms": 129513,
      "duration_ms": 5410,
      "text": "আর যে তার রবের অবস্থানকে ভয় করে এবং কুপ্রবৃত্তি হতে নিজকে বিরত রাখে।"
    },
    {
      "ayah": 41,
      "start_ms": 129513,
      "end_ms": 131238,
      "duration_ms": 1725,
      "text": "জান্নাতই হবে তার আবাস।"
    },
    {
      "ayah": 42,
      "start_ms": 131238,
      "end_ms": 135550,
      "duration_ms": 4312,
      "text": "তারা আপনাকে জিজ্ঞেস করে, কিয়ামত সম্পর্কে, তা কখন ঘটবে?"
    },
    {
      "ayah": 43,
      "start_ms": 135550,
      "end_ms": 137902,
      "duration_ms": 2352,
      "text": "তা আলোচনার কি জ্ঞান আপনার আছে?"
    },
    {
      "ayah": 44,
      "start_ms": 137902,
      "end_ms": 140411,
      "duration_ms": 2509,
      "text": "এর পরম জ্ঞান আপনার রবেরই কাছে ;।"
    },
    {
      "ayah": 45,
      "start_ms": 140411,
      "end_ms": 143625,
      "duration_ms": 3214,
      "text": "যে এটার ভয় রাখে আপনি শুধু তার সতর্ককারী।"
    },
    {
      "ayah": 46,
      "start_ms": 143625,
      "end_ms": 152250,
      "duration_ms": 8625,
      "text": "যেদিন তারা তা দেখতে পাবে সেদিন তাদের মনে হবে যেন তারা দুনিয়ায় মাত্র এক সন্ধ্যা অথবা এক প্রভাত অবস্থান করেছে!"
    }
  ]
}