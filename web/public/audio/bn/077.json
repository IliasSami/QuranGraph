{
  "surah": 77,
  "name_translit": "Al-Mursalaat",
  "name_bn": "আল-মুরসালাত",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 158592,
  "total_ayat": 50,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2452,
      "duration_ms": 2452,
      "text": "শপথ কল্যাণস্বরূপ প্রেরিত বায়ুর,"
    },
    {
      "ayah": 2,
      "start_ms": 2452,
      "end_ms": 4291,
      "duration_ms": 1839,
      "text": "অতঃপর প্রলয়ংকরী ঝটিকার,"
    },
    {
      "ayah": 3,
      "start_ms": 4291,
      "end_ms": 6206,
      "duration_ms": 1915,
      "text": "শপথ প্রচণ্ড সঞ্চালনকারীর,"
    },
    {
      "ayah": 4,
      "start_ms": 6206,
      "end_ms": 8734,
      "duration_ms": 2528,
      "text": "অতঃপর সুস্পষ্টরূপে পার্থক্যকারীর,"
    },
    {
      "ayah": 5,
      "start_ms": 8734,
      "end_ms": 12565,
      "duration_ms": 3831,
      "text": "অতঃপর তাদের, যারা মানুষের অন্তরে পৌঁছে দেয় উপদেশ।"
    },
    {
      "ayah": 6,
      "start_ms": 12565,
      "end_ms": 15400,
      "duration_ms": 2835,
      "text": "ওযর আপত্তি রহিতকরণ ও সতর্ক করার জন্য।"
    },
    {
      "ayah": 7,
      "start_ms": 15400,
      "end_ms": 20074,
      "duration_ms": 4674,
      "text": "নিশ্চয় তোমাদেরকে যে প্রতিশ্রুতি দেয়া হয়েছে তা অবশ্যম্ভাবী।"
    },
    {
      "ayah": 8,
      "start_ms": 20074,
      "end_ms": 23062,
      "duration_ms": 2988,
      "text": "যখন নক্ষত্ররাজির আলো নির্বাপিত করা হবে,"
    },
    {
      "ayah": 9,
      "start_ms": 23062,
      "end_ms": 25207,
      "duration_ms": 2145,
      "text": "আর যখন আকাশ বিদীর্ণ করা হবে।"
    },
    {
      "ayah": 10,
      "start_ms": 25207,
      "end_ms": 28118,
      "duration_ms": 2911,
      "text": "আর যখন পর্বতমালা চূর্ণবিচূর্ণ করা হবে।"
    },
    {
      "ayah": 11,
      "start_ms": 28118,
      "end_ms": 31872,
      "duration_ms": 3754,
      "text": "আর যখন রাসূলগণকে নির্ধারিত সময়ে উপস্থিত করা হবে,"
    },
    {
      "ayah": 12,
      "start_ms": 31872,
      "end_ms": 34783,
      "duration_ms": 2911,
      "text": "এসব স্থগিত রাখা হয়েছে কোন দিনের জন্য?"
    },
    {
      "ayah": 13,
      "start_ms": 34783,
      "end_ms": 36085,
      "duration_ms": 1302,
      "text": "বিচার দিনের জন্য।"
    },
    {
      "ayah": 14,
      "start_ms": 36085,
      "end_ms": 38766,
      "duration_ms": 2681,
      "text": "আর আপনাকে কিসে জানাবে বিচার দিন কী?"
    },
    {
      "ayah": 15,
      "start_ms": 38766,
      "end_ms": 41524,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 16,
      "start_ms": 41524,
      "end_ms": 44282,
      "duration_ms": 2758,
      "text": "আমরা কি পূর্ববর্তীদেরকে ধ্বংস করিনি?"
    },
    {
      "ayah": 17,
      "start_ms": 44282,
      "end_ms": 47500,
      "duration_ms": 3218,
      "text": "তারপর আমরা পরবর্তীদেরকে তাদের অনুগামী করব।"
    },
    {
      "ayah": 18,
      "start_ms": 47500,
      "end_ms": 50258,
      "duration_ms": 2758,
      "text": "অপরাধীদের প্রতি আমরা এরূপই করে থাকি।"
    },
    {
      "ayah": 19,
      "start_ms": 50258,
      "end_ms": 53016,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 20,
      "start_ms": 53016,
      "end_ms": 56540,
      "duration_ms": 3524,
      "text": "আমরা কি তোমাদেরকে তুচ্ছ পানি হতে সৃষ্টি করিনি?"
    },
    {
      "ayah": 21,
      "start_ms": 56540,
      "end_ms": 59145,
      "duration_ms": 2605,
      "text": "তারপর আমরা তা রেখেছি নিরাপদ আধারে,"
    },
    {
      "ayah": 22,
      "start_ms": 59145,
      "end_ms": 61060,
      "duration_ms": 1915,
      "text": "এক নির্দিষ্ট কাল পর্যন্ত,"
    },
    {
      "ayah": 23,
      "start_ms": 61060,
      "end_ms": 65427,
      "duration_ms": 4367,
      "text": "অতঃপর আমরা পরিমাপ করেছি, সুতরাং আমরা কত নিপুণ পরিমাপকারী!"
    },
    {
      "ayah": 24,
      "start_ms": 65427,
      "end_ms": 68185,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 25,
      "start_ms": 68185,
      "end_ms": 71326,
      "duration_ms": 3141,
      "text": "আমরা কি যমীনকে সৃষ্টি করিনি ধারণকারীরূপে,"
    },
    {
      "ayah": 26,
      "start_ms": 71326,
      "end_ms": 72781,
      "duration_ms": 1455,
      "text": "জীবিত ও মৃতের জন্য?"
    },
    {
      "ayah": 27,
      "start_ms": 72781,
      "end_ms": 79447,
      "duration_ms": 6666,
      "text": "আর আমরা তাতে স্থাপন করেছি সুদৃঢ় উচ্চ পর্বতমালা এবং তোমাদেরকে পান করিয়েছি সুপেয় পানি।"
    },
    {
      "ayah": 28,
      "start_ms": 79447,
      "end_ms": 82205,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 29,
      "start_ms": 82205,
      "end_ms": 85270,
      "duration_ms": 3065,
      "text": "তোমরা যাতে মিথ্যারোপ করতে, চল তারই দিকে।"
    },
    {
      "ayah": 30,
      "start_ms": 85270,
      "end_ms": 88181,
      "duration_ms": 2911,
      "text": "চল তিন শাখাবিশিষ্ট আগুনের ছায়ার দিকে,"
    },
    {
      "ayah": 31,
      "start_ms": 88181,
      "end_ms": 92165,
      "duration_ms": 3984,
      "text": "যে ছায়া শীতল নয় এবং যা রক্ষা করে না অগ্নিশিখা হতে,"
    },
    {
      "ayah": 32,
      "start_ms": 92165,
      "end_ms": 96839,
      "duration_ms": 4674,
      "text": "নিশ্চয় জাহান্নাম উৎক্ষেপন করবে বৃহৎ স্ফুলিংগ অট্টালিকাতুল্য,"
    },
    {
      "ayah": 33,
      "start_ms": 96839,
      "end_ms": 98907,
      "duration_ms": 2068,
      "text": "তা যেন পীতবর্ণ উটের শ্রেণী,"
    },
    {
      "ayah": 34,
      "start_ms": 98907,
      "end_ms": 101665,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারূপকারীদের জন্য।"
    },
    {
      "ayah": 35,
      "start_ms": 101665,
      "end_ms": 104576,
      "duration_ms": 2911,
      "text": "এটা এমন এক দিন যেদিন না তারা কথা বলবে,"
    },
    {
      "ayah": 36,
      "start_ms": 104576,
      "end_ms": 107947,
      "duration_ms": 3371,
      "text": "আর না তাদেরকে অনুমতি দেয়া হবে ওযর পেশ করার।"
    },
    {
      "ayah": 37,
      "start_ms": 107947,
      "end_ms": 110705,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 38,
      "start_ms": 110705,
      "end_ms": 115762,
      "duration_ms": 5057,
      "text": "এটাই ফয়সালার দিন, আমরা একত্র করেছি তোমাদেরকে এবং পূর্ববর্তীদেরকে।"
    },
    {
      "ayah": 39,
      "start_ms": 115762,
      "end_ms": 120206,
      "duration_ms": 4444,
      "text": "অতঃপর তোমাদের কোনো কৌশল থাকলে তা প্রয়োগ কর আমার বিরুদ্ধে।"
    },
    {
      "ayah": 40,
      "start_ms": 120206,
      "end_ms": 122964,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 41,
      "start_ms": 122964,
      "end_ms": 127255,
      "duration_ms": 4291,
      "text": "নিশ্চয় মুত্তাকীরা থাকবে ছায়ায় ও প্রস্রবণ বহুল স্থানে,"
    },
    {
      "ayah": 42,
      "start_ms": 127255,
      "end_ms": 130550,
      "duration_ms": 3295,
      "text": "আর তাদের বাঞ্ছিত ফলমূলের প্রাচুর্যের মধ্যে।"
    },
    {
      "ayah": 43,
      "start_ms": 130550,
      "end_ms": 135147,
      "duration_ms": 4597,
      "text": "তোমাদের কর্মের পুরস্কারস্বরূপ তোমরা তৃপ্তির সাথে পানাহার কর।"
    },
    {
      "ayah": 44,
      "start_ms": 135147,
      "end_ms": 138288,
      "duration_ms": 3141,
      "text": "এভাবে আমরা মুহসিনদেরকে পুরস্কৃত করে থাকি।"
    },
    {
      "ayah": 45,
      "start_ms": 138288,
      "end_ms": 141046,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 46,
      "start_ms": 141046,
      "end_ms": 145337,
      "duration_ms": 4291,
      "text": "তোমরা খাও এবং ভোগ করে নাও অল্প কিছুদিন, তোমরা তো অপরাধী।"
    },
    {
      "ayah": 47,
      "start_ms": 145337,
      "end_ms": 148095,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 48,
      "start_ms": 148095,
      "end_ms": 151926,
      "duration_ms": 3831,
      "text": "যখন তাদেরকে বলা হয়, রুকু কর তখন তারা রুকু করে না।"
    },
    {
      "ayah": 49,
      "start_ms": 151926,
      "end_ms": 154684,
      "duration_ms": 2758,
      "text": "সেদিন দুর্ভোগ মিথ্যারোপকারীদের জন্য।"
    },
    {
      "ayah": 50,
      "start_ms": 154684,
      "end_ms": 158592,
      "duration_ms": 3908,
      "text": "কাজেই তারা কুরআনের পরিবর্তে আর কোন কথায় ঈমান আনবে!"
    }
  ]
}