{
  "surah": 56,
  "name_translit": "Al-Waaqia",
  "name_bn": "আল-ওয়াকি'আহ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 317598,
  "total_ayat": 96,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1831,
      "duration_ms": 1831,
      "text": "যখন সংঘটিত হবে কিয়ামত,"
    },
    {
      "ayah": 2,
      "start_ms": 1831,
      "end_ms": 5176,
      "duration_ms": 3345,
      "text": "(তখন) এটার সংঘটন মিথ্যা বলার কেউ থাকবে না।"
    },
    {
      "ayah": 3,
      "start_ms": 5176,
      "end_ms": 8441,
      "duration_ms": 3265,
      "text": "এটা কাউকে করবে নীচ, কাউকে করবে সমুন্নত ;।"
    },
    {
      "ayah": 4,
      "start_ms": 8441,
      "end_ms": 11308,
      "duration_ms": 2867,
      "text": "যখন প্রবল কম্পনে প্রকম্পিত হবে যমীন।"
    },
    {
      "ayah": 5,
      "start_ms": 11308,
      "end_ms": 14414,
      "duration_ms": 3106,
      "text": "এবং চূর্ণ বিচূর্ণ হয়ে পড়বে পর্বতমালা,"
    },
    {
      "ayah": 6,
      "start_ms": 14414,
      "end_ms": 17918,
      "duration_ms": 3504,
      "text": "অতঃপর তা পর্যবসিত হবে উৎক্ষিপ্ত ধূলিকণায় ;।"
    },
    {
      "ayah": 7,
      "start_ms": 17918,
      "end_ms": 20626,
      "duration_ms": 2708,
      "text": "আর তোমারা বিভক্ত হয়ে পড়বে তিন দলে।"
    },
    {
      "ayah": 8,
      "start_ms": 20626,
      "end_ms": 24528,
      "duration_ms": 3902,
      "text": "অতঃপর ডান দিকের দল; ডান দিকের দলটি কত সৌভাগ্যবান!"
    },
    {
      "ayah": 9,
      "start_ms": 24528,
      "end_ms": 28191,
      "duration_ms": 3663,
      "text": "এবং বাম দিকের দল; আর বাম দিকের দলটি কত হতভাগা!"
    },
    {
      "ayah": 10,
      "start_ms": 28191,
      "end_ms": 30500,
      "duration_ms": 2309,
      "text": "আর অগ্রবর্তিগণই তো অগ্রবর্তী,"
    },
    {
      "ayah": 11,
      "start_ms": 30500,
      "end_ms": 32093,
      "duration_ms": 1593,
      "text": "তারাই নৈকট্যপ্রাপ্ত।"
    },
    {
      "ayah": 12,
      "start_ms": 32093,
      "end_ms": 33765,
      "duration_ms": 1672,
      "text": "নিয়ামতপূর্ণ উদ্যানে;।"
    },
    {
      "ayah": 13,
      "start_ms": 33765,
      "end_ms": 36951,
      "duration_ms": 3186,
      "text": "বহু সংখ্যক হবে পূর্ববর্তীদের মধ্য থেকে;।"
    },
    {
      "ayah": 14,
      "start_ms": 36951,
      "end_ms": 40216,
      "duration_ms": 3265,
      "text": "এবং অল্প সংখ্যক হবে পরবর্তীদের মধ্য থেকে।"
    },
    {
      "ayah": 15,
      "start_ms": 40216,
      "end_ms": 42525,
      "duration_ms": 2309,
      "text": "স্বর্ণ ও দামী পাথর খচিত আসনে।"
    },
    {
      "ayah": 16,
      "start_ms": 42525,
      "end_ms": 45870,
      "duration_ms": 3345,
      "text": "তারা হেলান দিয়ে বসবে, পরস্পর মুখোমুখি হয়ে।"
    },
    {
      "ayah": 17,
      "start_ms": 45870,
      "end_ms": 49135,
      "duration_ms": 3265,
      "text": "তাদের আশেপাশে ঘুরাফিরা করবে চির কিশোরেরা।"
    },
    {
      "ayah": 18,
      "start_ms": 49135,
      "end_ms": 53356,
      "duration_ms": 4221,
      "text": "পানপাত্র, জগ ও প্রস্রবণ নিঃসৃত সুরাপূর্ণ পেয়ালা নিয়ে।"
    },
    {
      "ayah": 19,
      "start_ms": 53356,
      "end_ms": 58055,
      "duration_ms": 4699,
      "text": "সে সুরা পানে তাদের শিরঃপীড়া হবে না, তারা জ্ঞানহারাও হবে না।"
    },
    {
      "ayah": 20,
      "start_ms": 58055,
      "end_ms": 61639,
      "duration_ms": 3584,
      "text": "আর (ঘোরাফেরা করবে) তাদের পছন্দমত ফলমূল নিয়ে,"
    },
    {
      "ayah": 21,
      "start_ms": 61639,
      "end_ms": 64267,
      "duration_ms": 2628,
      "text": "আর তাদের ঈন্সিত পাখীর গোশত নিয়ে।"
    },
    {
      "ayah": 22,
      "start_ms": 64267,
      "end_ms": 67691,
      "duration_ms": 3424,
      "text": "আর তাদের জন্য থাকবে ডাগর চক্ষুবিশিষ্টা হূর,"
    },
    {
      "ayah": 23,
      "start_ms": 67691,
      "end_ms": 69682,
      "duration_ms": 1991,
      "text": "যেন তারা সুরক্ষিত মুক্তা,"
    },
    {
      "ayah": 24,
      "start_ms": 69682,
      "end_ms": 71832,
      "duration_ms": 2150,
      "text": "তাদের কাজের পুরস্কারস্বরূপ।"
    },
    {
      "ayah": 25,
      "start_ms": 71832,
      "end_ms": 75177,
      "duration_ms": 3345,
      "text": "সেখানে তারা শুনবে না কোন অসার বা পাপবাক্য,"
    },
    {
      "ayah": 26,
      "start_ms": 75177,
      "end_ms": 77168,
      "duration_ms": 1991,
      "text": "সালাম আর সালাম বাণী ছাড়া।"
    },
    {
      "ayah": 27,
      "start_ms": 77168,
      "end_ms": 80513,
      "duration_ms": 3345,
      "text": "আর ডান দিকের দল, কত ভাগ্যবান ডান দিকের দল!"
    },
    {
      "ayah": 28,
      "start_ms": 80513,
      "end_ms": 84415,
      "duration_ms": 3902,
      "text": "তারা থাকবে এমন উদ্যানে, যাতে আছে কাঁটাহীন কুলগাছ।"
    },
    {
      "ayah": 29,
      "start_ms": 84415,
      "end_ms": 86167,
      "duration_ms": 1752,
      "text": "এবং কাঁদি ভরা কলা গাছ।"
    },
    {
      "ayah": 30,
      "start_ms": 86167,
      "end_ms": 87839,
      "duration_ms": 1672,
      "text": "আর সম্প্রসারিত ছায়া,"
    },
    {
      "ayah": 31,
      "start_ms": 87839,
      "end_ms": 89591,
      "duration_ms": 1752,
      "text": "আর সদা প্রবাহমান পানি।"
    },
    {
      "ayah": 32,
      "start_ms": 89591,
      "end_ms": 90785,
      "duration_ms": 1194,
      "text": "ও প্রচুর ফলমূল,"
    },
    {
      "ayah": 33,
      "start_ms": 90785,
      "end_ms": 93493,
      "duration_ms": 2708,
      "text": "যা শেষ হবে না ও যা নিষিদ্ধও হবেনা।"
    },
    {
      "ayah": 34,
      "start_ms": 93493,
      "end_ms": 95245,
      "duration_ms": 1752,
      "text": "আর সমুচ্চ শয্যাসমূহ ;।"
    },
    {
      "ayah": 35,
      "start_ms": 95245,
      "end_ms": 98669,
      "duration_ms": 3424,
      "text": "নিশ্চয় আমরা তাদেরকে সৃষ্টি করেছি বিশেষরূপে।"
    },
    {
      "ayah": 36,
      "start_ms": 98669,
      "end_ms": 100819,
      "duration_ms": 2150,
      "text": "অতঃপর তাদেরকে করেছি কুমারী,"
    },
    {
      "ayah": 37,
      "start_ms": 100819,
      "end_ms": 102491,
      "duration_ms": 1672,
      "text": "সোহাগিনী ও সমবয়স্কা,"
    },
    {
      "ayah": 38,
      "start_ms": 102491,
      "end_ms": 104163,
      "duration_ms": 1672,
      "text": "ডানদিকের লোকদের জন্য।"
    },
    {
      "ayah": 39,
      "start_ms": 104163,
      "end_ms": 107349,
      "duration_ms": 3186,
      "text": "তাদের অনেকে হবে পূর্ববর্তীদের মধ্য থেকে।"
    },
    {
      "ayah": 40,
      "start_ms": 107349,
      "end_ms": 110136,
      "duration_ms": 2787,
      "text": "এবং অনেকে হবে পরবর্তীদের মধ্য থেকে।"
    },
    {
      "ayah": 41,
      "start_ms": 110136,
      "end_ms": 113322,
      "duration_ms": 3186,
      "text": "আর বাম দিকের দল, কত হতভাগ্য বামদিকের দল!"
    },
    {
      "ayah": 42,
      "start_ms": 113322,
      "end_ms": 117065,
      "duration_ms": 3743,
      "text": "তারা থাকবে অত্যন্ত উষ্ণ বায়ু ও উত্তপ্ত পানিতে।"
    },
    {
      "ayah": 43,
      "start_ms": 117065,
      "end_ms": 119215,
      "duration_ms": 2150,
      "text": "আর কালোবর্ণের ধূঁয়ার ছায়ায়,"
    },
    {
      "ayah": 44,
      "start_ms": 119215,
      "end_ms": 121445,
      "duration_ms": 2230,
      "text": "যা শীতল নয়, আরামদায়কও নয়।"
    },
    {
      "ayah": 45,
      "start_ms": 121445,
      "end_ms": 124471,
      "duration_ms": 3026,
      "text": "ইতোপূর্বে তারা তো মগ্ন ছিল ভোগ বিলাসে।"
    },
    {
      "ayah": 46,
      "start_ms": 124471,
      "end_ms": 127577,
      "duration_ms": 3106,
      "text": "আর তারা অবিরাম লিপ্ত ছিল ঘোরতর পাপকাজে।"
    },
    {
      "ayah": 47,
      "start_ms": 127577,
      "end_ms": 132754,
      "duration_ms": 5177,
      "text": "আর তারা বলত, মরে অস্থি ও মাটিতে পরিণত হলেও কি আমাদেরকে উঠানো হবে?"
    },
    {
      "ayah": 48,
      "start_ms": 132754,
      "end_ms": 134665,
      "duration_ms": 1911,
      "text": "এবং আমাদের পিতৃপুরুষরাও?"
    },
    {
      "ayah": 49,
      "start_ms": 134665,
      "end_ms": 137691,
      "duration_ms": 3026,
      "text": "বলুন, অবশ্যই পূর্ববর্তীরা ও পরবর্তীরা।"
    },
    {
      "ayah": 50,
      "start_ms": 137691,
      "end_ms": 142151,
      "duration_ms": 4460,
      "text": "সবাইকে একত্র করা হবে এক নির্ধারিত দিনের নির্দিষ্ট সময়ে।"
    },
    {
      "ayah": 51,
      "start_ms": 142151,
      "end_ms": 144938,
      "duration_ms": 2787,
      "text": "তারপর হে বিভ্রান্ত মিথ্যারোপকারীরা!"
    },
    {
      "ayah": 52,
      "start_ms": 144938,
      "end_ms": 148044,
      "duration_ms": 3106,
      "text": "তারা অবশ্যই আহার করবে যাক্কূম গাছ থেকে,"
    },
    {
      "ayah": 53,
      "start_ms": 148044,
      "end_ms": 151070,
      "duration_ms": 3026,
      "text": "অতঃপর সেটা দ্বারা তারা পেট পূর্ণ করবে,"
    },
    {
      "ayah": 54,
      "start_ms": 151070,
      "end_ms": 154494,
      "duration_ms": 3424,
      "text": "তদুপরি তারা পান করবে তার উপর অতি উষ্ণ পানি।"
    },
    {
      "ayah": 55,
      "start_ms": 154494,
      "end_ms": 157361,
      "duration_ms": 2867,
      "text": "অতঃপর পান করবে তৃষ্ণার্ত উটের ন্যায়।"
    },
    {
      "ayah": 56,
      "start_ms": 157361,
      "end_ms": 160467,
      "duration_ms": 3106,
      "text": "প্রতিদান দিবসে এটাই হবে তাদের আপ্যায়ন।"
    },
    {
      "ayah": 57,
      "start_ms": 160467,
      "end_ms": 165166,
      "duration_ms": 4699,
      "text": "আমরাই তোমাদেরকে সৃষ্টি করেছি, তবে কেন তোমরা বিশ্বাস করছ না?"
    },
    {
      "ayah": 58,
      "start_ms": 165166,
      "end_ms": 168829,
      "duration_ms": 3663,
      "text": "তোমরা কি ভেবে দেখেছ তোমাদের বীর্যপাত সম্বন্ধে?"
    },
    {
      "ayah": 59,
      "start_ms": 168829,
      "end_ms": 172333,
      "duration_ms": 3504,
      "text": "সেটা কি তোমরা সৃষ্টি কর, না আমরা সৃষ্টি করি?"
    },
    {
      "ayah": 60,
      "start_ms": 172333,
      "end_ms": 178386,
      "duration_ms": 6053,
      "text": "আমরা তোমাদের মধ্যে মৃত্যু নির্ধারিত করেছি এবং আমাদেরকে অক্ষম করা যাবে না...।"
    },
    {
      "ayah": 61,
      "start_ms": 178386,
      "end_ms": 185952,
      "duration_ms": 7566,
      "text": "তোমাদের স্থলে তোমাদের সদৃশ আনয়ন করতে এবং তোমাদেরকে এমন এক আকৃতিতে সৃষ্টি করতে যা তোমরা জান না।"
    },
    {
      "ayah": 62,
      "start_ms": 185952,
      "end_ms": 192563,
      "duration_ms": 6611,
      "text": "আর অবশ্যই তোমরা অবগত হয়েছ প্রথম সৃষ্টি সম্পর্কে, তবে তোমরা উপদেশ গ্রহণ করা না কেন?"
    },
    {
      "ayah": 63,
      "start_ms": 192563,
      "end_ms": 196306,
      "duration_ms": 3743,
      "text": "তোমরা যে বীজ বপন কর সে সম্পর্কে চিন্তা করেছ কি?"
    },
    {
      "ayah": 64,
      "start_ms": 196306,
      "end_ms": 200129,
      "duration_ms": 3823,
      "text": "তোমরা কি সেটাকে অংকুরিত কর, না আমরা অংকুরিত করি?"
    },
    {
      "ayah": 65,
      "start_ms": 200129,
      "end_ms": 206262,
      "duration_ms": 6133,
      "text": "আমরা ইচ্ছে করলে এটাকে খড় কুটোয় পরিণত করতে পারি, তখন হতবুদ্ধি হয়ে পড়বে তোমরা;।"
    },
    {
      "ayah": 66,
      "start_ms": 206262,
      "end_ms": 209686,
      "duration_ms": 3424,
      "text": "(এই বলে) নিশ্চয় আমরা দায়গ্রস্ত হয়ে পড়েছি,"
    },
    {
      "ayah": 67,
      "start_ms": 209686,
      "end_ms": 212314,
      "duration_ms": 2628,
      "text": "বরং আমরা হৃত সর্বস্ব হয়ে পড়েছি।"
    },
    {
      "ayah": 68,
      "start_ms": 212314,
      "end_ms": 215898,
      "duration_ms": 3584,
      "text": "তোমরা যে পানি পান কর তা সম্পর্কে আমাকে জানাও।"
    },
    {
      "ayah": 69,
      "start_ms": 215898,
      "end_ms": 220358,
      "duration_ms": 4460,
      "text": "তোমরা কি সেটা মেঘ হতে নামিয়ে আন, না আমরা সেটা বর্ষণ করি?"
    },
    {
      "ayah": 70,
      "start_ms": 220358,
      "end_ms": 226650,
      "duration_ms": 6292,
      "text": "আমরা ইচ্ছে করলে তা লবণাক্ত করে দিতে পারি। তবুও কেন তোমরা কৃতজ্ঞতা প্রকাশ কর না?"
    },
    {
      "ayah": 71,
      "start_ms": 226650,
      "end_ms": 230552,
      "duration_ms": 3902,
      "text": "তোমরা যে আগুন প্রজ্বলিত করা সে ব্যাপারে আমাকে বল।"
    },
    {
      "ayah": 72,
      "start_ms": 230552,
      "end_ms": 234295,
      "duration_ms": 3743,
      "text": "তোমরাই কি এর গাছ সৃষ্টি কর, না আমরা সৃষ্টি করি?"
    },
    {
      "ayah": 73,
      "start_ms": 234295,
      "end_ms": 238835,
      "duration_ms": 4540,
      "text": "আমরা এটাকে করেছি স্মারক এবং মরুচারীদের প্রয়োজনীয় বস্তু।"
    },
    {
      "ayah": 74,
      "start_ms": 238835,
      "end_ms": 243693,
      "duration_ms": 4858,
      "text": "কাজেই আপনি আপনার মহান রবের নামের পবিত্রতা ও মহিমা ঘোষণা করুন।"
    },
    {
      "ayah": 75,
      "start_ms": 243693,
      "end_ms": 247038,
      "duration_ms": 3345,
      "text": "অতঃপর আমি শপথ করছি নক্ষত্ররাজির অস্তাচলের,"
    },
    {
      "ayah": 76,
      "start_ms": 247038,
      "end_ms": 250383,
      "duration_ms": 3345,
      "text": "আর নিশ্চয় এটা এক মহাশপথ, যদি তোমরা জানতে।"
    },
    {
      "ayah": 77,
      "start_ms": 250383,
      "end_ms": 252692,
      "duration_ms": 2309,
      "text": "নিশ্চয় এটা মহিমান্বিত কুরআন,"
    },
    {
      "ayah": 78,
      "start_ms": 252692,
      "end_ms": 254523,
      "duration_ms": 1831,
      "text": "যা আছে সুরক্ষিত কিতাবে।"
    },
    {
      "ayah": 79,
      "start_ms": 254523,
      "end_ms": 259222,
      "duration_ms": 4699,
      "text": "যারা সম্পূর্ণ পবিত্র তারা ছাড়া অন্য কেউ তা সম্পর্শ করে না।"
    },
    {
      "ayah": 80,
      "start_ms": 259222,
      "end_ms": 262328,
      "duration_ms": 3106,
      "text": "এটা সৃষ্টিকুলের রবের কাছ থেকে নাযিলকৃত।"
    },
    {
      "ayah": 81,
      "start_ms": 262328,
      "end_ms": 265354,
      "duration_ms": 3026,
      "text": "তবুও কি তোমরা এ বাণীকে তুচ্ছ গণ্য করছ?"
    },
    {
      "ayah": 82,
      "start_ms": 265354,
      "end_ms": 269097,
      "duration_ms": 3743,
      "text": "আর তোমরা মিথ্যারোপকেই তোমাদের রিযিক করে নিয়োছ!"
    },
    {
      "ayah": 83,
      "start_ms": 269097,
      "end_ms": 272044,
      "duration_ms": 2947,
      "text": "সুতরাং কেন নয় প্রাণ যখন কণ্ঠাগত হয়।"
    },
    {
      "ayah": 84,
      "start_ms": 272044,
      "end_ms": 274114,
      "duration_ms": 2070,
      "text": "এবং তখন তোমরা তাকিয়ে থাক।"
    },
    {
      "ayah": 85,
      "start_ms": 274114,
      "end_ms": 279052,
      "duration_ms": 4938,
      "text": "আর আমরা তোমাদের চেয়ে তার কাছাকাছি, কিন্তু তোমরা দেখতে পাও না।"
    },
    {
      "ayah": 86,
      "start_ms": 279052,
      "end_ms": 283432,
      "duration_ms": 4380,
      "text": "অতঃপর যদি তোমরা হিসাব নিকাশ ও প্রতিফলের সম্মুখীন না হও,"
    },
    {
      "ayah": 87,
      "start_ms": 283432,
      "end_ms": 287414,
      "duration_ms": 3982,
      "text": "তবে তোমরা ওটা ফিরাও না কেন? যদি তোমরা সত্যবাদী হও!"
    },
    {
      "ayah": 88,
      "start_ms": 287414,
      "end_ms": 290520,
      "duration_ms": 3106,
      "text": "অতঃপর যদি সে নৈকট্যপ্রাপ্তদের একজন হয়,"
    },
    {
      "ayah": 89,
      "start_ms": 290520,
      "end_ms": 294980,
      "duration_ms": 4460,
      "text": "তবে তার জন্য রয়েছে আরাম, উত্তম জীবনোপকরণ ও সুখদ উদ্যান,"
    },
    {
      "ayah": 90,
      "start_ms": 294980,
      "end_ms": 297289,
      "duration_ms": 2309,
      "text": "আর যদি সে ডান দিকের একজন হয়,"
    },
    {
      "ayah": 91,
      "start_ms": 297289,
      "end_ms": 302068,
      "duration_ms": 4779,
      "text": "তবে তাকে বলা হবে, তোমাকে সালাম যেহেতু তুমি ডান দিকের একজন ৷।"
    },
    {
      "ayah": 92,
      "start_ms": 302068,
      "end_ms": 306130,
      "duration_ms": 4062,
      "text": "কিন্তু সে যদি হয় মিথ্যারোপকারী, বিভ্রান্তদের একজন,"
    },
    {
      "ayah": 93,
      "start_ms": 306130,
      "end_ms": 308997,
      "duration_ms": 2867,
      "text": "তবে তার আপ্যায়ন হবে অতি উষ্ণ পানির।"
    },
    {
      "ayah": 94,
      "start_ms": 308997,
      "end_ms": 310669,
      "duration_ms": 1672,
      "text": "এবং দহন জাহান্নামের;।"
    },
    {
      "ayah": 95,
      "start_ms": 310669,
      "end_ms": 312819,
      "duration_ms": 2150,
      "text": "নিশ্চয় এটা সুনিশ্চিত সত্য।"
    },
    {
      "ayah": 96,
      "start_ms": 312819,
      "end_ms": 317598,
      "duration_ms": 4779,
      "text": "অতএব আপনি আপনার মহান রবের নামের পবিত্রতা ও মহিমা ঘোষণা করুন।"
    }
  ]
}