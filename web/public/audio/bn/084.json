{
  "surah": 84,
  "name_translit": "Al-Inshiqaaq",
  "name_bn": "আল-ইনশিকাক",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 90948,
  "total_ayat": 25,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1693,
      "duration_ms": 1693,
      "text": "যখন আকাশ বিদীর্ণ হবে,"
    },
    {
      "ayah": 2,
      "start_ms": 1693,
      "end_ms": 5483,
      "duration_ms": 3790,
      "text": "আর তার রবের আদেশ পালন করবে এবং এটাই তার করণীয়।"
    },
    {
      "ayah": 3,
      "start_ms": 5483,
      "end_ms": 8224,
      "duration_ms": 2741,
      "text": "আর যখন যমীনকে সম্প্রসারিত করা হবে।"
    },
    {
      "ayah": 4,
      "start_ms": 8224,
      "end_ms": 13626,
      "duration_ms": 5402,
      "text": "আর যমীন তার অভ্যন্তরে যা আছে তা বাইরে নিক্ষেপ করবে ও শূন্যগর্ভ হবে।"
    },
    {
      "ayah": 5,
      "start_ms": 13626,
      "end_ms": 17174,
      "duration_ms": 3548,
      "text": "এবং তার রবের আদেশ পালন করবে এটাই তার করণীয়।"
    },
    {
      "ayah": 6,
      "start_ms": 17174,
      "end_ms": 25238,
      "duration_ms": 8064,
      "text": "হে মানুষ! তুমি তোমার রবের কাছে পৌছা পর্যন্ত কঠোর পরিশ্রম করতে হবে, অতঃপর তুমি তাঁর সাক্ষাত লাভ করবে।"
    },
    {
      "ayah": 7,
      "start_ms": 25238,
      "end_ms": 28947,
      "duration_ms": 3709,
      "text": "অতঃপর যাকে তার আমলনামা তার ডান হাতে দেয়া হবে।"
    },
    {
      "ayah": 8,
      "start_ms": 28947,
      "end_ms": 31446,
      "duration_ms": 2499,
      "text": "তার হিসেব নিকেশ সহজেই নেয়া হবে।"
    },
    {
      "ayah": 9,
      "start_ms": 31446,
      "end_ms": 35558,
      "duration_ms": 4112,
      "text": "এবং সে তার স্বজনদের কাছে প্রফুল্লচিত্তে ফিরে যাবে;।"
    },
    {
      "ayah": 10,
      "start_ms": 35558,
      "end_ms": 39831,
      "duration_ms": 4273,
      "text": "আর যাকে তার আমলনামা তার পিঠের পিছনদিক থেকে দেয়া হবে।"
    },
    {
      "ayah": 11,
      "start_ms": 39831,
      "end_ms": 41927,
      "duration_ms": 2096,
      "text": "সে অবশ্যই তার ধ্বংস ডাকবে।"
    },
    {
      "ayah": 12,
      "start_ms": 41927,
      "end_ms": 44184,
      "duration_ms": 2257,
      "text": "এবং জ্বলন্ত আগুনে দগ্ধ হবে;।"
    },
    {
      "ayah": 13,
      "start_ms": 44184,
      "end_ms": 47490,
      "duration_ms": 3306,
      "text": "নিশ্চয় সে তার স্বজনদের মধ্যে আনন্দে ছিল,"
    },
    {
      "ayah": 14,
      "start_ms": 47490,
      "end_ms": 50715,
      "duration_ms": 3225,
      "text": "সে তো ভাবতে যে, সে কখনেই ফিরে যাবে না ;।"
    },
    {
      "ayah": 15,
      "start_ms": 50715,
      "end_ms": 54827,
      "duration_ms": 4112,
      "text": "হ্যাঁ, নিশ্চয় তার রব তার উপর সম্যক দৃষ্টি দানকারী।"
    },
    {
      "ayah": 16,
      "start_ms": 54827,
      "end_ms": 57488,
      "duration_ms": 2661,
      "text": "অতঃপর আমি শপথ করছি পশ্চিম আকাশের।"
    },
    {
      "ayah": 17,
      "start_ms": 57488,
      "end_ms": 61116,
      "duration_ms": 3628,
      "text": "আর শপথ রাতের এবং তা যা কিছুর সমাবেশ ঘটায় তার।"
    },
    {
      "ayah": 18,
      "start_ms": 61116,
      "end_ms": 63857,
      "duration_ms": 2741,
      "text": "এবং শপথ চাঁদের, যখন তা পূর্ণ হয়;।"
    },
    {
      "ayah": 19,
      "start_ms": 63857,
      "end_ms": 67727,
      "duration_ms": 3870,
      "text": "অবশ্যই তোমরা এক স্তর থেকে অন্য স্তরে আরোহণ করবে।"
    },
    {
      "ayah": 20,
      "start_ms": 67727,
      "end_ms": 70871,
      "duration_ms": 3144,
      "text": "অতঃপর তাদের কি হল যে, তারা ঈমান আনে না?"
    },
    {
      "ayah": 21,
      "start_ms": 70871,
      "end_ms": 75548,
      "duration_ms": 4677,
      "text": "আর যখন তাদের কাছে কুরআন পাঠ করা হয় তখন তারা সাজ্দা করে না?"
    },
    {
      "ayah": 22,
      "start_ms": 75548,
      "end_ms": 77644,
      "duration_ms": 2096,
      "text": "বরং কাফিররা মিথ্যারোপ করে।"
    },
    {
      "ayah": 23,
      "start_ms": 77644,
      "end_ms": 81030,
      "duration_ms": 3386,
      "text": "আর তারা যা পোষণ করে আল্লাহ তা সবিশেষ অবগত।"
    },
    {
      "ayah": 24,
      "start_ms": 81030,
      "end_ms": 85223,
      "duration_ms": 4193,
      "text": "কাজেই আপনি তাদেরকে যন্ত্রণাদায়ক শাস্তির সংবাদ দিন;।"
    },
    {
      "ayah": 25,
      "start_ms": 85223,
      "end_ms": 90948,
      "duration_ms": 5725,
      "text": "কিন্তু যারা ঈমান আনে ও সৎকাজ করে তাদের জন্য রয়েছে নিরবচ্ছিন্ন পুরস্কার।"
    }
  ]
}