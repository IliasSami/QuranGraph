{
  "surah": 82,
  "name_translit": "Al-Infitaar",
  "name_bn": "আল-ইনফিতার",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 65751,
  "total_ayat": 19,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 1720,
      "duration_ms": 1720,
      "text": "যখন আসমান বিদীর্ণ হবে,"
    },
    {
      "ayah": 2,
      "start_ms": 1720,
      "end_ms": 5160,
      "duration_ms": 3440,
      "text": "আর যখন নক্ষত্রমণ্ডলী বিক্ষিপ্তভাবে ঝরে পরবে,"
    },
    {
      "ayah": 3,
      "start_ms": 5160,
      "end_ms": 7818,
      "duration_ms": 2658,
      "text": "আর যখন সাগরগুলো বিস্ফোরিত করা হবে,"
    },
    {
      "ayah": 4,
      "start_ms": 7818,
      "end_ms": 10007,
      "duration_ms": 2189,
      "text": "আর যখন কবরসমূহ উন্মোচিত হবে,"
    },
    {
      "ayah": 5,
      "start_ms": 10007,
      "end_ms": 15089,
      "duration_ms": 5082,
      "text": "তখন প্রত্যেকে জানবে, সে কী আগে পাঠিয়েছে ও কী পিছনে রেখে গিয়েছে।"
    },
    {
      "ayah": 6,
      "start_ms": 15089,
      "end_ms": 19702,
      "duration_ms": 4613,
      "text": "হে মানুষ! কিসে তোমাকে তোমার মহান রব সম্পর্কে বিভ্রান্ত করল?"
    },
    {
      "ayah": 7,
      "start_ms": 19702,
      "end_ms": 25644,
      "duration_ms": 5942,
      "text": "যিনি তোমাকে সৃষ্টি করেছেন, অতঃপর তোমাকে সুঠাম করেছেন এবং সুসামঞ্জস্য করেছেন,"
    },
    {
      "ayah": 8,
      "start_ms": 25644,
      "end_ms": 29084,
      "duration_ms": 3440,
      "text": "যে আকৃতিতে চেয়েছেন, তিনি তোমাকে গঠন করেছেন।"
    },
    {
      "ayah": 9,
      "start_ms": 29084,
      "end_ms": 33228,
      "duration_ms": 4144,
      "text": "কখনো নয়, তোমরা তো প্রতিদান দিবসে মিথ্যারোপ করে থাক ;।"
    },
    {
      "ayah": 10,
      "start_ms": 33228,
      "end_ms": 36824,
      "duration_ms": 3596,
      "text": "আর নিশ্চয় নিয়োজিত আছেন তোমাদের উপর সংরক্ষকদল;।"
    },
    {
      "ayah": 11,
      "start_ms": 36824,
      "end_ms": 38387,
      "duration_ms": 1563,
      "text": "সম্মানিত লেখকবৃন্দ;।"
    },
    {
      "ayah": 12,
      "start_ms": 38387,
      "end_ms": 40107,
      "duration_ms": 1720,
      "text": "তারা জানে তোমরা যা কর।"
    },
    {
      "ayah": 13,
      "start_ms": 40107,
      "end_ms": 43312,
      "duration_ms": 3205,
      "text": "পুণ্যবানেরা তো থাকবে পরম স্বাচ্ছন্দ্যো ;।"
    },
    {
      "ayah": 14,
      "start_ms": 43312,
      "end_ms": 46127,
      "duration_ms": 2815,
      "text": "আর পাপাচারীরা তো থাকবে জাহান্নামে ;।"
    },
    {
      "ayah": 15,
      "start_ms": 46127,
      "end_ms": 48863,
      "duration_ms": 2736,
      "text": "তারা প্রতিদান দিবসে তাতে দগ্ধ হবে;।"
    },
    {
      "ayah": 16,
      "start_ms": 48863,
      "end_ms": 52147,
      "duration_ms": 3284,
      "text": "আর তারা সেখান থেকে অন্তর্হিত হতে পারবে না।"
    },
    {
      "ayah": 17,
      "start_ms": 52147,
      "end_ms": 55352,
      "duration_ms": 3205,
      "text": "আর কিসে আপনাকে জানাবে : প্রতিদান দিবস কী?"
    },
    {
      "ayah": 18,
      "start_ms": 55352,
      "end_ms": 59105,
      "duration_ms": 3753,
      "text": "তারপর বলি, কিসে আপনাকে জানাবে: প্রতিদান দিবস কী?"
    },
    {
      "ayah": 19,
      "start_ms": 59105,
      "end_ms": 65751,
      "duration_ms": 6646,
      "text": "সেদিন কেউ কারও জন্য কিছু করার মালিক হবে না; আর সেদিন সব বিষয়ের কর্তৃত্ব হবে আল্লাহর।"
    }
  ]
}