{
  "surah": 86,
  "name_translit": "At-Taariq",
  "name_bn": "আত-তারিক",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 53776,
  "total_ayat": 17,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 3475,
      "duration_ms": 3475,
      "text": "শপথ আসমানের এবং রাতে যা আবির্ভূত হয় তার;।"
    },
    {
      "ayah": 2,
      "start_ms": 3475,
      "end_ms": 7529,
      "duration_ms": 4054,
      "text": "আর কিসে আপনাকে জানাবে রাতে যা আবির্ভূত হয় তা কী?"
    },
    {
      "ayah": 3,
      "start_ms": 7529,
      "end_ms": 8852,
      "duration_ms": 1323,
      "text": "উজ্জ্বল নক্ষত্র।"
    },
    {
      "ayah": 4,
      "start_ms": 8852,
      "end_ms": 12244,
      "duration_ms": 3392,
      "text": "প্রত্যেক জীবের উপরই তত্ত্বাবধায়ক রয়েছে।"
    },
    {
      "ayah": 5,
      "start_ms": 12244,
      "end_ms": 17457,
      "duration_ms": 5213,
      "text": "অতএব, মানুষ যেন চিন্তা করে দেখে তাকে কী থেকে সৃষ্টি করা হয়েছে!"
    },
    {
      "ayah": 6,
      "start_ms": 17457,
      "end_ms": 21180,
      "duration_ms": 3723,
      "text": "তাকে সৃষ্টি করা হয়েছে সবেগে স্থলিত পানি হতে,"
    },
    {
      "ayah": 7,
      "start_ms": 21180,
      "end_ms": 25151,
      "duration_ms": 3971,
      "text": "এটা নির্গত হয় মেরুদণ্ড ও পঞ্জরাস্থির মধ্য থেকে।"
    },
    {
      "ayah": 8,
      "start_ms": 25151,
      "end_ms": 28212,
      "duration_ms": 3061,
      "text": "নিশ্চয় তিনি তাকে ফিরিয়ে আনতে সক্ষম।"
    },
    {
      "ayah": 9,
      "start_ms": 28212,
      "end_ms": 30694,
      "duration_ms": 2482,
      "text": "যেদিন গোপন বিষয় পরীক্ষিত হবে।"
    },
    {
      "ayah": 10,
      "start_ms": 30694,
      "end_ms": 35162,
      "duration_ms": 4468,
      "text": "সেদিন তার কোনো সামর্থ্য থাকবে না এবং সাহায্যকারীও নয়।"
    },
    {
      "ayah": 11,
      "start_ms": 35162,
      "end_ms": 37809,
      "duration_ms": 2647,
      "text": "শপথ আসমানের, যা ধারণ করে বৃষ্টি।"
    },
    {
      "ayah": 12,
      "start_ms": 37809,
      "end_ms": 40374,
      "duration_ms": 2565,
      "text": "এবং শপথ যমীনের, যা বিদীর্ণ হয়,"
    },
    {
      "ayah": 13,
      "start_ms": 40374,
      "end_ms": 43104,
      "duration_ms": 2730,
      "text": "নিশ্চয় আল কুরআন মীমাংসাকারী বাণী।"
    },
    {
      "ayah": 14,
      "start_ms": 43104,
      "end_ms": 44758,
      "duration_ms": 1654,
      "text": "এবং এটা নিরর্থক নয়।"
    },
    {
      "ayah": 15,
      "start_ms": 44758,
      "end_ms": 46743,
      "duration_ms": 1985,
      "text": "তারা ভীষণ ষড়যন্ত্র করে।"
    },
    {
      "ayah": 16,
      "start_ms": 46743,
      "end_ms": 48646,
      "duration_ms": 1903,
      "text": "এবং আমিও ভীষণ কৌশল করি।"
    },
    {
      "ayah": 17,
      "start_ms": 48646,
      "end_ms": 53776,
      "duration_ms": 5130,
      "text": "অতএব, কাফিরদেরকে অবকাশ দিন; তাদেরকে অবকাশ দিন কিছু কালের জন্য।"
    }
  ]
}