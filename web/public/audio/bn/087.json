{
  "surah": 87,
  "name_translit": "Al-A'laa",
  "name_bn": "আল-আ'লা",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 59688,
  "total_ayat": 19,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 4513,
      "duration_ms": 4513,
      "text": "আপনি আপনার সুমহান রবের নামের পবিত্রতা ও মহিমা ঘোষণা করুন,"
    },
    {
      "ayah": 2,
      "start_ms": 4513,
      "end_ms": 7205,
      "duration_ms": 2692,
      "text": "যিনি সৃষ্টি করেন অতঃপর সুঠাম করেন।"
    },
    {
      "ayah": 3,
      "start_ms": 7205,
      "end_ms": 10609,
      "duration_ms": 3404,
      "text": "আর যিনি নির্ধারণ করেন অতঃপর পথনির্দেশ করেন,"
    },
    {
      "ayah": 4,
      "start_ms": 10609,
      "end_ms": 12746,
      "duration_ms": 2137,
      "text": "আর যিনি তৃণাদি উৎপন্ন করেন,"
    },
    {
      "ayah": 5,
      "start_ms": 12746,
      "end_ms": 15358,
      "duration_ms": 2612,
      "text": "পরে তা ধূসর আবর্জনায় পরিণত করেন।"
    },
    {
      "ayah": 6,
      "start_ms": 15358,
      "end_ms": 19158,
      "duration_ms": 3800,
      "text": "শীঘ্রই আমরা আপনাকে পাঠ করাব, ফলে আপনি ভুলবেন না,"
    },
    {
      "ayah": 7,
      "start_ms": 19158,
      "end_ms": 25096,
      "duration_ms": 5938,
      "text": "আল্লাহ যা ইচ্ছে করেন তা ছাড়া। নিশ্চয় তিনি জানেন যা প্রকাশ্য ও যা গোপনীয়।"
    },
    {
      "ayah": 8,
      "start_ms": 25096,
      "end_ms": 28183,
      "duration_ms": 3087,
      "text": "আর আমরা আপনার জন্য সুগম করে দেব সহজ পথ।"
    },
    {
      "ayah": 9,
      "start_ms": 28183,
      "end_ms": 31666,
      "duration_ms": 3483,
      "text": "অতঃপর উপদেশ যদি ফলপ্রসূ হয় তবে উপদেশ দিন ;।"
    },
    {
      "ayah": 10,
      "start_ms": 31666,
      "end_ms": 34199,
      "duration_ms": 2533,
      "text": "যে ভয় করে সেই উপদেশ গ্রহণ করবে।"
    },
    {
      "ayah": 11,
      "start_ms": 34199,
      "end_ms": 37207,
      "duration_ms": 3008,
      "text": "আর তা উপেক্ষা করবে যে নিতান্ত হতভাগ্য,"
    },
    {
      "ayah": 12,
      "start_ms": 37207,
      "end_ms": 39186,
      "duration_ms": 1979,
      "text": "যে ভয়াবহ আগুনে দগ্ধ হবে,"
    },
    {
      "ayah": 13,
      "start_ms": 39186,
      "end_ms": 42036,
      "duration_ms": 2850,
      "text": "তারপর সেখানে সে মরবেও না বাঁচবেও না।"
    },
    {
      "ayah": 14,
      "start_ms": 42036,
      "end_ms": 45123,
      "duration_ms": 3087,
      "text": "অবশ্যই সাফল্য লাভ করবে যে পরিশুদ্ধ হয়।"
    },
    {
      "ayah": 15,
      "start_ms": 45123,
      "end_ms": 48685,
      "duration_ms": 3562,
      "text": "এবং তার রবের নাম স্মরণ করে ও সালাত কায়েম করে।"
    },
    {
      "ayah": 16,
      "start_ms": 48685,
      "end_ms": 52089,
      "duration_ms": 3404,
      "text": "কিন্তু তোমরা দুনিয়ার জীবনকে প্রাধান্য দাও,"
    },
    {
      "ayah": 17,
      "start_ms": 52089,
      "end_ms": 54464,
      "duration_ms": 2375,
      "text": "অথচ আখিরাতই উৎকৃষ্ট ও স্থায়ী।"
    },
    {
      "ayah": 18,
      "start_ms": 54464,
      "end_ms": 57472,
      "duration_ms": 3008,
      "text": "নিশ্চয় এটা আছে পূর্ববর্তী সহীফাসমূহে।"
    },
    {
      "ayah": 19,
      "start_ms": 57472,
      "end_ms": 59688,
      "duration_ms": 2216,
      "text": "ইব্রাহীম ও মূসার সহীফাসমূহে।"
    }
  ]
}