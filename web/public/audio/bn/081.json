{
  "surah": 81,
  "name_translit": "At-Takwir",
  "name_bn": "আত-তাকবীর",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 79395,
  "total_ayat": 29,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2116,
      "duration_ms": 2116,
      "text": "সূর্যকে যখন নিষ্প্রভ করা হবে,"
    },
    {
      "ayah": 2,
      "start_ms": 2116,
      "end_ms": 4232,
      "duration_ms": 2116,
      "text": "আর যখন নক্ষত্ররাজি খসে পড়বে,"
    },
    {
      "ayah": 3,
      "start_ms": 4232,
      "end_ms": 6640,
      "duration_ms": 2408,
      "text": "আর পর্বতসমূহকে যখন চলমান করা হবে,"
    },
    {
      "ayah": 4,
      "start_ms": 6640,
      "end_ms": 9486,
      "duration_ms": 2846,
      "text": "আর যখন পূর্ণগর্ভা মাদী উট উপেক্ষিত হবে,"
    },
    {
      "ayah": 5,
      "start_ms": 9486,
      "end_ms": 11967,
      "duration_ms": 2481,
      "text": "আর যখন বন্য পশুগুলো একত্র করা হবে,"
    },
    {
      "ayah": 6,
      "start_ms": 11967,
      "end_ms": 14521,
      "duration_ms": 2554,
      "text": "আর যখন সাগরকে অগ্নি উত্তাল করা হবে,"
    },
    {
      "ayah": 7,
      "start_ms": 14521,
      "end_ms": 18608,
      "duration_ms": 4087,
      "text": "আর যখন আত্মাগুলোকে সমগোত্রীয়দের সাথে মিলিয়ে দেয়া হবে,"
    },
    {
      "ayah": 8,
      "start_ms": 18608,
      "end_ms": 22038,
      "duration_ms": 3430,
      "text": "আর যখন জীবন্ত সমাধিস্থ কন্যাকে জিজ্ঞেস করা হবে,"
    },
    {
      "ayah": 9,
      "start_ms": 22038,
      "end_ms": 24446,
      "duration_ms": 2408,
      "text": "কী অপরাধে তাকে হত্যা করা হয়েছিল?"
    },
    {
      "ayah": 10,
      "start_ms": 24446,
      "end_ms": 27073,
      "duration_ms": 2627,
      "text": "আর যখন আমলনামাগুলো উন্মোচিত করা হবে,"
    },
    {
      "ayah": 11,
      "start_ms": 27073,
      "end_ms": 29700,
      "duration_ms": 2627,
      "text": "আর যখন আসমানের আবরণ অপসারিত করা হবে,"
    },
    {
      "ayah": 12,
      "start_ms": 29700,
      "end_ms": 33203,
      "duration_ms": 3503,
      "text": "আর যখন জাহান্নামকে ভীষণভাবে প্রজ্জ্বলিত করা হবে,"
    },
    {
      "ayah": 13,
      "start_ms": 33203,
      "end_ms": 35611,
      "duration_ms": 2408,
      "text": "আর যখন জান্নাত নিকটবর্তী করা হবে,"
    },
    {
      "ayah": 14,
      "start_ms": 35611,
      "end_ms": 39114,
      "duration_ms": 3503,
      "text": "তখন প্রত্যেক ব্যক্তিই জানবে সে কি উপস্থিত করেছে।"
    },
    {
      "ayah": 15,
      "start_ms": 39114,
      "end_ms": 42398,
      "duration_ms": 3284,
      "text": "সুতরাং আমি শপথ করছি পশ্চাদপসরণকারী নক্ষত্রের,"
    },
    {
      "ayah": 16,
      "start_ms": 42398,
      "end_ms": 43857,
      "duration_ms": 1459,
      "text": "যা চলমান, অপসৃয়মাণ,"
    },
    {
      "ayah": 17,
      "start_ms": 43857,
      "end_ms": 45681,
      "duration_ms": 1824,
      "text": "শপথ রাতের যখন তা শেষ হয়।"
    },
    {
      "ayah": 18,
      "start_ms": 45681,
      "end_ms": 48162,
      "duration_ms": 2481,
      "text": "শপথ প্রভাতের যখন তার আবির্ভাব হয়,"
    },
    {
      "ayah": 19,
      "start_ms": 48162,
      "end_ms": 51373,
      "duration_ms": 3211,
      "text": "নিশ্চয়ই এ কুরআন সম্মানিত রাসূলের আনীত বাণী।"
    },
    {
      "ayah": 20,
      "start_ms": 51373,
      "end_ms": 55168,
      "duration_ms": 3795,
      "text": "যে সামর্থ্যশালী, আরশের মালিকের কাছে মর্যাদা সম্পন্ন,"
    },
    {
      "ayah": 21,
      "start_ms": 55168,
      "end_ms": 57284,
      "duration_ms": 2116,
      "text": "সে মান্য সেখানে, বিশ্বাসভাজন।"
    },
    {
      "ayah": 22,
      "start_ms": 57284,
      "end_ms": 59181,
      "duration_ms": 1897,
      "text": "আর তোমাদের সাথী উন্মাদ নন,"
    },
    {
      "ayah": 23,
      "start_ms": 59181,
      "end_ms": 61808,
      "duration_ms": 2627,
      "text": "তিনি তো তাকে স্পষ্ট দিগন্তে দেখেছেন,"
    },
    {
      "ayah": 24,
      "start_ms": 61808,
      "end_ms": 64289,
      "duration_ms": 2481,
      "text": "তিনি গায়েবী বিষয় সম্পর্কে কৃপণ নয়।"
    },
    {
      "ayah": 25,
      "start_ms": 64289,
      "end_ms": 66989,
      "duration_ms": 2700,
      "text": "আর এটা কোনো অভিশপ্ত শয়তানের বাক্য নয়।"
    },
    {
      "ayah": 26,
      "start_ms": 66989,
      "end_ms": 68813,
      "duration_ms": 1824,
      "text": "কাজেই তোমরা কোথায় যাচ্ছ?!"
    },
    {
      "ayah": 27,
      "start_ms": 68813,
      "end_ms": 71221,
      "duration_ms": 2408,
      "text": "এ তো শুধু সৃষ্টিকুলের জন্য উপদেশ,"
    },
    {
      "ayah": 28,
      "start_ms": 71221,
      "end_ms": 74432,
      "duration_ms": 3211,
      "text": "তোমাদের মধ্যে যে সরল পথে চলতে চায়, তার জন্য।"
    },
    {
      "ayah": 29,
      "start_ms": 74432,
      "end_ms": 79395,
      "duration_ms": 4963,
      "text": "আর তোমরা ইচ্ছে করতে পার না, যদি না সৃষ্টিকুলের রব আল্লাহ ইচ্ছে করেন।"
    }
  ]
}