{
  "surah": 89,
  "name_translit": "Al-Fajr",
  "name_bn": "আল-ফজর",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 107987,
  "total_ayat": 30,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 792,
      "duration_ms": 792,
      "text": "শপথ ফজরের,"
    },
    {
      "ayah": 2,
      "start_ms": 792,
      "end_ms": 1822,
      "duration_ms": 1030,
      "text": "শপথ দশ রাতের,"
    },
    {
      "ayah": 3,
      "start_ms": 1822,
      "end_ms": 3406,
      "duration_ms": 1584,
      "text": "শপথ জোড় ও বেজোড়ের।"
    },
    {
      "ayah": 4,
      "start_ms": 3406,
      "end_ms": 6020,
      "duration_ms": 2614,
      "text": "শপথ রাতের যখন তা গত হয়ে থাকে –—।"
    },
    {
      "ayah": 5,
      "start_ms": 6020,
      "end_ms": 10298,
      "duration_ms": 4278,
      "text": "নিশ্চয়ই এর মধ্যে শপথ রয়েছে বোধসম্পন্ন ব্যক্তির জন্য।"
    },
    {
      "ayah": 6,
      "start_ms": 10298,
      "end_ms": 14497,
      "duration_ms": 4199,
      "text": "আপনি দেখেননি আপনার রব কি (আচরণ) করেছিলেন আদ বংশের---।"
    },
    {
      "ayah": 7,
      "start_ms": 14497,
      "end_ms": 19251,
      "duration_ms": 4754,
      "text": "ইরাম গোত্রের প্রতি -- যারা অধিকারী ছিল সুউচ্চ প্রাসাদের?---।"
    },
    {
      "ayah": 8,
      "start_ms": 19251,
      "end_ms": 22499,
      "duration_ms": 3248,
      "text": "যার সমতুল্য কোনো দেশে সৃষ্টি করা হয়নি ;।"
    },
    {
      "ayah": 9,
      "start_ms": 22499,
      "end_ms": 27490,
      "duration_ms": 4991,
      "text": "এবং সামূদের প্রতি? যারা উপত্যকায় পাথর কেটে ঘর নির্মাণ করেছিল;।"
    },
    {
      "ayah": 10,
      "start_ms": 27490,
      "end_ms": 29867,
      "duration_ms": 2377,
      "text": "এবং কীলকওয়ালা ফিরআউনের প্রতি?"
    },
    {
      "ayah": 11,
      "start_ms": 29867,
      "end_ms": 31927,
      "duration_ms": 2060,
      "text": "যারা দেশে সীমালংঘন করেছিল,"
    },
    {
      "ayah": 12,
      "start_ms": 31927,
      "end_ms": 34700,
      "duration_ms": 2773,
      "text": "অতঃপর সেখানে অশান্তি বৃদ্ধি করেছিল।"
    },
    {
      "ayah": 13,
      "start_ms": 34700,
      "end_ms": 38265,
      "duration_ms": 3565,
      "text": "ফলে আপনার রব তাদের উপর শাস্তির কশাঘাত হানলেন।"
    },
    {
      "ayah": 14,
      "start_ms": 38265,
      "end_ms": 41117,
      "duration_ms": 2852,
      "text": "নিশ্চয় আপনার রব সতর্ক দৃষ্টি রাখেন।"
    },
    {
      "ayah": 15,
      "start_ms": 41117,
      "end_ms": 50229,
      "duration_ms": 9112,
      "text": "মানুষ তো এরূপ যে, তার রব যখন তাকে পরীক্ষা করেন সম্মান ও অনুগ্রহ দান করে, তখন সে বলে, আমার রব আমাকে সম্মানিত করেছেন।"
    },
    {
      "ayah": 16,
      "start_ms": 50229,
      "end_ms": 56964,
      "duration_ms": 6735,
      "text": "আর যখন তাকে পরীক্ষা করেন তার রিয্ক সংকুচিত করে, তখন সে বলে, আমার রব আমাকে হীন করেছেন।"
    },
    {
      "ayah": 17,
      "start_ms": 56964,
      "end_ms": 60371,
      "duration_ms": 3407,
      "text": "কখনো নয়। বরং তোমরা ইয়াতীমকে সম্মান কর না।"
    },
    {
      "ayah": 18,
      "start_ms": 60371,
      "end_ms": 64491,
      "duration_ms": 4120,
      "text": "এবং তোমরা মিসকীনকে খাদ্যদানে পরস্পরকে উৎসাহিত কর না,"
    },
    {
      "ayah": 19,
      "start_ms": 64491,
      "end_ms": 68611,
      "duration_ms": 4120,
      "text": "আর তোমরা উত্তরাধিকারের সম্পদ সম্পূর্ণরূপে খেয়ে ফেল,"
    },
    {
      "ayah": 20,
      "start_ms": 68611,
      "end_ms": 71146,
      "duration_ms": 2535,
      "text": "আর তোমরা ধন-সম্পদ খুবই ভালবাস ;।"
    },
    {
      "ayah": 21,
      "start_ms": 71146,
      "end_ms": 74553,
      "duration_ms": 3407,
      "text": "কখনো নয়। যখন যমীনকে চূর্ণ বিচূর্ণ করা হবে,"
    },
    {
      "ayah": 22,
      "start_ms": 74553,
      "end_ms": 78831,
      "duration_ms": 4278,
      "text": "আর যখন আপনার রব আগমন করবেন ও সারিবদ্ধভাবে ফেরেশ্তাগণও,"
    },
    {
      "ayah": 23,
      "start_ms": 78831,
      "end_ms": 85407,
      "duration_ms": 6576,
      "text": "আর সেদিন জাহান্নামকে আনা হবে, সেদিন মানুষ স্মরণ করবে, তখন এ স্মরণ তার কি কাজে আসবে?"
    },
    {
      "ayah": 24,
      "start_ms": 85407,
      "end_ms": 90319,
      "duration_ms": 4912,
      "text": "সে বলবে, হায়! আমার এ জীবনের জন্য আমি যদি কিছু অগ্রিম পাঠাতাম?"
    },
    {
      "ayah": 25,
      "start_ms": 90319,
      "end_ms": 94043,
      "duration_ms": 3724,
      "text": "সেদিন তাঁর শাস্তির মত শাস্তি কেউ দিতে পারবে না।"
    },
    {
      "ayah": 26,
      "start_ms": 94043,
      "end_ms": 97133,
      "duration_ms": 3090,
      "text": "এবং তাঁর বাঁধার মত বাঁধতে কেউ পারবে না।"
    },
    {
      "ayah": 27,
      "start_ms": 97133,
      "end_ms": 98559,
      "duration_ms": 1426,
      "text": "হে প্রশান্ত আত্মা!"
    },
    {
      "ayah": 28,
      "start_ms": 98559,
      "end_ms": 102996,
      "duration_ms": 4437,
      "text": "তুমি তোমার রবের কাছে ফিরে আস সন্তুষ্ট ও সন্তোষভাজন হয়ে,"
    },
    {
      "ayah": 29,
      "start_ms": 102996,
      "end_ms": 105848,
      "duration_ms": 2852,
      "text": "অতঃপর আমার বান্দাদের অন্তর্ভুক্ত হও,"
    },
    {
      "ayah": 30,
      "start_ms": 105848,
      "end_ms": 107987,
      "duration_ms": 2139,
      "text": "আর আমার জান্নাতে প্রবেশ কর।"
    }
  ]
}