{
  "surah": 1,
  "name_translit": "Al-Faatiha",
  "name_bn": "আল-ফাতিহা",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 24924,
  "total_ayat": 7,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 100,
      "end_ms": 2725,
      "duration_ms": 2625,
      "text": "রহমান, রহীম আল্লাহর নামে।"
    },
    {
      "ayah": 2,
      "start_ms": 2675,
      "end_ms": 6200,
      "duration_ms": 3525,
      "text": "সকল হামদ আল্লাহর, যিনি সৃষ্টিকুলের রব,"
    },
    {
      "ayah": 3,
      "start_ms": 6200,
      "end_ms": 8425,
      "duration_ms": 2225,
      "text": "দয়াময়, পরম দয়ালু,"
    },
    {
      "ayah": 4,
      "start_ms": 8425,
      "end_ms": 10462,
      "duration_ms": 2037,
      "text": "বিচার দিনের মালিক।"
    },
    {
      "ayah": 5,
      "start_ms": 10462,
      "end_ms": 15337,
      "duration_ms": 4875,
      "text": "আমরা শুধু আপনারই ইবাদাত করি, এবং শুধু আপনারই সাহায্য প্রার্থনা করি,"
    },
    {
      "ayah": 6,
      "start_ms": 15337,
      "end_ms": 18137,
      "duration_ms": 2800,
      "text": "আমাদেরকে সরল পথের হিদায়াত দিন।"
    },
    {
      "ayah": 7,
      "start_ms": 18137,
      "end_ms": 24924,
      "duration_ms": 6787,
      "text": "তাদের পথ, যাদেরকে আপনি নিয়ামত দিয়েছেন, যাদের উপর আপনার ক্রোধ আপতিত হয়নি এবং যারা পথভ্রষ্টও নয়।"
    }
  ]
}