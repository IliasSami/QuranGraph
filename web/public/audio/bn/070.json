{
  "surah": 70,
  "name_translit": "Al-Ma'aarij",
  "name_bn": "আল-মা'আরিজ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 167190,
  "total_ayat": 44,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 3441,
      "duration_ms": 3441,
      "text": "এক ব্যক্তি চাইল, সংঘটিত হোক শাস্তি যা অবধারিত।"
    },
    {
      "ayah": 2,
      "start_ms": 3441,
      "end_ms": 6658,
      "duration_ms": 3217,
      "text": "কাফিরদের জন্য, এটাকে প্রতিরোধ করার কেউ নেই।"
    },
    {
      "ayah": 3,
      "start_ms": 6658,
      "end_ms": 11595,
      "duration_ms": 4937,
      "text": "এটা আসবে আল্লাহর কাছ থেকে, যিনি উর্ধ্বারোহণের সোপানসমূহের অধিকারী।"
    },
    {
      "ayah": 4,
      "start_ms": 11595,
      "end_ms": 17954,
      "duration_ms": 6359,
      "text": "ফেরেশতা এবং রূহ আল্লাহর দিকে উর্ধ্বগামী হয় এমন এক দিনে, যার পরিমাণ পঞ্চাশ হাজার বছর।"
    },
    {
      "ayah": 5,
      "start_ms": 17954,
      "end_ms": 20722,
      "duration_ms": 2768,
      "text": "কাজেই আপনি ধৈর্য ধারণ করুন পরম ধৈর্য।"
    },
    {
      "ayah": 6,
      "start_ms": 20722,
      "end_ms": 22742,
      "duration_ms": 2020,
      "text": "তারা ঐ দিনকে মনে করে সুদূর,"
    },
    {
      "ayah": 7,
      "start_ms": 22742,
      "end_ms": 24762,
      "duration_ms": 2020,
      "text": "কিন্তু আমরা দেখছি তা আসন্ন।"
    },
    {
      "ayah": 8,
      "start_ms": 24762,
      "end_ms": 26931,
      "duration_ms": 2169,
      "text": "সেদিন আকাশ হবে গলিত ধাতুর মত।"
    },
    {
      "ayah": 9,
      "start_ms": 26931,
      "end_ms": 29474,
      "duration_ms": 2543,
      "text": "এবং পর্বতসমূহ হবে রঙ্গীন পশমের মত।"
    },
    {
      "ayah": 10,
      "start_ms": 29474,
      "end_ms": 31793,
      "duration_ms": 2319,
      "text": "এবং সুহৃদ সুহৃদের খোঁজ নেবে না,"
    },
    {
      "ayah": 11,
      "start_ms": 31793,
      "end_ms": 39050,
      "duration_ms": 7257,
      "text": "তাদেরকে করা হবে একে অপরের দৃষ্টিগোচর। অপরাধী সেদিনের শাস্তির বদলে দিতে চাইবে তার সন্তান সন্ততিকে,"
    },
    {
      "ayah": 12,
      "start_ms": 39050,
      "end_ms": 40695,
      "duration_ms": 1645,
      "text": "আর তার স্ত্রী ও ভাইকে,"
    },
    {
      "ayah": 13,
      "start_ms": 40695,
      "end_ms": 44061,
      "duration_ms": 3366,
      "text": "আর তার জ্ঞাতি গোষ্ঠীকে, যারা তাকে আশ্রয় দিত,"
    },
    {
      "ayah": 14,
      "start_ms": 44061,
      "end_ms": 48849,
      "duration_ms": 4788,
      "text": "আর যমীনে যারা আছে তাদের সবাইকে, তারপর যাতে এটি তাকে মুক্তি দেয়।"
    },
    {
      "ayah": 15,
      "start_ms": 48849,
      "end_ms": 51467,
      "duration_ms": 2618,
      "text": "কখনই নয়, নিশ্চয় এটা লেলিহান আগুন,"
    },
    {
      "ayah": 16,
      "start_ms": 51467,
      "end_ms": 53561,
      "duration_ms": 2094,
      "text": "যা মাথার চামড়া খসিয়ে দেবে।"
    },
    {
      "ayah": 17,
      "start_ms": 53561,
      "end_ms": 59995,
      "duration_ms": 6434,
      "text": "জাহান্নাম সে ব্যক্তিকে ডাকবে, যে সত্যের প্রতি পিঠ দেখিয়েছিল এবং মুখ ফিরিয়ে নিয়েছিল।"
    },
    {
      "ayah": 18,
      "start_ms": 59995,
      "end_ms": 64184,
      "duration_ms": 4189,
      "text": "আর যে সম্পদ পুঞ্জীভূত করেছিল অতঃপর সংরক্ষিত করে রেখেছিল।"
    },
    {
      "ayah": 19,
      "start_ms": 64184,
      "end_ms": 68448,
      "duration_ms": 4264,
      "text": "নিশ্চয় মানুষকে সৃষ্টি করা হয়েছে অতিশয় অস্থিরচিত্তরূপে।"
    },
    {
      "ayah": 20,
      "start_ms": 68448,
      "end_ms": 71814,
      "duration_ms": 3366,
      "text": "যখন বিপদ তাকে স্পর্শ করে সে হয় হা হুতাশকারী।"
    },
    {
      "ayah": 21,
      "start_ms": 71814,
      "end_ms": 75330,
      "duration_ms": 3516,
      "text": "আর যখন কল্যাণ তাকে স্পর্শ করে সে হয় অতি কৃপণ;।"
    },
    {
      "ayah": 22,
      "start_ms": 75330,
      "end_ms": 77424,
      "duration_ms": 2094,
      "text": "তবে সালাত আদায়কারীগণ ছাড়া,"
    },
    {
      "ayah": 23,
      "start_ms": 77424,
      "end_ms": 80117,
      "duration_ms": 2693,
      "text": "যারা তাদের সালাতে সর্বদা প্রতিষ্ঠিত,"
    },
    {
      "ayah": 24,
      "start_ms": 80117,
      "end_ms": 82810,
      "duration_ms": 2693,
      "text": "আর যাদের সম্পদে নির্ধারিত হক রয়েছে।"
    },
    {
      "ayah": 25,
      "start_ms": 82810,
      "end_ms": 84455,
      "duration_ms": 1645,
      "text": "যাচ্ঞাকারী ও বঞ্চিতের,"
    },
    {
      "ayah": 26,
      "start_ms": 84455,
      "end_ms": 87821,
      "duration_ms": 3366,
      "text": "আর যারা প্রতিদান দিবসকে সত্য বলে বিশ্বাস করে।"
    },
    {
      "ayah": 27,
      "start_ms": 87821,
      "end_ms": 91486,
      "duration_ms": 3665,
      "text": "আর যারা তাদের রবের শাস্তি সম্পর্কে ভীত সন্ত্রস্ত।"
    },
    {
      "ayah": 28,
      "start_ms": 91486,
      "end_ms": 95376,
      "duration_ms": 3890,
      "text": "নিশ্চয় তাদের রবের শাস্তি হতে নিঃশঙ্ক থাকা যায় না;।"
    },
    {
      "ayah": 29,
      "start_ms": 95376,
      "end_ms": 98443,
      "duration_ms": 3067,
      "text": "আর যারা নিজেদের যৌনাঙ্গসমূহের হিফাযতকারী,"
    },
    {
      "ayah": 30,
      "start_ms": 98443,
      "end_ms": 103455,
      "duration_ms": 5012,
      "text": "তাদের পত্নী অথবা অধিকারভুক্ত দাসী ছাড়া, এতে তারা নিন্দনীয় হবে না।"
    },
    {
      "ayah": 31,
      "start_ms": 103455,
      "end_ms": 108093,
      "duration_ms": 4638,
      "text": "তবে কেউ এদেরকে ছাড়া অন্যকে কামনা করলে তারা হবে সীমালঙ্ঘনকারী।"
    },
    {
      "ayah": 32,
      "start_ms": 108093,
      "end_ms": 111310,
      "duration_ms": 3217,
      "text": "আর যারা তাদের আমানতও প্রতিশ্রুতি রক্ষাকারী,"
    },
    {
      "ayah": 33,
      "start_ms": 111310,
      "end_ms": 113629,
      "duration_ms": 2319,
      "text": "আর যারা তাদের সাক্ষ্যসমূহে অটল,"
    },
    {
      "ayah": 34,
      "start_ms": 113629,
      "end_ms": 116097,
      "duration_ms": 2468,
      "text": "আর যারা তাদের সালাতের হিফাযত করে।"
    },
    {
      "ayah": 35,
      "start_ms": 116097,
      "end_ms": 118491,
      "duration_ms": 2394,
      "text": "তারাই সম্মানিত হবে জান্নাতসমূহে।"
    },
    {
      "ayah": 36,
      "start_ms": 118491,
      "end_ms": 121857,
      "duration_ms": 3366,
      "text": "কাফিরদের হল কি যে, তারা আপনার দিকে ছুটে আসছে,"
    },
    {
      "ayah": 37,
      "start_ms": 121857,
      "end_ms": 123951,
      "duration_ms": 2094,
      "text": "ডান ও বাম দিক থেকে, দলে দলে।"
    },
    {
      "ayah": 38,
      "start_ms": 123951,
      "end_ms": 130160,
      "duration_ms": 6209,
      "text": "তাদের প্রত্যেকে কি এ প্রত্যাশা করে যে, তাকে প্রবেশ করানো হবে প্রাচুর্যময় জান্নাতে?"
    },
    {
      "ayah": 39,
      "start_ms": 130160,
      "end_ms": 134424,
      "duration_ms": 4264,
      "text": "কখনো নয়, আমরা তাদেরকে যা থেকে সৃষ্টি করেছি তা তারা জানে।"
    },
    {
      "ayah": 40,
      "start_ms": 134424,
      "end_ms": 139735,
      "duration_ms": 5311,
      "text": "অতএব, আমি শপথ করছি উদয়াচলসমূহ এবং অস্তাচলসমূহের রবের অবশ্যই আমরা সক্ষম।"
    },
    {
      "ayah": 41,
      "start_ms": 139735,
      "end_ms": 144822,
      "duration_ms": 5087,
      "text": "তাদের চেয়ে উৎকৃষ্টদেরকে তাদের স্থলবর্তী করতে এবং এতে আমরা অক্ষম নই।"
    },
    {
      "ayah": 42,
      "start_ms": 144822,
      "end_ms": 153874,
      "duration_ms": 9052,
      "text": "অতএব তাদেরকে বাক বিতণ্ডা ও খেল তামাশায় মত্ত থাকতে দিন যে দিনের প্রতিশ্রুতি তাদেরকে দেয়া হয় তার সম্মুখীন হওয়ার আগ পর্যন্ত।"
    },
    {
      "ayah": 43,
      "start_ms": 153874,
      "end_ms": 160382,
      "duration_ms": 6508,
      "text": "সেদিন তারা কবর থেকে বের হবে দ্রুতবেগে, মনে হবে তারা কোনো লক্ষ্যস্থলের দিকে ধাবিত হচ্ছে।"
    },
    {
      "ayah": 44,
      "start_ms": 160382,
      "end_ms": 167190,
      "duration_ms": 6808,
      "text": "অবনত নেত্রে; হীনতা তাদেরকে আচ্ছন্ন করবে; এটাই সে দিন, যার বিষয়ে সতর্ক করা হয়েছিল তাদেরকে।"
    }
  ]
}