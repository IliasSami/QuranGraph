{
  "surah": 75,
  "name_translit": "Al-Qiyaama",
  "name_bn": "আল-কিয়ামাহ",
  "voice": "bn-BD-PradeepNeural",
  "total_duration_ms": 138257,
  "total_ayat": 40,
  "ayat": [
    {
      "ayah": 1,
      "start_ms": 0,
      "end_ms": 2288,
      "duration_ms": 2288,
      "text": "আমি শপথ করছি কিয়ামতের দিনের,"
    },
    {
      "ayah": 2,
      "start_ms": 2288,
      "end_ms": 5129,
      "duration_ms": 2841,
      "text": "আমি আরও শপথ করছি ভর্ৎসনাকারী আত্মার।"
    },
    {
      "ayah": 3,
      "start_ms": 5129,
      "end_ms": 10259,
      "duration_ms": 5130,
      "text": "মানুষ কি মনে করে যে, আমরা কখনোই তার অস্থিসমূহ একত্র করতে পারব না?"
    },
    {
      "ayah": 4,
      "start_ms": 10259,
      "end_ms": 15704,
      "duration_ms": 5445,
      "text": "অবশ্যই হ্যাঁ, আমরা তার আঙ্গুলের আগা পর্যন্ত পুনর্বিন্যস্ত করতে সক্ষম।"
    },
    {
      "ayah": 5,
      "start_ms": 15704,
      "end_ms": 19018,
      "duration_ms": 3314,
      "text": "বরং মানুষ তার ভবিষ্যতেও পাপাচার করতে চায়।"
    },
    {
      "ayah": 6,
      "start_ms": 19018,
      "end_ms": 22017,
      "duration_ms": 2999,
      "text": "সে প্রশ্ন করে, কখন কিয়ামতের দিন আসবে?"
    },
    {
      "ayah": 7,
      "start_ms": 22017,
      "end_ms": 23911,
      "duration_ms": 1894,
      "text": "যখন চোখ স্থির হয়ে যাবে,"
    },
    {
      "ayah": 8,
      "start_ms": 23911,
      "end_ms": 26120,
      "duration_ms": 2209,
      "text": "এবং চাঁদ হয়ে পড়বে কিরণহীন,"
    },
    {
      "ayah": 9,
      "start_ms": 26120,
      "end_ms": 28961,
      "duration_ms": 2841,
      "text": "আর যখন সূর্য ও চাঁদকে একত্র করা হবে।"
    },
    {
      "ayah": 10,
      "start_ms": 28961,
      "end_ms": 32275,
      "duration_ms": 3314,
      "text": "সেদিন মানুষ বলবে, আজ পালানোর স্থান কোথায়?"
    },
    {
      "ayah": 11,
      "start_ms": 32275,
      "end_ms": 34721,
      "duration_ms": 2446,
      "text": "কখনোই নয়, কোনো আশ্রয়স্থল নেই।"
    },
    {
      "ayah": 12,
      "start_ms": 34721,
      "end_ms": 37246,
      "duration_ms": 2525,
      "text": "সেদিন ঠাঁই হবে আপনার রবেরই কাছে।"
    },
    {
      "ayah": 13,
      "start_ms": 37246,
      "end_ms": 42691,
      "duration_ms": 5445,
      "text": "সেদিন মানুষকে অবহিত করা হবে সে কী আগে পাঠিয়েছে ও কী পিছনে রেখে গেছে।"
    },
    {
      "ayah": 14,
      "start_ms": 42691,
      "end_ms": 45532,
      "duration_ms": 2841,
      "text": "বরং মানুষ নিজের সম্পর্কে সম্যক অবগত,"
    },
    {
      "ayah": 15,
      "start_ms": 45532,
      "end_ms": 48215,
      "duration_ms": 2683,
      "text": "যদিও সে নানা অজুহাতের অবতারণা করে।"
    },
    {
      "ayah": 16,
      "start_ms": 48215,
      "end_ms": 54844,
      "duration_ms": 6629,
      "text": "তাড়াতাড়ি ওহী আয়ত্ত করার জন্য আপনি তা নিয়ে আপনার জিহ্বাকে দ্রুত সঞ্চালন করবেন না।"
    },
    {
      "ayah": 17,
      "start_ms": 54844,
      "end_ms": 58711,
      "duration_ms": 3867,
      "text": "নিশ্চয় এর সংরক্ষণ ও পাঠ করানোর দায়িত্ব আমাদেরই।"
    },
    {
      "ayah": 18,
      "start_ms": 58711,
      "end_ms": 62815,
      "duration_ms": 4104,
      "text": "কাজেই যখন আমরা তা পাঠ করি আপনি সে পাঠের অনুসরণ করুন,"
    },
    {
      "ayah": 19,
      "start_ms": 62815,
      "end_ms": 66524,
      "duration_ms": 3709,
      "text": "তারপর তার বর্ণনার দায়িত্ব নিশ্চিতভাবে আমাদেরই।"
    },
    {
      "ayah": 20,
      "start_ms": 66524,
      "end_ms": 69838,
      "duration_ms": 3314,
      "text": "কখনো না, বরং তোমরা দুনিয়ার জীবনকে ভালবাস।"
    },
    {
      "ayah": 21,
      "start_ms": 69838,
      "end_ms": 72126,
      "duration_ms": 2288,
      "text": "আর তোমরা আখেরাতকে উপেক্ষা কর।"
    },
    {
      "ayah": 22,
      "start_ms": 72126,
      "end_ms": 75046,
      "duration_ms": 2920,
      "text": "সেদিন কোনো কোনো মুখমণ্ডল উজ্জ্বল হবে,"
    },
    {
      "ayah": 23,
      "start_ms": 75046,
      "end_ms": 77808,
      "duration_ms": 2762,
      "text": "তারা তাদের রবের দিকে তাকিয়ে থাকবে।"
    },
    {
      "ayah": 24,
      "start_ms": 77808,
      "end_ms": 80965,
      "duration_ms": 3157,
      "text": "আর কোনো কোনো মুখমণ্ডল হয়ে পড়বে বিবর্ণ,"
    },
    {
      "ayah": 25,
      "start_ms": 80965,
      "end_ms": 85463,
      "duration_ms": 4498,
      "text": "আশংকা করবে যে, এক ধ্বংসকারী বিপর্যয় তাদের উপর আপতিত হবে।"
    },
    {
      "ayah": 26,
      "start_ms": 85463,
      "end_ms": 87830,
      "duration_ms": 2367,
      "text": "অবশ্যই, যখন প্রাণ কণ্ঠাগত হবে।"
    },
    {
      "ayah": 27,
      "start_ms": 87830,
      "end_ms": 90355,
      "duration_ms": 2525,
      "text": "এবং বলা হবে, কে তাকে রক্ষা করবে?"
    },
    {
      "ayah": 28,
      "start_ms": 90355,
      "end_ms": 93512,
      "duration_ms": 3157,
      "text": "তখন তার প্রত্যয় হবে যে, এটা বিদায়ক্ষণ।"
    },
    {
      "ayah": 29,
      "start_ms": 93512,
      "end_ms": 97221,
      "duration_ms": 3709,
      "text": "আর পায়ের গোছার সঙ্গে পায়ের গোছা জড়িয়ে যাবে।"
    },
    {
      "ayah": 30,
      "start_ms": 97221,
      "end_ms": 101009,
      "duration_ms": 3788,
      "text": "সেদিন আপনার রবের কাছেই সকলকে হাঁকিয়ে নেয়া হবে।"
    },
    {
      "ayah": 31,
      "start_ms": 101009,
      "end_ms": 104876,
      "duration_ms": 3867,
      "text": "সুতরাং সে বিশ্বাস করে নি এবং সালাতও আদায় করে নি।"
    },
    {
      "ayah": 32,
      "start_ms": 104876,
      "end_ms": 108743,
      "duration_ms": 3867,
      "text": "বরং সে মিথ্যারোপ করেছিল এবং মুখ ফিরিয়ে নিয়েছিল।"
    },
    {
      "ayah": 33,
      "start_ms": 108743,
      "end_ms": 113241,
      "duration_ms": 4498,
      "text": "তারপর সে তার পরিবার পরিজনের কাছে চলে গিয়েছিল অহংকার করে,"
    },
    {
      "ayah": 34,
      "start_ms": 113241,
      "end_ms": 115450,
      "duration_ms": 2209,
      "text": "দুর্ভোগ তোমার জন্য, দুর্ভোগ!"
    },
    {
      "ayah": 35,
      "start_ms": 115450,
      "end_ms": 118054,
      "duration_ms": 2604,
      "text": "আবার দুর্ভোগ তোমার জন্য, দুর্ভোগ!"
    },
    {
      "ayah": 36,
      "start_ms": 118054,
      "end_ms": 121763,
      "duration_ms": 3709,
      "text": "মানুষ কি মনে করে যে, তাকে এমনি ছেড়ে দেয়া হবে?"
    },
    {
      "ayah": 37,
      "start_ms": 121763,
      "end_ms": 124920,
      "duration_ms": 3157,
      "text": "সে কি বীর্যের স্থলিত শুক্রবিন্দু ছিল না?"
    },
    {
      "ayah": 38,
      "start_ms": 124920,
      "end_ms": 130681,
      "duration_ms": 5761,
      "text": "তারপর সে আলাকায় পরিণত হয়। অতঃপর আল্লাহ তাকে সৃষ্টি করেন এবং সুঠাম করেন।"
    },
    {
      "ayah": 39,
      "start_ms": 130681,
      "end_ms": 134311,
      "duration_ms": 3630,
      "text": "অতঃপর তিনি তা থেকে সৃষ্টি করেন যুগল নর ও নারী।"
    },
    {
      "ayah": 40,
      "start_ms": 134311,
      "end_ms": 138257,
      "duration_ms": 3946,
      "text": "তবুও কি সে স্রষ্টা মৃতকে পুনর্জীবিত করতে সক্ষম নন?"
    }
  ]
}